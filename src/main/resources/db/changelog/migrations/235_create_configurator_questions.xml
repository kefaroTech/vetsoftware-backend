<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modelo de suscripciones, fase 2 (suscripciones-tablas.md #7). Se crea SIN parent_option_id:
         hay un ciclo con configurator_options (options.question_id -> questions.id y
         questions.parent_option_id -> options.id) y MySQL exige que la tabla referenciada exista.
         La columna y su FK se añaden en el paso 237, después de crear configurator_options (paso 236).
         `sort_order` es [AÑADIDO]: el documento lo declara para las opciones y lo omite en las
         preguntas, descuido corregido aquí. -->
    <changeSet id="235_create_configurator_questions" author="orlando">
        <createTable tableName="configurator_questions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_configurator_questions_code"/>
            </column>
            <column name="question_text" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="help_text" type="VARCHAR(500)"/>
            <column name="answer_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE configurator_questions
                ADD CONSTRAINT chk_configurator_questions_answer_type
                    CHECK (answer_type IN ('SINGLE','MULTI','NUMBER','BOOLEAN')),
                ADD CONSTRAINT chk_configurator_questions_sort_order
                    CHECK (sort_order >= 0)
        ]]></sql>

        <createIndex tableName="configurator_questions" indexName="ix_configurator_questions_order">
            <column name="sort_order"/>
        </createIndex>

        <rollback>
            <dropTable tableName="configurator_questions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
