<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="099_create_general_charge_open_accounts" author="orlando">
        <createTable tableName="general_charge_open_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_general_charge_open_accounts_tax"
                             references="taxes(id)"/>
            </column>
            <column name="has_tax" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="open_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_general_charge_open_accounts_open_account"
                             references="open_accounts(id)"/>
            </column>
            <column name="created_by_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_general_charge_open_accounts_created_by"
                             references="employees(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
