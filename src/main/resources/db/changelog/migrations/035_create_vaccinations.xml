<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="035_create_vaccinations" author="orlando">
        <createTable tableName="vaccinations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="vaccination_type_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vaccinations_vaccination_type"
                             references="vaccination_types(id)"/>
            </column>
            <column name="lot" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(2000)"/>
            <column name="next_vaccination" type="DATE"/>
            <column name="animal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vaccinations_animal"
                             references="animals(id)"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vaccinations_company"
                             references="companies(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
