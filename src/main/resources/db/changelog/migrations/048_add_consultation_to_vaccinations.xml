<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="048_add_consultation_to_vaccinations" author="orlando">
        <addColumn tableName="vaccinations">
            <column name="consultation_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_vaccinations_consultation"
                             references="consultations(id)"/>
            </column>
        </addColumn>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, el dropColumn auto-generado no suelta la FK primero y
             revienta con "Cannot drop column ... needed in a foreign key constraint". -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="vaccinations" constraintName="fk_vaccinations_consultation"/>
            <dropColumn tableName="vaccinations" columnName="consultation_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
