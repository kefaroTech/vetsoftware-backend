<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Observación por medicamento (adicional a la posología): notas específicas de ese fármaco. -->
    <changeSet id="170_add_observation_to_medicament_prescriptions" author="orlando">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="medicament_prescriptions" columnName="observation"/>
            </not>
        </preConditions>
        <addColumn tableName="medicament_prescriptions">
            <column name="observation" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
