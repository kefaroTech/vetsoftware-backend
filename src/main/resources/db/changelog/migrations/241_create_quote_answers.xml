<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modelo de suscripciones, fase 3 (suscripciones-tablas.md #12). Por qué se cotizó eso. Sin
         company_id (frontera de tenant en quotes). Exenta de @Version (E1_APPEND_ONLY).
         Límite conocido de uq_quote_answers: MySQL permite múltiples NULL en un índice único, así que
         no impide dos respuestas a la misma pregunta numérica en la misma cotización (las dos con
         option_id nulo); daño cosmético, documentado y no emulado con columna generada. -->
    <changeSet id="241_create_quote_answers" author="orlando">
        <createTable tableName="quote_answers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quote_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_quote_answers_quote"
                             references="quotes(id)"/>
            </column>
            <column name="question_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_quote_answers_question"
                             references="configurator_questions(id)"/>
            </column>
            <column name="option_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_quote_answers_option"
                             references="configurator_options(id)"/>
            </column>
            <column name="question_code" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="answer_value" type="VARCHAR(255)"/>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="quote_answers"
                             columnNames="quote_id, question_id, option_id"
                             constraintName="uq_quote_answers"/>

        <sql><![CDATA[
            ALTER TABLE quote_answers
                ADD CONSTRAINT chk_quote_answers_payload
                    CHECK (option_id IS NOT NULL OR answer_value IS NOT NULL)
        ]]></sql>

        <rollback>
            <dropTable tableName="quote_answers"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
