<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="206_unique_open_cash_session_per_employee" author="orlando">
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                  FROM (
                    SELECT company_id, opened_by_employee_id
                      FROM cash_session
                     WHERE status = 'OPEN'
                       AND opened_by_employee_id IS NOT NULL
                     GROUP BY company_id, opened_by_employee_id
                    HAVING COUNT(*) &gt; 1
                  ) duplicate_open_sessions
            </sqlCheck>
        </preConditions>

        <!-- open_marker vale 1 para OPEN y NULL para CLOSED; MySQL permite múltiples NULL en un índice único. -->
        <addUniqueConstraint tableName="cash_session"
                             columnNames="company_id, opened_by_employee_id, open_marker"
                             constraintName="uq_cash_session_employee_open"/>

        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): uq_cash_session_employee_open (company_id, opened_by_employee_id,
             open_marker) es indice con company_id como prefijo izquierdo y puede sostener
             fk_cash_session_company (195, sin indice propio) -mismo defecto que
             154/203/197/150/027/144/185/134. La FK se suelta antes y se devuelve identica. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="cash_session"
                                      constraintName="fk_cash_session_company"/>
            <dropUniqueConstraint tableName="cash_session"
                                  constraintName="uq_cash_session_employee_open"/>
            <addForeignKeyConstraint baseTableName="cash_session" baseColumnNames="company_id"
                                     referencedTableName="companies" referencedColumnNames="id"
                                     constraintName="fk_cash_session_company"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
