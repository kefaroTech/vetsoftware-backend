<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Multi-sucursal (Fase B · Citas). Añade branch_id a appointments. Se backfillea a la sede "Principal"
         de cada empresa (sembrada en la migración 180) antes de exigir NOT NULL + FK. -->
    <changeSet id="181_add_branch_id_to_appointments" author="orlando">
        <addColumn tableName="appointments">
            <column name="branch_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="181_backfill_appointment_branch" author="orlando">
        <sql>
            UPDATE appointments a
            JOIN branches b ON b.company_id = a.company_id AND b.code = 'PRINCIPAL'
            SET a.branch_id = b.id
            WHERE a.branch_id IS NULL
        </sql>
        <rollback>
            UPDATE appointments SET branch_id = NULL
        </rollback>
    </changeSet>

    <changeSet id="181_appointment_branch_not_null_fk" author="orlando">
        <addNotNullConstraint tableName="appointments" columnName="branch_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="appointments" baseColumnNames="branch_id"
                                 constraintName="fk_appointments_branch"
                                 referencedTableName="branches" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
