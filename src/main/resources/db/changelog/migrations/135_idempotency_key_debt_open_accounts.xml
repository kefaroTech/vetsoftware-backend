<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Idempotencia de abonos (evita el doble cobro por reintento/doble-submit). El cliente envía un
         client_request_id (UUID) por intento de cobro; si el POST se reintenta con el mismo id, el service
         devuelve el abono ya creado en vez de registrar otro. El índice único respalda la carrera concurrente
         (check-then-act): la 2ª inserción con el mismo (open_account_id, client_request_id) la rechaza la BD.
         MySQL permite múltiples NULL → los abonos sin id (legacy/clientes que no lo envían) no se afectan. -->
    <changeSet id="135_idempotency_key_debt_open_accounts" author="orlando">
        <addColumn tableName="debt_open_accounts">
            <column name="client_request_id" type="VARCHAR(36)"/>
        </addColumn>
        <addUniqueConstraint tableName="debt_open_accounts"
                             columnNames="open_account_id, client_request_id"
                             constraintName="uq_debt_open_accounts_request"/>
    </changeSet>

</databaseChangeLog>
