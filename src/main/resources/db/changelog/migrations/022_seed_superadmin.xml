<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="022_seed_system_user_superadmin" author="orlando">
        <insert tableName="system_users">
            <column name="code" value="superadmin"/>
            <column name="hash_password" value="12345"/>
        </insert>
    </changeSet>

    <changeSet id="022_seed_system_permission_total_access" author="orlando">
        <insert tableName="system_permissions">
            <column name="name" value="TOTAL_ACCESS"/>
            <column name="code" value="admin.all"/>
        </insert>
    </changeSet>

    <changeSet id="022_seed_system_user_permission_superadmin" author="orlando">
        <sql>
            INSERT INTO system_user_permissions (system_user_id, system_permission_id)
            SELECT su.id, sp.id
            FROM system_users su, system_permissions sp
            WHERE su.code = 'superadmin' AND sp.code = 'admin.all';
        </sql>
    </changeSet>

</databaseChangeLog>
