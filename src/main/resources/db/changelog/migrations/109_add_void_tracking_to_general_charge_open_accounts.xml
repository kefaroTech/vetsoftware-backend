<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Anulación de cargos generales (como los abonos): el cargo queda visible tachado con
         auditoría (voided_by, voided_at, void_reason) y deja de contar en el total. -->
    <changeSet id="109_add_void_tracking_to_general_charge_open_accounts" author="orlando">
        <addColumn tableName="general_charge_open_accounts">
            <column name="voided" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_general_charge_open_accounts_voided_by"
                             references="employees(id)"/>
            </column>
            <column name="voided_at" type="DATETIME"/>
            <column name="void_reason" type="VARCHAR(255)"/>
        </addColumn>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, Liquibase auto-genera un dropColumn batched para las cuatro
             columnas que no suelta primero la FK, y revienta con "Cannot drop column
             'voided_by_id' ... needed in a foreign key constraint". Se declara a mano: la FK
             primero, despues las cuatro columnas. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="general_charge_open_accounts" constraintName="fk_general_charge_open_accounts_voided_by"/>
            <dropColumn tableName="general_charge_open_accounts" columnName="void_reason"/>
            <dropColumn tableName="general_charge_open_accounts" columnName="voided_at"/>
            <dropColumn tableName="general_charge_open_accounts" columnName="voided_by_id"/>
            <dropColumn tableName="general_charge_open_accounts" columnName="voided"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
