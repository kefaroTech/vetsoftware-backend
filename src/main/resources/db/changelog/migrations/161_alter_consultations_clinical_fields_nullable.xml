        </preConditions>
        <dropNotNullConstraint tableName="consultations"
                               columnName="therapeutic_plan"
                               columnDataType="VARCHAR(2000)"/>
    </changeSet>

    <changeSet id="161_drop_not_null_consultations_diagnosis_plan" author="orlando">
