<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="097_create_product_charge_open_accounts" author="orlando">
        <createTable tableName="product_charge_open_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="animal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_charge_open_accounts_animal"
                             references="animals(id)"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_charge_open_accounts_product"
                             references="products(id)"/>
            </column>
            <column name="open_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_charge_open_accounts_open_account"
                             references="open_accounts(id)"/>
            </column>
            <column name="created_by_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_charge_open_accounts_created_by"
                             references="employees(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
