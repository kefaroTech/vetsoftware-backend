<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
         hoy): dropUniqueConstraint no tiene inversa automatica, y ademas
         uq_permissions_company_code (company_id, code) es el unico indice con company_id
         como prefijo izquierdo y sostiene fk_permissions_company (016, sin indice propio) -
         mismo defecto que 154/203/197/150. La FK se suelta antes y se devuelve identica. -->
    <changeSet id="027_add_unique_permissions_company_code" author="orlando">
        <addUniqueConstraint tableName="permissions"
                             columnNames="company_id, code"
                             constraintName="uq_permissions_company_code"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="permissions"
                                      constraintName="fk_permissions_company"/>
            <dropUniqueConstraint tableName="permissions"
                                  constraintName="uq_permissions_company_code"/>
            <addForeignKeyConstraint baseTableName="permissions" baseColumnNames="company_id"
                                     referencedTableName="companies" referencedColumnNames="id"
                                     constraintName="fk_permissions_company"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
