<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="214_add_business_metrics_query_indexes" author="codex">
        <createIndex tableName="electronic_documents" indexName="ix_edoc_dian_status_created">
            <column name="dian_status"/>
            <column name="created_date"/>
        </createIndex>
        <createIndex tableName="stock_lot" indexName="ix_stock_lot_expiration_metrics">
            <column name="enabled"/>
            <column name="expire_date"/>
            <column name="quantity_available"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="stock_lot" indexName="ix_stock_lot_expiration_metrics"/>
            <dropIndex tableName="electronic_documents" indexName="ix_edoc_dian_status_created"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
