<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="088_add_suspension_to_hospitalization_medications" author="orlando">
        <addColumn tableName="hospitalization_medications">
            <column name="suspension_date" type="DATETIME"/>
            <column name="suspension_by_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_hosp_medications_suspension_by"
                             references="employees(id)"/>
            </column>
        </addColumn>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, el dropColumn batched auto-generado no suelta la FK primero. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="hospitalization_medications"
                                      constraintName="fk_hosp_medications_suspension_by"/>
            <dropColumn tableName="hospitalization_medications" columnName="suspension_by_id"/>
            <dropColumn tableName="hospitalization_medications" columnName="suspension_date"/>
        </rollback>
    </changeSet>

    <changeSet id="088_add_suspension_to_hospitalization_procedures" author="orlando">
        <addColumn tableName="hospitalization_procedures">
            <column name="suspension_date" type="DATETIME"/>
            <column name="suspension_by_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_hosp_procedures_suspension_by"
                             references="employees(id)"/>
            </column>
        </addColumn>
        <!-- AJUSTE (mismo motivo que arriba). -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="hospitalization_procedures"
                                      constraintName="fk_hosp_procedures_suspension_by"/>
            <dropColumn tableName="hospitalization_procedures" columnName="suspension_by_id"/>
            <dropColumn tableName="hospitalization_procedures" columnName="suspension_date"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
