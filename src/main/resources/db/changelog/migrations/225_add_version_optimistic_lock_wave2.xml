        <addColumn tableName="animals">
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="animals" columnName="version"/>
        </rollback>
    </changeSet>

