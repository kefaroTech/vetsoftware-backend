<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Correo opcional del "contacto libre" de una cita, para poder enviarle la confirmación por email.
         Nullable: la mayoría de citas son de clientes registrados (usan owner.email) o contactos sin correo. -->
    <changeSet id="192_add_client_email_to_appointments" author="orlando">
        <addColumn tableName="appointments">
            <column name="client_email" type="VARCHAR(150)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
