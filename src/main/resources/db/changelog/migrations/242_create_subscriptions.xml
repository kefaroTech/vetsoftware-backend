<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modelo de suscripciones, fase 4 (suscripciones-tablas.md #13). El contrato: sustituye al
         antiguo campo de plan de companies. active_marker es la barandilla "una empresa, un contrato
         vigente a la vez" -MySQL no tiene índices únicos parciales; se emula con GENERATED ALWAYS ... STORED
         que vale NULL fuera de alcance, mismo patrón que 195/206/210/226-. "Vigente" es
         TRIALING/ACTIVE/PAST_DUE/READ_ONLY con enabled=TRUE, no solo ACTIVE.
         uq_subscriptions_company_id (company_id, id) es la clave auxiliar que habilitan las FK
         compuestas de sus ocho tablas hijas (suscripciones-modelo.md §4.4).
         ix_subscriptions_next_billing / ix_subscriptions_past_due NO empiezan por company_id:
         son barridos de plataforma, no consultas de un tenant (declarado). -->
    <changeSet id="242_create_subscriptions" author="orlando">
        <createTable tableName="subscriptions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="subscription_number" type="VARCHAR(30)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_subscriptions_number"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_subscriptions_company"
                             references="companies(id)"/>
            </column>
            <column name="quote_id" type="BIGINT"><constraints nullable="true"/></column>
            <column name="price_list_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_subscriptions_price_list"
                             references="price_lists(id)"/>
            </column>
            <column name="billing_cycle" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="start_date" type="DATE"><constraints nullable="false"/></column>
            <column name="trial_end_date" type="DATE"/>
            <column name="current_period_start" type="DATE"><constraints nullable="false"/></column>
            <column name="current_period_end" type="DATE"><constraints nullable="false"/></column>
            <column name="next_billing_date" type="DATE"/>
            <column name="commitment_end_date" type="DATE"/>
            <column name="grace_days" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="past_due_since" type="DATE"/>
            <column name="auto_renew" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="cancel_requested_at" type="DATETIME(6)"/>
            <column name="cancel_effective_date" type="DATE"/>
            <column name="cancel_reason" type="VARCHAR(255)"/>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="subscriptions" columnNames="company_id, id"
                             constraintName="uq_subscriptions_company_id"/>

        <sql><![CDATA[
            ALTER TABLE subscriptions
                ADD COLUMN active_marker BIGINT
                    GENERATED ALWAYS AS (
                        CASE
                            WHEN enabled = TRUE
                             AND status IN ('TRIALING', 'ACTIVE', 'PAST_DUE', 'READ_ONLY')
                            THEN company_id
                            ELSE NULL
                        END
                    ) STORED,
                ADD CONSTRAINT uq_subscriptions_active_company UNIQUE (active_marker),
                ADD CONSTRAINT chk_subscriptions_status
                    CHECK (status IN ('TRIALING','ACTIVE','PAST_DUE','READ_ONLY','CANCELLED','EXPIRED')),
                ADD CONSTRAINT chk_subscriptions_cycle
                    CHECK (billing_cycle IN ('MONTHLY','ANNUAL')),
                ADD CONSTRAINT chk_subscriptions_period
                    CHECK (current_period_end >= current_period_start),
                ADD CONSTRAINT chk_subscriptions_grace_days
                    CHECK (grace_days >= 0),
                ADD CONSTRAINT chk_subscriptions_trial
                    CHECK (status <> 'TRIALING' OR trial_end_date IS NOT NULL),
                ADD CONSTRAINT chk_subscriptions_cancel
                    CHECK ((cancel_requested_at IS NULL AND cancel_effective_date IS NULL)
                           OR (cancel_requested_at IS NOT NULL AND cancel_effective_date IS NOT NULL)),
                ADD CONSTRAINT chk_subscriptions_commitment
                    CHECK (commitment_end_date IS NULL OR commitment_end_date >= start_date),
                ADD CONSTRAINT chk_subscriptions_past_due
                    CHECK (past_due_since IS NULL OR past_due_since >= start_date)
        ]]></sql>

        <createIndex tableName="subscriptions" indexName="ix_subscriptions_next_billing">
            <column name="next_billing_date"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="subscriptions" indexName="ix_subscriptions_past_due">
            <column name="status"/>
            <column name="past_due_since"/>
        </createIndex>
        <!-- Índice explícito para la FK compuesta a quotes; permite quote_id NULL
             para contratos creados sin cotización y arrastra la empresa cuando sí
             existe una cotización de origen. -->
        <createIndex tableName="subscriptions" indexName="ix_subscriptions_company_quote">
            <column name="company_id"/>
            <column name="quote_id"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="subscriptions"
                                 baseColumnNames="company_id, quote_id"
                                 referencedTableName="quotes"
                                 referencedColumnNames="company_id, id"
                                 constraintName="fk_subscriptions_quote"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <rollback>
            <dropTable tableName="subscriptions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
