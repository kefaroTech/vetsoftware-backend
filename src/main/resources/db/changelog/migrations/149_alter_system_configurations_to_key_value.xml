<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- system_configurations pasa de singleton-UVT a almacén clave-valor genérico: cada fila es una
         propiedad (property_name) con su value en texto. Así se controlan distintos ajustes del sistema
         (UVT, umbrales, flags) sin nuevas tablas. La fila UVT existente se migra a property_name='uvt'. -->
    <changeSet id="149_alter_system_configurations_to_key_value" author="orlando">
        <addColumn tableName="system_configurations">
            <column name="property_name" type="VARCHAR(100)"/>
            <column name="value" type="VARCHAR(255)"/>
        </addColumn>

        <!-- Migra la fila UVT existente al nuevo esquema clave-valor. -->
        <update tableName="system_configurations">
            <column name="property_name" value="uvt"/>
            <column name="value" valueComputed="CAST(uvt_value AS CHAR)"/>
            <where>property_name IS NULL</where>
        </update>

        <addNotNullConstraint tableName="system_configurations" columnName="property_name"
                              columnDataType="VARCHAR(100)"/>
        <addNotNullConstraint tableName="system_configurations" columnName="value"
                              columnDataType="VARCHAR(255)"/>

        <addUniqueConstraint tableName="system_configurations" columnNames="property_name"
                             constraintName="uq_system_configurations_property_name"/>

        <dropColumn tableName="system_configurations" columnName="uvt_value"/>
    </changeSet>

</databaseChangeLog>
