<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="078_rename_laboratory_test_status_to_english" author="orlando">
        <!-- Migra los valores del enum LaboratoryTestStatus de español a inglés.
             'PENDIENTE' es el default legacy de la migración 060 (estado de 2 valores). -->
        <update tableName="laboratory_tests">
            <column name="status" value="PENDING_COLLECTION"/>
            <where>status IN ('PENDIENTE', 'PENDIENTE_POR_RECOLECTAR')</where>
        </update>
        <update tableName="laboratory_tests">
            <column name="status" value="PENDING_PROCESSING"/>
            <where>status = 'PENDIENTE_POR_PROCESAR'</where>
        </update>
        <update tableName="laboratory_tests">
            <column name="status" value="IN_PROGRESS"/>
            <where>status = 'EN_PROCESO'</where>
        </update>
        <update tableName="laboratory_tests">
            <column name="status" value="PENDING_VALIDATION"/>
            <where>status = 'PENDIENTE_POR_LECTURA'</where>
        </update>
        <update tableName="laboratory_tests">
            <column name="status" value="COMPLETED"/>
            <where>status = 'COMPLETADO'</where>
        </update>
        <update tableName="laboratory_tests">
            <column name="status" value="CANCELLED"/>
            <where>status = 'CANCELADO'</where>
        </update>

        <!-- Reemplaza el default legacy 'PENDIENTE' por el inicial en inglés -->
        <addDefaultValue tableName="laboratory_tests" columnName="status"
                         defaultValue="PENDING_COLLECTION"/>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): los <update> bloquean la auto-inversion del changeset entero. Se revierte a
             mano: mapeo inverso de cada estado y el default legacy 'PENDIENTE' de 060. -->
        <rollback>
            <update tableName="laboratory_tests">
                <column name="status" value="PENDIENTE"/>
                <where>status = 'PENDING_COLLECTION'</where>
            </update>
            <update tableName="laboratory_tests">
                <column name="status" value="PENDIENTE_POR_PROCESAR"/>
                <where>status = 'PENDING_PROCESSING'</where>
            </update>
            <update tableName="laboratory_tests">
                <column name="status" value="EN_PROCESO"/>
                <where>status = 'IN_PROGRESS'</where>
            </update>
            <update tableName="laboratory_tests">
                <column name="status" value="PENDIENTE_POR_LECTURA"/>
                <where>status = 'PENDING_VALIDATION'</where>
            </update>
            <update tableName="laboratory_tests">
                <column name="status" value="COMPLETADO"/>
                <where>status = 'COMPLETED'</where>
            </update>
            <update tableName="laboratory_tests">
                <column name="status" value="CANCELADO"/>
                <where>status = 'CANCELLED'</where>
            </update>
            <addDefaultValue tableName="laboratory_tests" columnName="status"
                             defaultValue="PENDIENTE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
