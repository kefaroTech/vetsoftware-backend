<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="075_add_prioridad_to_laboratory_tests" author="orlando">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="laboratory_tests" columnName="prioridad"/>
            </not>
        </preConditions>
        <addColumn tableName="laboratory_tests">
            <column name="prioridad" type="VARCHAR(20)" defaultValue="NORMAL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
