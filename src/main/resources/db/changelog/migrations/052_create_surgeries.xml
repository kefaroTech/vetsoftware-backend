<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="052_create_surgeries" author="orlando">
        <createTable tableName="surgeries">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="surgery_type_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_surgeries_surgery_type"
                             references="surgery_types(id)"/>
            </column>
            <column name="description" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="medicament" type="VARCHAR(200)"/>
            <column name="observations" type="VARCHAR(2000)"/>
            <column name="complications" type="VARCHAR(2000)"/>
            <column name="animal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_surgeries_animal"
                             references="animals(id)"/>
            </column>
            <column name="consultation_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_surgeries_consultation"
                             references="consultations(id)"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_surgeries_company"
                             references="companies(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
