<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="083_create_hospitalization_procedures" author="orlando">
        <createTable tableName="hospitalization_procedures">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="dose" type="VARCHAR(200)"/>
            <column name="frequency" type="VARCHAR(40)"/>
            <column name="guideline_type" type="VARCHAR(40)"/>
            <column name="duration_measure" type="VARCHAR(40)"/>
            <column name="duration_quantity" type="INT"/>
            <column name="start_date" type="DATE"/>
            <column name="start_time" type="TIME"/>
            <column name="notes" type="VARCHAR(2000)"/>
            <column name="hospitalization_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hosp_procedures_hospitalization"
                             references="hospitalizations(id)"/>
            </column>
            <column name="created_by_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hosp_procedures_created_by"
                             references="employees(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="TINYINT(1)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
