<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007_create_membership_sub_modules" author="orlando">
        <createTable tableName="membership_sub_modules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="membership_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_membership_sub_modules_membership"
                             references="memberships(id)"/>
            </column>
            <column name="sub_module_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_membership_sub_modules_sub_module"
                             references="sub_modules(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="membership_sub_modules"
                             columnNames="membership_id, sub_module_id"
                             constraintName="uq_membership_sub_modules"/>
    </changeSet>

</databaseChangeLog>
