<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Token de un solo uso para verificar el correo del dueno tras el auto-registro. Se guarda el
         HASH del token (nunca el valor plano); el valor plano solo viaja en el email al usuario. -->
    <changeSet id="176_create_email_verification_tokens" author="orlando">
        <createTable tableName="email_verification_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_email_verification_tokens_hash"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_email_verification_tokens_employee"
                             references="employees(id)"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_email_verification_tokens_company"
                             references="companies(id)"/>
            </column>
            <column name="expires_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_at" type="DATETIME"/>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="email_verification_tokens" indexName="idx_email_verification_tokens_employee">
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
