<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006_create_base_role_permissions" author="orlando">
        <createTable tableName="base_role_permissions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="base_role_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_base_role_permissions_base_role"
                             references="base_roles(id)"/>
            </column>
            <column name="base_permission_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_base_role_permissions_base_permission"
                             references="base_permissions(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="base_role_permissions"
                             columnNames="base_role_id, base_permission_id"
                             constraintName="uq_base_role_permissions"/>
    </changeSet>

</databaseChangeLog>
