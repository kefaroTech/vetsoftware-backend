<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- CAPA DE REFERENCIA CON VIGENCIA (ficha public_holidays). LOS FESTIVOS COLOMBIANOS, SIN
         EMPRESA. El dato mas pequeno del bloque y el que sostiene toda regla de plazo en dias
         habiles. Exenta E1_APPEND_ONLY, sin version.

         holiday_date ES LA FECHA OBSERVADA -la que hay que consultar para saber si un dia es
         habil- y es la UNICA columna unica. nominal_date (la efemeride antes del traslado) NO
         PUEDE SER UNICA, y no es teoria: la Ley 51 de 1983 traslada al lunes siguiente diez
         festivos, y dos efemerides distintas pueden caer en el mismo lunes observado -el 1 de
         julio de 2019 lo fueron a la vez el Sagrado Corazon (Pascua+68) y San Pedro y San Pablo
         (29 de junio, sabado, trasladado)-. Una unicidad sobre nominal_date habria hecho ese ano
         inescribible.

         chk_public_holidays_move lleva las dos ramas: si no se traslado, nominal_date es nula o
         igual a la observada; si se traslado, es anterior y obligatoria. -->
    <changeSet id="350_create_public_holidays" author="orlando">
        <createTable tableName="public_holidays">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="holiday_date" type="DATE"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="nominal_date" type="DATE"/>
            <column name="moved" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="legal_reference" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME(6)"
                    defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE public_holidays
                ADD CONSTRAINT uq_public_holidays_date UNIQUE (holiday_date),
                ADD CONSTRAINT chk_public_holidays_move
                    CHECK ((moved = FALSE AND (nominal_date IS NULL
                                                OR nominal_date = holiday_date))
                           OR (moved = TRUE AND nominal_date IS NOT NULL
                                             AND nominal_date < holiday_date)),
                ADD CONSTRAINT chk_public_holidays_range
                    CHECK (holiday_date BETWEEN '2020-01-01' AND '2100-12-31')
        ]]></sql>

        <rollback>
            <dropTable tableName="public_holidays"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
