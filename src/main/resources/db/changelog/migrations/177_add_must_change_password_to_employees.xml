<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Onboarding de staff invitado por un admin: se crea con una contraseña temporal y debe cambiarla en
         el primer login. Empleados existentes = false (ya operan normalmente). También sirve de "estado de
         invitación": true = Invitado/Pendiente, false = Activo. -->
    <changeSet id="177_add_must_change_password_to_employees" author="orlando">
        <addColumn tableName="employees">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
