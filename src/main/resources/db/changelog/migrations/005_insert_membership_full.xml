<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005_insert_membership_full" author="orlando">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM memberships WHERE name = 'FULL' AND status = 'ACTIVE'
            </sqlCheck>
        </preConditions>
        <insert tableName="memberships">
            <column name="name" value="FULL"/>
            <column name="status" value="ACTIVE"/>
            <column name="created_date" valueComputed="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
