<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- FISCAL PROPIO (ficha supplier_withholdings). LO QUE TU LE RETIENES A OTROS, SIN EMPRESA.
         Gemela de document_withholdings (329) en la direccion contraria, escrita con el mismo
         vocabulario columna por columna.

         OJO CON INCOME_TAX: aqui es MENSUAL y en document_withholdings es ANUAL. No es un
         descuido: la retencion que TE PRACTICAN se imputa al ano gravable de tu renta ('2026-A',
         329), la que TU PRACTICAS se declara en la retencion en la fuente, que es mensual
         ('2026-M03'). Misma columna, mismo nombre, dos granularidades legitimas.

         supplier_invoice_ref OBLIGATORIA (decision propia, S8): sin la referencia del soporte no
         se cuadra contra el gasto ni se sostiene la deduccion, y sin ella la unicidad es falsa.

         uq_supplier_withholdings_case CORREGIDA CONTRA EL DOCUMENTO: sin supplier_invoice_ref
         dentro, la clave prohibe dos facturas distintas del mismo proveedor en el mismo mes, que
         es el caso normal. Con ella sigue impedido declarar dos veces la misma retencion al mismo
         proveedor por el mismo soporte. -->
    <changeSet id="352_create_supplier_withholdings" author="orlando">
        <createTable tableName="supplier_withholdings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="supplier_tax_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_doc_type" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_invoice_ref" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="withholding_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="concept" type="VARCHAR(60)"><constraints nullable="false"/></column>
            <column name="taxable_base" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="rate_percent" type="DECIMAL(9,6)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="municipality_code" type="VARCHAR(5)"/>
            <column name="fiscal_year" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="fiscal_period_key" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="practiced_on" type="DATE"><constraints nullable="false"/></column>
            <column name="certificate_issued_at" type="DATETIME(6)"/>
            <column name="certificate_ref" type="VARCHAR(100)"/>
            <column name="payment_receipt_ref" type="VARCHAR(255)"/>
            <column name="created_date" type="DATETIME(6)"
                    defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE supplier_withholdings
                MODIFY COLUMN supplier_tax_id VARCHAR(50)
                    CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
                MODIFY COLUMN supplier_invoice_ref VARCHAR(100)
                    CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
                MODIFY COLUMN municipality_code VARCHAR(5)
                    CHARACTER SET ascii COLLATE ascii_bin NULL,
                MODIFY COLUMN fiscal_period_key VARCHAR(10)
                    CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
                ADD COLUMN municipality_key VARCHAR(5)
                    CHARACTER SET ascii COLLATE ascii_bin
                    GENERATED ALWAYS AS (COALESCE(municipality_code, '-')) STORED,
                ADD CONSTRAINT uq_supplier_withholdings_case
                    UNIQUE (supplier_tax_id, fiscal_period_key, withholding_type,
                            municipality_key, supplier_invoice_ref),
                ADD CONSTRAINT chk_sw_doc_type
                    CHECK (supplier_doc_type IN ('NIT','CC','CE','PASSPORT','FOREIGN_ID')),
                ADD CONSTRAINT chk_sw_type
                    CHECK (withholding_type IN ('INCOME_TAX','VAT','ICA')),
                ADD CONSTRAINT chk_sw_amounts
                    CHECK (taxable_base > 0 AND amount > 0 AND amount <= taxable_base),
                ADD CONSTRAINT chk_sw_rate
                    CHECK (rate_percent > 0 AND rate_percent <= 100),
                ADD CONSTRAINT chk_sw_year
                    CHECK (fiscal_year BETWEEN 2020 AND 2100),
                ADD CONSTRAINT chk_sw_municipality
                    CHECK ((withholding_type =  'ICA' AND municipality_code IS NOT NULL)
                           OR (withholding_type <> 'ICA' AND municipality_code IS NULL)),
                ADD CONSTRAINT chk_sw_certificate
                    CHECK ((certificate_issued_at IS NULL AND certificate_ref IS NULL)
                           OR (certificate_issued_at IS NOT NULL AND certificate_ref IS NOT NULL)),
                ADD CONSTRAINT chk_sw_period
                    CHECK (LEFT(fiscal_period_key, 4) = CAST(fiscal_year AS CHAR)
                           AND ((withholding_type = 'INCOME_TAX'
                                 AND fiscal_period_key REGEXP '^[0-9]{4}-M(0[1-9]|1[0-2])$')
                             OR (withholding_type IN ('VAT','ICA')
                                 AND fiscal_period_key REGEXP '^[0-9]{4}-B0[1-6]$')))
        ]]></sql>

        <!-- Barrido de plataforma: armar la declaracion del mes. -->
        <createIndex tableName="supplier_withholdings" indexName="ix_sw_declaration">
            <column name="fiscal_period_key"/>
            <column name="withholding_type"/>
        </createIndex>
        <createIndex tableName="supplier_withholdings" indexName="ix_sw_certificate">
            <column name="supplier_tax_id"/>
            <column name="fiscal_year"/>
        </createIndex>
        <createIndex tableName="supplier_withholdings" indexName="ix_sw_municipality">
            <column name="municipality_code"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="supplier_withholdings"
                                 baseColumnNames="municipality_code"
                                 referencedTableName="cities"
                                 referencedColumnNames="dane_code"
                                 constraintName="fk_sw_municipality"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <rollback>
            <dropTable tableName="supplier_withholdings"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
