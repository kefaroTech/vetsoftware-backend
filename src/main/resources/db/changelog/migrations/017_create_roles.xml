<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="017_create_roles" author="orlando">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_roles_company"
                             references="companies(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="roles"
                             columnNames="company_id, code"
                             constraintName="uq_roles_company_code"/>
            <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado
             hasta hoy): sin <rollback> explicito, Liquibase auto-invierte
             dropUniqueConstraint antes que dropTable y revienta con "Cannot drop index ...
             needed in a foreign key constraint" cuando el unique sostiene una FK inline sin
             indice propio. dropTable se lleva la FK y el indice de un solo golpe. -->
        <rollback>
            <dropTable tableName="roles"/>
        </rollback>
</changeSet>

</databaseChangeLog>
