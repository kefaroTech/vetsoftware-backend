<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="031_create_animals" author="orlando">
        <createTable tableName="animals">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="specie_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_animals_specie"
                             references="species(id)"/>
            </column>
            <column name="breed_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_animals_breed"
                             references="breeds(id)"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_animals_owner"
                             references="owners(id)"/>
            </column>
            <column name="gender" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="weight_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="animal_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="reproductive_state" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="bod" type="DATE"/>
            <column name="weight" type="INT"/>
            <column name="size" type="INT"/>
            <column name="deceased" type="TINYINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="deceased_date" type="DATE"/>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_animals_company"
                             references="companies(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="animals"
                             columnNames="company_id, code"
                             constraintName="uq_animals_company_code"/>
            <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado
             hasta hoy): sin <rollback> explicito, Liquibase auto-invierte
             dropUniqueConstraint antes que dropTable y revienta con "Cannot drop index ...
             needed in a foreign key constraint" cuando el unique sostiene una FK inline sin
             indice propio. dropTable se lleva la FK y el indice de un solo golpe. -->
        <rollback>
            <dropTable tableName="animals"/>
        </rollback>
</changeSet>

</databaseChangeLog>
