<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012_insert_system_user_superadmin" author="orlando">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_users WHERE code = 'superadmin'
            </sqlCheck>
        </preConditions>
        <insert tableName="system_users">
            <column name="code" value="superadmin"/>
            <column name="hash_password" value="12345"/>
            <column name="created_date" valueComputed="NOW()"/>
        </insert>
    </changeSet>

    <changeSet id="012_insert_system_permission_total_access" author="orlando">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_permissions WHERE code = 'admin.all'
            </sqlCheck>
        </preConditions>
        <insert tableName="system_permissions">
            <column name="name" value="TOTAL_ACCESS"/>
            <column name="code" value="admin.all"/>
            <column name="created_date" valueComputed="NOW()"/>
        </insert>
    </changeSet>

    <changeSet id="012_insert_system_user_permission_superadmin" author="orlando">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_user_permissions sup
                JOIN system_users su ON su.id = sup.system_user_id
                JOIN system_permissions sp ON sp.id = sup.system_permission_id
                WHERE su.code = 'superadmin' AND sp.code = 'admin.all'
            </sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO system_user_permissions (system_user_id, system_permission_id, created_date)
            SELECT su.id, sp.id, NOW()
            FROM system_users su, system_permissions sp
            WHERE su.code = 'superadmin' AND sp.code = 'admin.all';
        </sql>
    </changeSet>

</databaseChangeLog>
