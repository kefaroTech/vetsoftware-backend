<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Unicidad de NOMBRE de categoría de servicio por empresa (entre ACTIVOS). Mismo patrón de la
         migración 151 (producto): columna generada que vale `name` solo si enabled=TRUE y NULL en otro
         caso; índice único sobre (company_id, active_name) deduplica solo categorías activas (MySQL
         permite múltiples NULL). Requiere que no existan nombres duplicados activos previos por empresa;
         limpiarlos antes si los hubiera. -->
    <changeSet id="153_unique_service_category_name_per_company" author="orlando">
        <sql>
            ALTER TABLE service_categories
                ADD COLUMN active_name VARCHAR(100)
                GENERATED ALWAYS AS (
                    CASE WHEN enabled = TRUE THEN name ELSE NULL END
                ) STORED,
                ADD CONSTRAINT uq_service_categories_company_active_name UNIQUE (company_id, active_name)
        </sql>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): mismo defecto que 203/197/193/154 -uq_service_categories_company_active_name (company_id, active_name) es
             indice con company_id como prefijo izquierdo y puede sostener fk_service_categories_company
             (service_categories, sin indice propio). La FK se suelta antes y se devuelve identica. -->
        <rollback>
            <sql>
                ALTER TABLE service_categories DROP FOREIGN KEY fk_service_categories_company;

                ALTER TABLE service_categories
                    DROP INDEX uq_service_categories_company_active_name,
                    DROP COLUMN active_name;

                ALTER TABLE service_categories
                    ADD CONSTRAINT fk_service_categories_company
                        FOREIGN KEY (company_id) REFERENCES companies (id);
            </sql>
        </rollback>
    </changeSet>

    <!-- Trazabilidad de auditoría: quién y cuándo modificó por última vez (nullable; nunca modificado = NULL).
         updated_by es el id del empleado (stamp de auditoría, sin FK). -->
    <changeSet id="153_add_audit_columns_to_service_categories" author="orlando">
        <addColumn tableName="service_categories">
            <column name="updated_date" type="DATETIME"/>
            <column name="updated_by" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="service_categories" columnName="updated_date"/>
            <dropColumn tableName="service_categories" columnName="updated_by"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
