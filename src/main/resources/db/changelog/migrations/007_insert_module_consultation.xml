<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007_insert_module_consultation" author="orlando">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM modules WHERE code = 'CONSULTATION'
            </sqlCheck>
        </preConditions>
        <insert tableName="modules">
            <column name="name" value="Consultation"/>
            <column name="code" value="CONSULTATION"/>
            <column name="created_date" valueComputed="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
