<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="076_create_laboratory_test_files" author="orlando">
        <createTable tableName="laboratory_test_files">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="bucket" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="original_file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="e_tag" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_by_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_laboratory_test_files_uploaded_by"
                             references="employees(id)"/>
            </column>
            <column name="laboratory_test_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_laboratory_test_files_laboratory_test"
                             references="laboratory_tests(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
