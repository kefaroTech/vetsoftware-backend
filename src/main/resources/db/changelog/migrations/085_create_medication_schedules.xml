<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="085_create_medication_schedules" author="orlando">
        <createTable tableName="medication_schedules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospitalization_medication_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_medication_schedules_medication"
                             references="hospitalization_medications(id)"/>
            </column>
            <column name="created_by_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_medication_schedules_created_by"
                             references="employees(id)"/>
            </column>
            <column name="original_date_time" type="DATETIME"/>
            <column name="current_date_time" type="DATETIME"/>
            <column name="real_date_time" type="DATETIME"/>
            <column name="applied_status" type="VARCHAR(40)"/>
            <column name="rescheduled" type="TINYINT(1)"/>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="TINYINT(1)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
