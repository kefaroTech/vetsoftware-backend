<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="049_add_consultation_to_hospitalizations" author="orlando">
        <addColumn tableName="hospitalizations">
            <column name="consultation_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_hospitalizations_consultation"
                             references="consultations(id)"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
