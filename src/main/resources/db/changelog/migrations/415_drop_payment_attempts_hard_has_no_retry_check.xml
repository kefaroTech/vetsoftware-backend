<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #771. chk_payment_attempts_hard_has_no_retry (321, YA APLICADO -no se toca-)
         exigia next_attempt_at vacio en todo rechazo HARD. Fijar una tarjeta nueva como
         predeterminada necesita poder reprogramar ese HARD a "ahora": la regla pasa a vivir
         solo en PaymentAttempt.reschedule. -->
    <changeSet id="415_drop_payment_attempts_hard_has_no_retry_check" author="orlando">
        <sql><![CDATA[
            ALTER TABLE payment_attempts
                DROP CONSTRAINT chk_payment_attempts_hard_has_no_retry
        ]]></sql>
        <rollback>
            <sql><![CDATA[
                ALTER TABLE payment_attempts
                    ADD CONSTRAINT chk_payment_attempts_hard_has_no_retry
                        CHECK (decline_kind <> 'HARD' OR next_attempt_at IS NULL)
            ]]></sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
