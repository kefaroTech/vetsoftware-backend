<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="217_add_token_retention_support" author="codex">
        <!-- El booleano revoked no permite medir la retención desde el evento de revocación. -->
        <addColumn tableName="refresh_tokens">
            <column name="revoked_at" type="DATETIME"/>
        </addColumn>

        <!-- No se conoce la fecha histórica exacta; el despliegue inicia la ventana de retención. -->
        <update tableName="refresh_tokens">
            <column name="revoked_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>revoked = true AND revoked_at IS NULL</where>
        </update>

        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_expires_at">
            <column name="expires_at"/>
        </createIndex>
        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_revoked_at">
            <column name="revoked_at"/>
        </createIndex>
        <createIndex tableName="email_verification_tokens" indexName="idx_email_verify_tokens_expires_at">
            <column name="expires_at"/>
        </createIndex>
        <createIndex tableName="email_verification_tokens" indexName="idx_email_verify_tokens_consumed_at">
            <column name="consumed_at"/>
        </createIndex>
        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_expires_at">
            <column name="expires_at"/>
        </createIndex>
        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_consumed_at">
            <column name="consumed_at"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_consumed_at"/>
            <dropIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_expires_at"/>
            <dropIndex tableName="email_verification_tokens" indexName="idx_email_verify_tokens_consumed_at"/>
            <dropIndex tableName="email_verification_tokens" indexName="idx_email_verify_tokens_expires_at"/>
            <dropIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_revoked_at"/>
            <dropIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_expires_at"/>
            <dropColumn tableName="refresh_tokens" columnName="revoked_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
