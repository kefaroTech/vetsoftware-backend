<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- BE-07: el changeset 021 sembró la contraseña del superadmin EN CLARO
         (hash_password = '12345'). Eso hacía que una credencial en texto plano viviera
         en la base y fuera válida para iniciar sesión hasta que el arranque siguiente la
         reescribiera: exactamente lo que existía para arreglar SeededPasswordRehasher,
         que ahora se elimina.

         El 021 no se toca —ya está aplicado y editarlo rompería su checksum—; se corrige
         aquí con un UPDATE.

         El valor es el hash BCrypt (cost 12) de la MISMA contraseña que ya tenía la fila.
         No se cambia quién puede entrar: solo se deja de guardarla en claro. Rotar esa
         credencial es una tarea aparte y urgente — es un SYSTEM_USER con admin.all cuya
         contraseña está en el historial de este repositorio. -->

    <changeSet id="220_hash_seeded_superadmin_password" author="orlando">
        <preConditions onFail="MARK_RAN">
            <!-- Solo actúa si la fila sigue en claro. Si alguien ya rotó la contraseña
                 (o el rehasher la convirtió al arrancar), no se pisa nada. -->
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM system_users
                WHERE code = 'superadmin' AND hash_password NOT LIKE '$2%'
            </sqlCheck>
        </preConditions>
        <update tableName="system_users">
            <column name="hash_password"
                    value="$2a$12$OMQG3kvT8J/2BP7c1m0MnuA3EYDKpKOpQmfSO1wDOArdfTtW1sSNC"/>
            <where>code = 'superadmin'</where>
        </update>
        <rollback>
            <!-- El valor anterior era texto plano; restaurarlo seria reintroducir el fallo. -->
            <empty/>
        </rollback>
    </changeSet>

</databaseChangeLog>
