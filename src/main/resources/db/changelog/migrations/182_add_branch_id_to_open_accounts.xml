<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Multi-sucursal (Fase B · Ventas). Añade branch_id a open_accounts, backfilleado a la sede
         "Principal" (sembrada en la migración 180) antes de exigir NOT NULL + FK. -->
    <changeSet id="182_add_branch_id_to_open_accounts" author="orlando">
        <addColumn tableName="open_accounts">
            <column name="branch_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="182_backfill_open_account_branch" author="orlando">
        <sql>
            UPDATE open_accounts a
            JOIN branches b ON b.company_id = a.company_id AND b.code = 'PRINCIPAL'
            SET a.branch_id = b.id
            WHERE a.branch_id IS NULL
        </sql>
        <rollback>
            UPDATE open_accounts SET branch_id = NULL
        </rollback>
    </changeSet>

    <changeSet id="182_open_account_branch_not_null_fk" author="orlando">
        <addNotNullConstraint tableName="open_accounts" columnName="branch_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="open_accounts" baseColumnNames="branch_id"
                                 constraintName="fk_open_accounts_branch"
                                 referencedTableName="branches" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
