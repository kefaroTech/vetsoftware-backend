<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Añade unique constraint (system_user_id, system_permission_id) a system_user_permissions
      para que el patrón "reactivate-on-create" pueda usarla como clave de lookup.

      Antes del ADD CONSTRAINT colapsa cualquier par duplicado preexistente:
      - Si alguna fila del par tiene enabled=true, conserva una activa (el MIN(id)) y
        deactiva el resto.
      - Si todas las filas del par son enabled=false, conserva el MIN(id) y borra
        físicamente las demás (no hay nada activo que preservar, y necesitamos quitar
        duplicados para la constraint).
    -->

    <changeSet id="070-collapse-duplicate-system-user-permissions" author="claude">
        <sql>
            UPDATE system_user_permissions sup
            JOIN (
                SELECT system_user_id, system_permission_id, MIN(id) AS keep_id
                FROM system_user_permissions
                WHERE enabled = TRUE
                GROUP BY system_user_id, system_permission_id
                HAVING COUNT(*) &gt; 1
            ) dups
              ON sup.system_user_id = dups.system_user_id
             AND sup.system_permission_id = dups.system_permission_id
            SET sup.enabled = FALSE
            WHERE sup.id &lt;&gt; dups.keep_id
              AND sup.enabled = TRUE;
        </sql>
        <sql>
            DELETE sup FROM system_user_permissions sup
            JOIN (
                SELECT system_user_id, system_permission_id, MIN(id) AS keep_id
                FROM system_user_permissions
                GROUP BY system_user_id, system_permission_id
                HAVING COUNT(*) &gt; 1
            ) dups
              ON sup.system_user_id = dups.system_user_id
             AND sup.system_permission_id = dups.system_permission_id
            WHERE sup.id &lt;&gt; dups.keep_id
              AND sup.enabled = FALSE
              AND NOT EXISTS (
                  SELECT 1 FROM (SELECT id FROM system_user_permissions WHERE enabled = TRUE) act
                  WHERE act.id = dups.keep_id
              );
        </sql>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, Liquibase no genera inversa para <sql>. Este changeset es
             GENUINAMENTE IRREVERSIBLE -desactiva y BORRA duplicados; no queda registro de cual
             fila exacta se elimino ni de que combinacion tenia mas de una activa antes-, y no
             hay forma de arreglarlo sin cambiar el <changeSet> ya aplicado (que rompe checksum).
             Rollback vacio: no bloquea nada estructural -no toca ninguna FK, indice ni
             columna-, solo deja sin deshacer una limpieza de datos que por definicion no se
             puede reconstruir. -->
        <rollback/>
    </changeSet>

    <changeSet id="070-add-unique-system-user-permissions" author="claude">
        <addUniqueConstraint
            tableName="system_user_permissions"
            columnNames="system_user_id, system_permission_id"
            constraintName="uq_system_user_permissions"/>
        <!-- AJUSTE (mismo motivo generico que arriba, mas especifico): uq_system_user_permissions
             (system_user_id, system_permission_id) es el unico indice con system_user_id como
             prefijo izquierdo y sostiene fk_system_user_permissions_user (010, sin indice
             propio) -mismo defecto que 154/203/197. La FK se suelta antes y se devuelve
             identica. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="system_user_permissions"
                                      constraintName="fk_system_user_permissions_user"/>
            <dropUniqueConstraint tableName="system_user_permissions"
                                  constraintName="uq_system_user_permissions"/>
            <addForeignKeyConstraint baseTableName="system_user_permissions" baseColumnNames="system_user_id"
                                     referencedTableName="system_users" referencedColumnNames="id"
                                     constraintName="fk_system_user_permissions_user"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
