<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modelo de suscripciones, fase 1 (suscripciones-tablas.md #5). La tarifa oficial con fecha.
         `name` es [AÑADIDO] respecto del documento de diseño (coste cero, ambigüedad cero). -->
    <changeSet id="233_create_price_lists" author="orlando">
        <createTable tableName="price_lists">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_price_lists_code"/>
            </column>
            <column name="name" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="currency" type="CHAR(3)" defaultValue="COP">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="DATE"><constraints nullable="false"/></column>
            <column name="valid_to" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="DATETIME"/>
            <column name="published_by_system_user_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_price_lists_published_by"
                             references="system_users(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE price_lists
                ADD CONSTRAINT chk_price_lists_status
                    CHECK (status IN ('DRAFT','PUBLISHED','ARCHIVED')),
                ADD CONSTRAINT chk_price_lists_validity
                    CHECK (valid_to IS NULL OR valid_to >= valid_from),
                ADD CONSTRAINT chk_price_lists_currency
                    CHECK (CHAR_LENGTH(currency) = 3 AND currency = UPPER(currency)),
                ADD CONSTRAINT chk_price_lists_published
                    CHECK ((status = 'DRAFT' AND published_at IS NULL AND published_by_system_user_id IS NULL)
                           OR (status <> 'DRAFT' AND published_at IS NOT NULL AND published_by_system_user_id IS NOT NULL))
        ]]></sql>

        <createIndex tableName="price_lists" indexName="ix_price_lists_status_valid">
            <column name="status"/>
            <column name="valid_from"/>
        </createIndex>

        <rollback>
            <dropTable tableName="price_lists"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
