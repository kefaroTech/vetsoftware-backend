<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="094_create_promotions" author="orlando">
        <createTable tableName="promotions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="promotion_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="application_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="application_item" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="value_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="promotion_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_promotions_company"
                             references="companies(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
