<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="016_alter_membership_modules_drop_module_id" author="orlando">
        <dropForeignKeyConstraint baseTableName="membership_modules"
                                  constraintName="fk_membership_modules_module"/>
        <dropColumn tableName="membership_modules" columnName="module_id"/>
    </changeSet>

    <changeSet id="016_drop_sub_module_if_exists" author="orlando">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="membership_modules" columnName="sub_module_id"/>
        </preConditions>
        <dropColumn tableName="membership_modules" columnName="sub_module_id"/>
    </changeSet>

    <changeSet id="016_alter_membership_modules_add_sub_module_id" author="orlando">
        <delete tableName="membership_modules"/>
        <addColumn tableName="membership_modules">
            <column name="sub_module_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_membership_modules_sub_module"
                             references="sub_modules(id)"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
