<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Idempotencia de la venta de POS (POST /electronic-documents/from-sale), mismo patrón que los cargos
         (139-141) y abonos (135). El cliente envía un client_request_id (UUID) por apertura del cobro; si el
         POST se reintenta con el mismo id (respuesta perdida en transporte), el service devuelve el documento
         ya creado en vez de registrar y transmitir OTRA venta a la DIAN. El índice único respalda la carrera
         concurrente (check-then-act): la 2ª inserción con el mismo (company_id, client_request_id) la rechaza
         la BD. La venta POS no tiene cuenta abierta (open_account_id NULL), así que el scope de la key es la
         empresa. MySQL permite múltiples NULL → los documentos sin id (from-account, notas, legacy) no se
         afectan. -->
    <changeSet id="150_idempotency_key_electronic_documents" author="orlando">
        <addColumn tableName="electronic_documents">
            <column name="client_request_id" type="VARCHAR(36)"/>
        </addColumn>
        <addUniqueConstraint tableName="electronic_documents"
                             columnNames="company_id, client_request_id"
                             constraintName="uq_electronic_documents_request"/>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, Liquibase auto-invierte dropUniqueConstraint antes que
             dropColumn y revienta con "Cannot drop index ... needed in a foreign key
             constraint" -uq_electronic_documents_request sostiene fk_electronic_documents_company-.
             Se declara a mano: suelta la FK, el unique y la columna, y devuelve la FK
             identica. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="electronic_documents"
                                      constraintName="fk_electronic_documents_company"/>
            <dropUniqueConstraint tableName="electronic_documents"
                                  constraintName="uq_electronic_documents_request"/>
            <dropColumn tableName="electronic_documents" columnName="client_request_id"/>
            <addForeignKeyConstraint baseTableName="electronic_documents" baseColumnNames="company_id"
                                     referencedTableName="companies" referencedColumnNames="id"
                                     constraintName="fk_electronic_documents_company"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
