    <!--
      Soft-delete uniforme: añade columna `enabled BOOLEAN NOT NULL DEFAULT TRUE`
      a las 41 tablas del schema. Hibernate `@SoftDelete` reescribe DELETE→UPDATE
      y añade WHERE enabled=true a todas las consultas automáticamente.
    -->

    <changeSet id="068-animals-enabled" author="claude">
        <addColumn tableName="animals">
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

