<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="101_add_close_tracking_and_version_to_open_accounts" author="orlando">
        <addColumn tableName="open_accounts">
            <column name="closed_by_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_open_accounts_closed_by"
                             references="employees(id)"/>
            </column>
            <column name="closed_at" type="DATETIME"/>
            <column name="close_reason" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, el dropColumn batched auto-generado no suelta la FK primero. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="open_accounts"
                                      constraintName="fk_open_accounts_closed_by"/>
            <dropColumn tableName="open_accounts" columnName="version"/>
            <dropColumn tableName="open_accounts" columnName="close_reason"/>
            <dropColumn tableName="open_accounts" columnName="closed_at"/>
            <dropColumn tableName="open_accounts" columnName="closed_by_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
