<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="056_add_company_to_test_types" author="orlando">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="test_types" columnName="company_id"/>
            </not>
        </preConditions>
        <addColumn tableName="test_types">
            <column name="company_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_test_types_company"
                             references="companies(id)"/>
            </column>
        </addColumn>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, el dropColumn auto-generado no suelta la FK primero. -->
        <rollback>
            <dropForeignKeyConstraint baseTableName="test_types" constraintName="fk_test_types_company"/>
            <dropColumn tableName="test_types" columnName="company_id"/>
        </rollback>
    </changeSet>

    <changeSet id="056_add_general_to_test_types" author="orlando">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="test_types" columnName="general"/>
            </not>
        </preConditions>
        <addColumn tableName="test_types">
            <column name="general" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="056_backfill_test_types_general" author="orlando">
        <comment>Pre-existing rows had no company nor general flag; mark them as global (general=TRUE) so they remain valid under the new XOR rule.</comment>
        <update tableName="test_types">
            <column name="general" valueBoolean="true"/>
            <where>general = FALSE AND company_id IS NULL</where>
        </update>
        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback>, Liquibase no genera inversa para <update>. Backfill de datos
             puro sin efecto de esquema: el dropColumn(general) auto-generado del propio
             changeset _add_general_to_test_types (que se revierte despues en la reversion
             completa) se lleva la columna con el dato incluido. -->
        <rollback/>
    </changeSet>

</databaseChangeLog>
