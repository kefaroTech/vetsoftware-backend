    <changeSet id="377_quote_mutations_backfill_companies" author="orlando">
        <!-- quote.accept/quote.reject NO terminan en ".read": solo FULL los concede
             (JpaRolePermissionInitializationPort.grants()). Backfillearlos tambien en
             READ_ONLY dejaria una empresa en solo lectura con permiso escrito para
             aceptar/rechazar su propia cotizacion. -->
        <sql>
            INSERT INTO permissions (name, code, company_id, sub_module_id, enabled)
            SELECT bp.name, bp.code, ce.company_id, sm.id, 1
            FROM company_entitlements ce
            JOIN sub_modules sm ON sm.id = ce.sub_module_id AND sm.code = 'QUOTE'
