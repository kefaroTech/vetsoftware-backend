    <changeSet id="377_selfservice_role_permissions_backfill_admin" author="orlando">
        <!-- Asigna los nueve permisos al rol ADMIN (code = 'ADMIN') de cada empresa
             backfillada por los siete changesets anteriores. Un solo changeset: mismo
             patron que 366_contact_channel_history_limit_role_permissions_backfill_admin,
             que tambien enlaza de una vez todos los codigos que backfillearon sus propios
             changesets hermanos. -->
        <sql>
            INSERT INTO role_permissions (role_id, permission_id, enabled)
            SELECT r.id, p.id, 1
            FROM roles r
            JOIN permissions p ON p.company_id = r.company_id
                AND p.code IN (
                    'entitlement.read', 'subscriptionPayment.read',
                    'billingDocumentApplication.read', 'dunningEvent.read',
                    'subscription.read', 'quote.read', 'quote.accept', 'quote.reject',
                    'subscriptionBilling.read')
            WHERE r.code = 'ADMIN'
              AND NOT EXISTS (
                  SELECT 1 FROM role_permissions rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id);
        </sql>
        <rollback>
            DELETE FROM role_permissions
            WHERE permission_id IN (
                SELECT id FROM permissions WHERE code IN (
                    'entitlement.read', 'subscriptionPayment.read',
                    'billingDocumentApplication.read', 'dunningEvent.read',
                    'subscription.read', 'quote.read', 'quote.accept', 'quote.reject',
                    'subscriptionBilling.read'));
        </rollback>
    </changeSet>

