<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026_add_mandatory_to_memberships" author="orlando">
        <addColumn tableName="memberships">
            <column name="mandatory" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="026_seed_basic_membership_mandatory" author="orlando">
        <update tableName="memberships">
            <column name="mandatory" valueBoolean="true"/>
            <where>name = 'BASIC'</where>
        </update>
    </changeSet>

</databaseChangeLog>
