<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Modelo de suscripciones, fase 6 (suscripciones-tablas.md #19). Consecutivo global de
         plataforma (sin company_id) de las cuentas de cobro/notas. Se usa con SELECT ... FOR UPDATE +
         UPDATE dentro de la MISMA transacción de negocio (no REQUIRES_NEW): precedente
         NumberingResolutionJpaEntity.lockActiveForUpdate. Exenta de @Version (E6_YA_PROTEGIDO), sin
         enabled (contador técnico: un consecutivo desactivado reinicia la serie desde cero). -->
    <changeSet id="248_create_billing_document_sequences" author="orlando">
        <createTable tableName="billing_document_sequences">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prefix" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_billing_document_sequences_prefix"/>
            </column>
            <column name="next_value" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE billing_document_sequences
                ADD CONSTRAINT chk_billing_document_sequences_next_value CHECK (next_value >= 1)
        ]]></sql>

        <rollback>
            <dropTable tableName="billing_document_sequences"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
