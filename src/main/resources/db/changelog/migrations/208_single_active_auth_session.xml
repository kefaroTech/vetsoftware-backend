<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="208_single_active_auth_session" author="codex">
        <addColumn tableName="system_users">
            <column name="auth_version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="refresh_tokens">
            <column name="auth_version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Los refresh anteriores no estaban ligados a una versión de sesión. -->
        <update tableName="refresh_tokens">
            <column name="revoked" valueBoolean="true"/>
            <where>revoked = false</where>
        </update>

        <!-- AJUSTE (primer rollback end-to-end de la cadena completa, nunca ejecutado hasta
             hoy): sin <rollback> explicito, Liquibase intenta auto-invertir el <update> y no
             puede -"No inverse to UpdateDataChange created"-, porque revocar una marca masiva
             no es reversible: no hay registro de que token estaba en revoked=false por este
             motivo y cual ya lo estaba por otro. Se declara el rollback a mano: revierte las
             dos columnas que SI se pueden deshacer sin ambiguedad y deja la revocacion como
             dato, mismo criterio que 218 con sus backfills -una marca de seguridad ya aplicada
             no se deshace sola, y dejarla no compromete el esquema-. -->
        <rollback>
            <dropColumn tableName="refresh_tokens" columnName="auth_version"/>
            <dropColumn tableName="system_users" columnName="auth_version"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
