<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="046_create_medicament_prescriptions" author="orlando">
        <createTable tableName="medicament_prescriptions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="presentation" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="posology" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="prescription_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_medicament_prescriptions_prescription"
                             references="prescriptions(id)"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
