<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="vetsoftware"/>

    <!-- Consola legible para humanos en dev (no JSON crudo) -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-no-trace}] %magenta(%X{actor.type:-}) %cyan(%logger{30}) : %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Consola JSON estructurado en el resto de perfiles (prod, etc.) -->
    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <timeZone>UTC</timeZone>
                <customFields>{"service":"${appName}"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <!-- Archivo: JSON para Grafana Alloy → Loki, con rotación por fecha y tamaño + tope total -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/vetsoftware.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/vetsoftware.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <!-- Reducir ruido de frameworks -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="ERROR"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="liquibase" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Logs propios de la app en INFO -->
    <logger name="com.vetsoftware" level="INFO"/>

    <!-- Auditoría: archivo dedicado con retención larga (cumplimiento), bajo volumen.

         TAMPER-RESISTANCE (OWASP ASVS V7.3): logs/audit.log es local y editable, así que por sí solo
         no es prueba de manipulación. Para cumplimiento clínico real el audit trail debe salir del host
         hacia un destino append-only/WORM o un SIEM. Dos vías, según la infra disponible:

           1. Reenvío off-host (recomendado): descomentar el appender SYSLOG_AUDIT de abajo, definir
              `audit.syslog.host` (propiedad/env del colector del SIEM) y añadir su <appender-ref> al
              logger AUDIT. El SIEM guarda los eventos fuera del alcance del host (inmutables).
           2. OS-level: dejar logs/audit.log como append-only (`chattr +a`) y rotarlo hacia un volumen
              WORM.

         Hoy los eventos ya llegan a Loki por el stream principal (additivity) — bueno para consulta,
         no para inmutabilidad. El paso 1 queda pendiente solo del host del SIEM (decisión de infra). -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>365</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <!-- Reenvío off-host del audit trail a un SIEM (tamper-resistance). Listo para habilitar:
         descomentar y definir `audit.syslog.host`; luego añadir <appender-ref ref="SYSLOG_AUDIT"/>
         al logger AUDIT de abajo.
    <springProperty scope="context" name="auditSyslogHost" source="audit.syslog.host"/>
    <appender name="SYSLOG_AUDIT" class="ch.qos.logback.classic.net.SyslogAppender">
        <syslogHost>${auditSyslogHost}</syslogHost>
        <port>514</port>
        <facility>AUTH</facility>
        <suffixPattern>[%thread] %logger %msg</suffixPattern>
    </appender>
    -->

    <!-- Flujo de auditoría (OWASP ASVS V7): además del stream normal (Loki/consola por additivity),
         va al archivo dedicado AUDIT_FILE de retención larga. Filtrable por logger_name="AUDIT".
         Para tamper-resistance off-host, añadir aquí <appender-ref ref="SYSLOG_AUDIT"/>. -->
    <logger name="AUDIT" level="INFO" additivity="true">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
