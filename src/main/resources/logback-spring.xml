<configuration>
    <!-- Desarrollo conserva una consola legible. No se crea ningún archivo local. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-no-trace}] %magenta(%X{actor.type:-}) %cyan(%logger{30}) : %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Consola de dev y prod: JSON de una línea por evento. En ECS lo que va a stdout es lo que
      llega a CloudWatch, que pasa a ser la fuente durable de logs; en texto plano esa ruta solo
      llevaba el mensaje y el traceId, mientras que por OTLP viajaba el MDC completo. Con este
      encoder las dos rutas transportan lo mismo.

      El formato es una clase propia (no 'ecs' ni 'logstash') porque necesitamos el nombre exacto
      trace_id/span_id: es lo que casa con el derived field del datasource de Loki que enlaza a
      Tempo. Ver StructuredConsoleLogFormatter.
    -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>com.vetsoftware.app.infrastructure.logging.StructuredConsoleLogFormatter</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Producción envía los eventos directamente al SDK de logs de OpenTelemetry. -->
    <appender name="OTEL"
              class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
        <numLogsCapturedBeforeOtelInstall>1000</numLogsCapturedBeforeOtelInstall>
    </appender>

    <!--
      Política automática de redacción (OBS-019). Ningún appender se referencia directamente desde
      <root>: todos van envueltos, de modo que mensaje, MDC, pares clave-valor y mensajes de
      excepción pasan por LogRedactor antes de salir del proceso. Añadir un destino nuevo obliga a
      envolverlo — si no se envuelve, no recibe eventos.

      Los appenders envueltos se declaran arriba y como hijos directos de <configuration>; el gating
      por perfil se hace abajo, en <root>. Ver docs/POLITICA_REDACCION_LOGS.md.
    -->
    <appender name="REDACTED_CONSOLE"
              class="com.vetsoftware.app.infrastructure.logging.RedactingAppender">
        <appender-ref ref="CONSOLE"/>
    </appender>
    <appender name="REDACTED_JSON_CONSOLE"
              class="com.vetsoftware.app.infrastructure.logging.RedactingAppender">
        <appender-ref ref="JSON_CONSOLE"/>
    </appender>
    <appender name="REDACTED_OTEL"
              class="com.vetsoftware.app.infrastructure.logging.RedactingAppender">
        <appender-ref ref="OTEL"/>
    </appender>

    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="ERROR"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="liquibase" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="com.vetsoftware" level="INFO"/>
    <logger name="AUDIT" level="INFO"/>

    <!--
      NO TOQUES ESTE APPENDER PENSANDO QUE ES REDUNDANTE. En prod y dev, stdout es LA ruta de
      entrega de los logs, no un respaldo del pipeline OTLP: el runtime es ECS, lo que se escribe
      en stdout va a CloudWatch y de ahi Firehose lo lleva a Grafana Cloud. Quitar
      REDACTED_JSON_CONSOLE deja al servicio sin logs en ningun sitio.

      Por eso va en JSON y no en texto: CloudWatch es la fuente durable y necesita los atributos
      estructurados, no solo el mensaje. En local se mantiene el patron legible (JSON en una
      terminal de desarrollo es ilegible), que es justo lo que separa este <springProfile> del
      de abajo. Sigue envuelta en RedactingAppender, de modo que la politica de redaccion no se
      debilita.

      REDACTED_OTEL sigue cableado pero inerte en dev/prod: management.logging.export.enabled esta
      en false (ver application-prod.yml) porque las dos rutas duplicaban cada evento en Loki. Se
      deja conectado para que reactivarlo sea una variable de entorno y no un cambio de este
      fichero. Trazas y metricas no pasan por aqui y siguen exportandose por OTLP.
    -->
    <springProfile name="prod | dev">
        <root level="INFO">
            <appender-ref ref="REDACTED_JSON_CONSOLE"/>
            <appender-ref ref="REDACTED_OTEL"/>
        </root>
    </springProfile>

    <springProfile name="!prod &amp; !dev">
        <root level="INFO">
            <appender-ref ref="REDACTED_CONSOLE"/>
            <appender-ref ref="REDACTED_OTEL"/>
        </root>

        <!--
          Previsualización de correos cuando el envío está deshabilitado (solo en local): imprime el
          enlace o los códigos que el correo habría llevado. Es el único canal sin redacción y por eso
          está acotado por construcción: additivity="false" + solo CONSOLE, así que no puede alcanzar
          el pipeline exportado a Loki. Fuera de local este logger no se declara y sus eventos caen en
          la raíz redactada. Ver DevEmailPreview.
        -->
        <logger name="DEV_EMAIL_PREVIEW" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>
</configuration>
