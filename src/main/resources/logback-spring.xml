<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="vetsoftware"/>

    <!-- Consola legible para humanos en dev (no JSON crudo) -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-no-trace}] %magenta(%X{actor.type:-}) %cyan(%logger{30}) : %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Consola JSON estructurado en el resto de perfiles (prod, etc.) -->
    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <!-- Archivo: JSON para Promtail → Loki, con rotación por fecha Y tamaño + tope total -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/vetsoftware.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/vetsoftware.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <!-- Reducir ruido de frameworks -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="ERROR"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="liquibase" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Logs propios de la app en INFO -->
    <logger name="com.vetsoftware" level="INFO"/>

    <!-- Auditoría: archivo dedicado con retención larga (cumplimiento), bajo volumen.
         TAMPER-RESISTANCE: este archivo es local y editable. Para cumplimiento clínico real, el
         audit trail debe enviarse off-host a un destino append-only/WORM o SIEM. Hoy los eventos
         ya llegan a Loki vía el stream principal (additivity); para inmutabilidad, añadir un
         appender de envío directo (p.ej. SyslogAppender/GELF a un SIEM) o hacer logs/audit.log
         append-only a nivel SO (chattr +a) y rotarlo hacia almacenamiento WORM. -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>365</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <!-- Flujo de auditoría (OWASP ASVS V7): además del stream normal (Loki/consola por additivity),
         va al archivo dedicado AUDIT_FILE de retención larga. Filtrable por logger_name="AUDIT". -->
    <logger name="AUDIT" level="INFO" additivity="true">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
