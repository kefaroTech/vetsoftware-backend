<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.vetsoftware</groupId>
    <artifactId>vetsoftware</artifactId>
    <version>1.7.0-dev.2</version>
    <name>VetSoftware</name>

    <properties>
        <java.version>25</java.version>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>vetsoftware</sonar.projectKey>
        <sonar.projectName>VetSoftware</sonar.projectName>
        <sonar.java.source>25</sonar.java.source>
        <argLine></argLine>
        <!-- Mismo motivo que argLine: la reescribe jacoco:prepare-agent-integration, y
             declararla vacia evita que @{failsafeArgLine} quede literal si jacoco no corre. -->
        <failsafeArgLine></failsafeArgLine>
        <aws.sdk.version>2.49.3</aws.sdk.version>
        <datasource-micrometer.version>2.2.1</datasource-micrometer.version>
        <opentelemetry.instrumentation.version>2.28.1-alpha</opentelemetry.instrumentation.version>
        <bucket4j.version>8.19.0</bucket4j.version>
        <jjwt.version>0.13.0</jjwt.version>
        <openhtmltopdf.version>1.1.65</openhtmltopdf.version>
        <zxing.version>3.5.4</zxing.version>
        <spotless-maven-plugin.version>3.6.0</spotless-maven-plugin.version>
        <eclipse-jdt-formatter.version>4.39</eclipse-jdt-formatter.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>13.9.0</checkstyle.version>
        <archunit.version>1.4.1</archunit.version>
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
        <!-- Suelo de cobertura global: solo puede SUBIR. Medido 98,83 % el 2026-08-17 tras
             la campana BE-COV; se fija un par de decimas por debajo para dejar margen a
             refactors que muevan el denominador. Ver "Cobertura" en CLAUDE.md.

             Estuvo un rato en 0.90 como objetivo declarado, con el build rojo a
             proposito, y se devolvio al valor medido: un umbral que nadie puede poner en
             verde no protege nada y acaba desactivandose. Ahora 0.98 SI es alcanzable,
             porque es lo que mide la suite de verdad.

             Historico de lo MEDIDO: 12,73 % (2026-08-08), 14,24 % (modulo animal),
             25,64 % (2026-08-09, +17 features), 33,44 % (2026-08-12, campana de
             cobertura + rodajas de persistencia), 53,15 % (2026-08-16, BE-10),
             98,83 % (2026-08-17, BE-COV: 10.771 unitarias + 1.130 de integracion). -->
        <jacoco.line.minimum>0.98</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.ttddyy.observation</groupId>
                <artifactId>datasource-micrometer-bom</artifactId>
                <version>${datasource-micrometer.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>

        <!-- Persistencia -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- AWS -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- Envío de correo (representación gráfica factura electrónica F4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Generación de códigos QR (CUFE/CUDE + URL DIAN en el PDF) -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- Rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-redis-common</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- Rate limiting distribuido sobre Redis (buckets compartidos entre réplicas + TTL) -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- Spring Security: method security (@PreAuthorize) + BCrypt -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- API documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Observabilidad: métricas + tracing -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry.instrumentation.version}</version>
        </dependency>

        <!-- JDBC tracing con convenciones semánticas estables de OpenTelemetry -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-opentelemetry</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit: las reglas de CLAUDE.md como test que rompe el build.
             Se declaran api + engine en lugar del agregador archunit-junit5
             porque es lo mismo que él agrupa, sin el pom intermedio. -->
        <!-- @DataJpaTest contra MySQL real. H2 no sirve aqui: el schema depende de
             comportamientos concretos de MySQL (TINYINT pelado, AUTO_INCREMENT con
             IDENTITY, SELECT ... FOR UPDATE), y un motor distinto daria verde sobre algo
             que no es lo que se despliega. Versiones gestionadas por el BOM de Boot. -->
        <!-- Boot 4 partio las rodajas de test por modulo: @DataJpaTest ya no viene en
             spring-boot-starter-test, hay que pedir su starter. Lo mismo @WebMvcTest. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-api</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-engine</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Comillas obligatorias: sin ellas surefire parte el argumento en
                         los espacios de la ruta del .m2 y el fork muere con
                         "Error opening zip file or JAR manifest missing".

                         @{argLine} es sustitucion TARDIA: resuelve la propiedad argLine en
                         el momento de ejecutar, que es cuando jacoco:prepare-agent ya la ha
                         reescrito con su -javaagent. Por eso conviven los dos agentes y por
                         eso la propiedad argLine se declara vacia arriba: sin declararla,
                         @{argLine} quedaria literal cuando jacoco no corre.

                         -Xmx explicito porque sin el la JVM del fork se queda con el default de
                         ~25% de la RAM del runner (unos 2 GB de 7,9 GB) y eso no da para la suite:
                         el volcado a disco esta para que un OOM futuro deje evidencia y no un stack
                         sin contexto. maxSize baja de 32 a 8 porque retener contextos solo compensa
                         si se reutilizan, y aqui las rodajas @WebMvcTest comparten WebMvcSliceConfig:
                         con 8 la cache sigue acertando y se deja de pagar memoria por el resto. -->
                    <argLine>@{argLine} -Xmx4g -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath="${project.build.directory}/heapdump.hprof" -Dspring.test.context.cache.maxSize=8 -javaagent:"${org.mockito:mockito-core:jar}"</argLine>
                    <environmentVariables>
                        <!-- EncryptedStringConverter lo instancia Hibernate, no Spring, asi
                             que lee la clave del ENTORNO de forma estatica y sin default: sin
                             esto no arranca ningun contexto con JPA. Clave de juguete, valida
                             solo para que el converter se inicialice en tests; jamas se usa
                             fuera de aqui y no descifra nada real. -->
                        <DIAN_ENC_KEY>cvPOiufeDsByvGdw71gg8XxS880Xf7S6lH9WvdfiwQY=</DIAN_ENC_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Las rodajas @DataJpaTest levantan un MySQL real con Testcontainers:
                         se llaman *IT y corren en `mvn verify`, no en `mvn test`. Asi el
                         ciclo local rapido no exige Docker, pero nada se mergea sin que las
                         migraciones y las consultas se hayan probado contra el motor de
                         verdad. Sin este plugin las clases *IT no las ejecutaba NADIE:
                         surefire solo recoge *Test/*Tests.

                         @{failsafeArgLine} lo escribe jacoco:prepare-agent-integration, de
                         modo que la cobertura de estas pruebas tambien cuenta (ver el merge
                         de los dos .exec mas abajo). El agente de Mockito va igual que en
                         surefire, con la ruta entrecomillada por los espacios del .m2.

                         -Xmx explicito por lo mismo que en surefire, pero aqui ya medido: el fork
                         moria con OutOfMemoryError tras 314 s y solo 203 de las ~1.130 pruebas.
                         maxSize baja a 2 porque en integracion la cache de contextos NO acierta
                         nunca: cada *IT declara su propio @Import y ningun contexto se reutiliza, asi
                         que los 32 por defecto -cada uno arrastrando los metadatos Hibernate de las
                         104 *JpaEntity- son memoria retenida a cambio de cero reutilizacion. -->
                    <argLine>@{failsafeArgLine} -Xmx4g -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath="${project.build.directory}/heapdump.hprof" -Dspring.test.context.cache.maxSize=2 -javaagent:"${org.mockito:mockito-core:jar}"</argLine>
                    <environmentVariables>
                        <!-- Mismo motivo que en surefire: EncryptedStringConverter lo
                             instancia Hibernate y lee la clave del entorno sin default. -->
                        <DIAN_ENC_KEY>cvPOiufeDsByvGdw71gg8XxS880Xf7S6lH9WvdfiwQY=</DIAN_ENC_KEY>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <!-- Sin logica propia: solo estructura o arranque. Medirlos infla
                             la cobertura sin decir nada sobre el riesgo real.

                             El criterio para admitir un glob nuevo, que es el que dejo
                             fuera a los candidatos evidentes (excepciones, enums,
                             *Properties, los *Ref del dominio): se leen TODAS las clases
                             que el glob captura, y si una sola tiene una rama, un throw,
                             una factoria o una traduccion, el glob se rechaza. Medido: las
                             exclusiones "obvias" que se descartaron por eso BAJABAN la
                             cifra, porque retiraban mas linea cubierta que sin cubrir. -->
                        <!-- Arranque. Ojo a la S de Software: hasta 2026-08-17 este glob
                             decia VetsoftwareApplication y no casaba con la clase real
                             (com.vetsoftware.app.VetSoftwareApplication), asi que la
                             exclusion declarada no se aplicaba. -->
                        <exclude>**/VetSoftwareApplication.class</exclude>
                        <exclude>**/*JpaEntity.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/*Request.class</exclude>
                        <!-- La forma del JSON de salida. El paquete entero, no solo el
                             sufijo *Response: dentro solo viven *Response y los 136
                             *Summary companion (comprobado: ni un fichero mas, ni un
                             throw, ni un return, ni una factoria, cero ramas). El glob
                             por paquete ademas alcanza a los records anidados
                             (AccountsPayableAgingResponse$Bucket), que **/*Response.class
                             dejaba midiendo.

                             Y tiene que ir anclado al paquete: **/*Summary*.class se
                             tragaria los 134 *SummaryDto de application/dto, que SI son
                             logica de proyeccion (el from(...) decide que campos salen). -->
                        <exclude>**/*Response.class</exclude>
                        <exclude>**/infrastructure/web/response/*.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- Segundo agente, para las rodajas *IT de failsafe. Escribe en
                             target/jacoco-it.exec y expone su -javaagent en la propiedad
                             failsafeArgLine, que el argLine de failsafe resuelve tarde. -->
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Informe de `mvn test`: solo pruebas unitarias, porque en esa
                             fase las *IT todavia no han corrido. -->
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- Une lo que midio surefire con lo que midio failsafe. Si las *IT
                             se saltan (-DskipITs) el segundo .exec no existe y el merge se
                             queda con el primero, asi que el suelo sigue siendo medible. -->
                        <id>merge-unit-and-integration</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-all.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Reemplaza el informe del `test` con el de las dos fuentes. Va
                             declarado ANTES de check-floor: dentro de la misma fase, Maven
                             respeta el orden de declaracion. -->
                        <id>report-all</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-all.exec</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Trinquete: el suelo global no puede bajar. Se sube a mano al
                             valor medido cuando un PR lo supera; nunca se baja. -->
                        <id>check-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-all.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <eclipse>
                            <version>${eclipse-jdt-formatter.version}</version>
                            <file>${project.basedir}/config/spotless/eclipse-formatter.properties</file>
                        </eclipse>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <excludeGeneratedSources>true</excludeGeneratedSources>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <maxAllowedViolations>0</maxAllowedViolations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.7.0.6970</version>
            </plugin>
        </plugins>
    </build>
</project>
