// Canalización de logs de VetSoftware:
// archivos JSON por instancia de Logback -> Grafana Alloy -> Loki.
//
// El bind mount /logs apunta a VETSOFTWARE_LOG_DIR, la misma ruta absoluta
// que usa el backend. Los offsets se conservan en el volumen de datos de Alloy.
// Solo se indexan dimensiones de cardinalidad acotada. logger_name, traceId y
// spanId permanecen en el JSON y se consultan en Loki con:
//   {job="vetsoftware"} | json | traceId="<id>"

livedebugging {
  enabled = true
}

loki.source.file "vetsoftware" {
  targets = [
    {
      __path__     = "/logs/vetsoftware-*.log",
      job          = "vetsoftware",
      env          = sys.env("DEPLOYMENT_ENVIRONMENT"),
      service_name = sys.env("SERVICE_NAME"),
    },
  ]

  forward_to    = [loki.process.vetsoftware.receiver]
  tail_from_end = false
  encoding      = "utf-8"

  file_match {
    enabled           = true
    sync_period       = "2s"
    ignore_older_than = "168h"
  }
}

loki.process "vetsoftware" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
