@startuml hospitalization_procedure_suspend
title PATCH /hospitalization-procedures/{id}/suspend — Suspend Procedure Order

actor Client
participant "HospitalizationProcedureController" as Controller
participant "Authz" as Authz
participant "SuspendHospitalizationProcedureUseCase\n<<port.in>>" as UseCase
participant "SuspendHospitalizationProcedureService" as Service
participant "HospitalizationProcedureRepository\n<<port.out>>" as Repo
participant "EmployeeQueryPort\n<<port.out>>" as EmpQP
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PATCH /hospitalization-procedures/{id}/suspend
activate Controller
Controller -> Authz : currentEmployeeId()
Authz --> Controller : employeeId
Controller -> UseCase : execute(SuspendHospitalizationProcedureCommand{id, suspendedById})
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalization.update OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(command)
activate Service
Service -> Repo : findById(id)
Repo --> Service : Optional<HospitalizationProcedure>
alt no encontrado
  Service --> GEH : HospitalizationProcedureNotFoundException
  GEH --> Client : 404 Not Found
end
Service -> EmpQP : findById(suspendedById)
EmpQP --> Service : Optional<EmployeeRef>
Service -> Service : procedure.suspend(by, now())\n// set suspensionDate + suspensionBy
Service -> Repo : save(procedure)
Repo -> DB : UPDATE hospitalization_procedures\nSET suspension_date, suspension_by_id
Service --> UseCase : HospitalizationProcedureDto
UseCase --> Controller : dto
Controller --> Client : 200 OK\nHospitalizationProcedureResponse (suspensionDate/By)
deactivate Service
deactivate Controller

note over Client, DB
  La orden NO se elimina (enabled sigue true): queda marcada como suspendida.
  El front, acto seguido, llama
  PATCH /procedure-schedules/by-procedure/{id}/suspend-pending
  para retirar las ejecuciones pendientes (ver suspend-pending.puml).
end note

@enduml
