@startuml medication_schedule_apply
title PATCH /medication-schedules/{id}/apply — Apply Medication Dose

actor Client
participant "MedicationScheduleController" as Controller
participant "ApplyMedicationScheduleUseCase\n<<port.in>>" as UseCase
participant "ApplyMedicationScheduleService" as Service
participant "MedicationScheduleRepository\n<<port.out>>" as Repo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PATCH /medication-schedules/{id}/apply
activate Controller
Controller -> UseCase : execute(ApplyMedicationScheduleCommand{id})
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalization.update OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(id)
Repo --> Service : Optional<MedicationSchedule>
alt no encontrada
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end

Service -> Service : target.apply(now)  // appliedStatus=APPLIED, realDateTime=now
Service -> Repo : save(target)
Repo -> DB : UPDATE medication_schedules

note over Service, DB
  Aplicar NO recalcula las siguientes (ni FIJO ni INTERVALO).
  El recálculo de pauta INTERVALO ocurre solo al reprogramar
  (reschedule con mode=cascade).
end note

Service -> Repo : findByHospitalizationMedicationId(medId)
Repo --> Service : List<MedicationSchedule>
Service -> Service : MedicationScheduleDto.from(...)
Service --> UseCase : List<MedicationScheduleDto>
UseCase --> Controller : List<MedicationScheduleDto>
Controller --> Client : 200 OK\nList<MedicationScheduleResponse> (plan completo de la medicación)
deactivate Service
deactivate Controller

@enduml
