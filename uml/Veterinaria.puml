@startuml

' =========================
' Enums
' =========================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum Gender {
  MALE
  FEMALE
}

enum WeightType {
  GRAMS
  POUNDS
  KILOGRAMS
}

enum AnimalType {
  SERVICE
  SUPPORT
  NONE
}

enum ReproductiveState {
  STERILIZED
  NO_STERILIZED
  UNKNOWN
}

enum HospitalizationType {
  OUTPATIENT
  HOSPITALIZATION
}

enum DayCareType {
  DAYCARE
  HOTEL
}

enum ReasonLeaving {
  MEDICAL_DISCHARGE
  HOME_TREATMENT
  TRANSFER
  TUTOR_WISH
  ADMIN
  DEATH
  EUTHANASIA
}

enum DewormingType {
  INTERNAL
  EXTERNAL
  MIX
  OTHER
}

enum LaboratoryTestStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum SurgeryStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum DiagnosticImagingStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

' =========================
' System / Auth
' =========================

class SystemUser {
  -code: String
  -hashPassword: String
  -createdDate: LocalDateTime
}

class SystemPermission {
  -name: String
  -code: String
  -createdDate: LocalDateTime
}

class SystemUserPermission {
  -systemUser: SystemUser
  -systemPermission: SystemPermission
  -createdDate: LocalDateTime
}

' =========================
' Membership / Modules
' =========================

class Membership {
  -name: String
  -status: MembershipStatus
  -mandatory: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Module {
  -name: String
  -code: String
  -createdDate: LocalDateTime
}

class SubModule {
  -name: String
  -code: String
  -module: Module
  -createdDate: LocalDateTime
}

class MembershipSubModule {
  -membership: Membership
  -subModule: SubModule
  -createdDate: LocalDateTime
}

class BasePermission {
  -name: String
  -code: String
  -subModule: SubModule
  -createdDate: LocalDateTime
}

' =========================
' Company / Employee
' =========================

class Company {
  -name: String
  -identifier: String
  -address: String
  -contactNumber: String
  -city: City
  -membership: Membership
  -createdDate: LocalDateTime
}

class Employee {
  -employeeCode: String
  -hashPassword: String
  -name: String
  -email: String
  -status: EmployeeStatus
  -company: Company
  -createdDate: LocalDateTime
}

' =========================
' Authorization
' =========================

class BaseRole {
  -name: String
  -code: String
  -mandatory: Boolean
  -createdDate: LocalDateTime
}

class Role {
  -name: String
  -code: String
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Permission {
  -name: String
  -code: String
  -company: Company
  -subModule: SubModule
  -createdDate: LocalDateTime
}

class RolePermission {
  -role: Role
  -permission: Permission
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class BaseRolePermission {
  -baseRole: BaseRole
  -basePermission: BasePermission
  -createdDate: LocalDateTime
}

class EmployeeRole {
  -employee: Employee
  -role: Role
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Location
' =========================

class Country {
  -name: String
  -createdDate: LocalDateTime
}

class State {
  -name: String
  -country: Country
  -createdDate: LocalDateTime
}

class City {
  -name: String
  -state: State
  -createdDate: LocalDateTime
}

' =========================
' Owner / Animal
' =========================

class Owner {
  -name: String
  -email: String
  -document: String
  -address: String
  -phone: String
  -city: City
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Specie {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class AnimalColor {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Breed {
  -name: String
  -specie: Specie
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Animal {
  -name: String
  -code: String
  -bod: LocalDate
  -weight: Integer
  -size: Integer
  -gender: Gender
  -weightType: WeightType
  -animalType: AnimalType
  -reproductiveState: ReproductiveState
  -deceased: Boolean
  -deceasedDate: LocalDate
  -specie: Specie
  -breed: Breed
  -color: AnimalColor
  -owner: Owner
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Medical Records
' =========================

class ConsultationType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Consultation {
  -date: LocalDate
  -type: ConsultationType
  -anamnesis: String
  -diagnosis: String
  -therapeuticPlan: String
  -diagnosisPlan: String
  -nextControl: LocalDate
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class VaccinationType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Vaccination {
  -date: LocalDate
  -type: VaccinationType
  -lot: String
  -notes: String
  -nextVaccination: LocalDate
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class SurgeryType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Surgery {
  -date: LocalDate
  -surgeryType: SurgeryType
  -description: String
  -medicament: String
  -observations: String
  -complications: String
  -status: SurgeryStatus
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Hospitalization {
  -date: LocalDate
  -startDate: LocalDate
  -endDate: LocalDate
  -type: HospitalizationType
  -reasonLeaving: ReasonLeaving
  -reason: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class DayCare {
  -date: LocalDate
  -startDate: LocalDate
  -endDate: LocalDate
  -type: DayCareType
  -objects: String
  -observations: String
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class LaboratoryTestType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class LaboratoryTest {
  -date: LocalDate
  -type: LaboratoryTestType
  -quantity: Integer
  -diagnosis: String
  -status: LaboratoryTestStatus
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Prescription {
  -date: LocalDate
  -diagnosis: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class MedicamentPrescription {
  -name: String
  -presentation: String
  -quantity: Double
  -posology: String
  -prescription: Prescription
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Deworming {
  -date: LocalDate
  -lastDeworming: LocalDate
  -nextControl: LocalDate
  -type: DewormingType
  -product: String
  -dosage: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class DiagnosticImagingType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class DiagnosticImaging {
  -date: LocalDate
  -type: DiagnosticImagingType
  -clinicalSigns: String
  -studyType: String
  -diagnosis: String
  -observations: String
  -status: DiagnosticImagingStatus
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class SpaType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Spa {
  -date: LocalDate
  -type: SpaType
  -reason: String
  -details: String
  -observations: String
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Relationships
' =========================

' --- System / Auth ---
SystemUserPermission --> SystemUser
SystemUserPermission --> SystemPermission

' --- Membership / Modules ---
Membership          --> MembershipStatus
MembershipSubModule --> Membership
MembershipSubModule --> SubModule
SubModule           --> Module
BasePermission      --> SubModule

' --- Company / Employee ---
Company  --> Membership
Company  --> City
Employee --> Company
Employee --> EmployeeStatus

' --- Authorization ---
Role               --> Company
Permission         --> Company
Permission         --> SubModule
RolePermission     --> Role
RolePermission     --> Permission
BaseRolePermission --> BaseRole
BaseRolePermission --> BasePermission
EmployeeRole       --> Employee
EmployeeRole       --> Role

' --- Location ---
City  --> State
State --> Country

' --- Owner / Animal ---
Owner  "0..*" --> "1" City
Owner         --> Company
Breed         --> Specie
Animal        --> Specie
Animal        --> Breed
Animal        --> AnimalColor
Animal        --> Owner
Animal        --> Company
Animal        --> Gender
Animal        --> WeightType
Animal        --> AnimalType
Animal        --> ReproductiveState

' --- Medical Records ---
Consultation          --> ConsultationType
Consultation          --> Animal
Consultation          --> Company

VaccinationType       "0..*" --> "0..1" Company
Vaccination           --> VaccinationType
Vaccination           --> Animal
Vaccination           --> Company
Vaccination           "0..*" --> "0..1" Consultation

SurgeryType           "0..*" --> "0..1" Company
Surgery               --> SurgeryType
Surgery               --> Animal
Surgery               --> Company
Surgery               --> SurgeryStatus
Surgery               "0..*" --> "0..1" Consultation

Hospitalization       --> HospitalizationType
Hospitalization       --> ReasonLeaving
Hospitalization       --> Animal
Hospitalization       --> Company
Hospitalization       "0..*" --> "0..1" Consultation

DayCare       --> DayCareType
DayCare       --> Animal
DayCare       --> Company

LaboratoryTestType              "0..*" --> "0..1" Company
LaboratoryTest        --> LaboratoryTestType
LaboratoryTest        --> Animal
LaboratoryTest        --> Company
LaboratoryTest        --> LaboratoryTestStatus
LaboratoryTest        "0..*" --> "0..1" Consultation

Prescription          --> Animal
Prescription          --> Company
Prescription          --> Consultation
MedicamentPrescription --> Prescription

Deworming             --> DewormingType
Deworming             --> Animal
Deworming             --> Company
Deworming             "0..*" --> "0..1" Consultation

DiagnosticImagingType "0..*" --> "0..1" Company
DiagnosticImaging     --> DiagnosticImagingType
DiagnosticImaging     --> Animal
DiagnosticImaging     --> Company
DiagnosticImaging     --> DiagnosticImagingStatus
DiagnosticImaging     "0..*" --> "0..1" Consultation

Spa                   --> SpaType
Spa                   --> Animal
Spa                   --> Company

@enduml
