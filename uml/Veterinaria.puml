@startuml

' =========================
' Enums
' =========================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum OpenAccountStatus {
  OPEN
  CLOSE
  CANCEL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum Gender {
  MALE
  FEMALE
}

enum WeightType {
  GRAMS
  POUNDS
  KILOGRAMS
}

enum AnimalType {
  SERVICE
  SUPPORT
  NONE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum ReproductiveState {
  STERILIZED
  NO_STERILIZED
  UNKNOWN
}

enum HospitalizationType {
  OUTPATIENT
  HOSPITALIZATION
}

enum DayCareType {
  DAYCARE
  HOTEL
}

enum ReasonLeaving {
  MEDICAL_DISCHARGE
  HOME_TREATMENT
  TRANSFER
  TUTOR_WISH
  ADMIN
  DEATH
  EUTHANASIA
}

enum DewormingType {
  INTERNAL
  EXTERNAL
  MIX
  OTHER
}

enum Frequency {
  CONTINUOUS
  EVERY_4H
  EVERY_6H
  EVERY_8H
  EVERY_12H
  EVERY_24H
  SINGLE
}

enum GuidelineType {
  FIXED
  INTERVAL
}

enum DurationMeasure {
  DAYS
  DOSES
  INDEFINITE
}

enum AppliedStatus {
  PENDING
  APPLIED
  SKIPPED
}

enum LaboratoryTestStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum LaboratoryTestPriority {
  NORMAL
  URGENTE
}

enum SurgeryStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum DiagnosticImagingStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum PromotionType {
  DISCOUNT
  SPECIAL_PRICE
}

enum ApplicationType {
  CATEGORY
  PRODUCT
  SERVICE
}

enum ValueType {
  PERCENTAGE
  VALUE
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

' =========================
' System / Auth
' =========================

class SystemUser {
  -code: String
  -hashPassword: String
  -createdDate: LocalDateTime
  -enabled: boolean
}

class SystemPermission {
  -name: String
  -code: String
  -createdDate: LocalDateTime
  -enabled: boolean
}

class SystemUserPermission {
  -systemUser: SystemUser
  -systemPermission: SystemPermission
  -createdDate: LocalDateTime
  -enabled: boolean
}

' =========================
' Membership / Modules
' =========================

class Membership {
  -name: String
  -status: MembershipStatus
  -mandatory: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Module {
  -name: String
  -code: String
  -createdDate: LocalDateTime
  -enabled: boolean
}

class SubModule {
  -name: String
  -code: String
  -module: Module
  -createdDate: LocalDateTime
  -enabled: boolean
}

class MembershipSubModule {
  -membership: Membership
  -subModule: SubModule
  -createdDate: LocalDateTime
  -enabled: boolean
}

class BasePermission {
  -name: String
  -code: String
  -subModule: SubModule
  -createdDate: LocalDateTime
  -enabled: boolean
}

' =========================
' Company / Employee
' =========================

class Company {
  -name: String
  -identifier: String
  -address: String
  -contactNumber: String
  -city: City
  -membership: Membership
  -createdDate: LocalDateTime
  -enabled: boolean
}

class Employee {
  -employeeCode: String
  -hashPassword: String
  -name: String
  -email: String
  -status: EmployeeStatus
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

' =========================
' Authorization
' =========================

class BaseRole {
  -name: String
  -code: String
  -mandatory: Boolean
  -createdDate: LocalDateTime
  -enabled: boolean
}

class Role {
  -name: String
  -code: String
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Permission {
  -name: String
  -code: String
  -company: Company
  -subModule: SubModule
  -createdDate: LocalDateTime
  -enabled: boolean
}

class RolePermission {
  -role: Role
  -permission: Permission
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class BaseRolePermission {
  -baseRole: BaseRole
  -basePermission: BasePermission
  -createdDate: LocalDateTime
  -enabled: boolean
}

class EmployeeRole {
  -employee: Employee
  -role: Role
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

' =========================
' Location
' =========================

class Country {
  -name: String
  -createdDate: LocalDateTime
  -enabled: boolean
}

class State {
  -name: String
  -country: Country
  -createdDate: LocalDateTime
  -enabled: boolean
}

class City {
  -name: String
  -state: State
  -createdDate: LocalDateTime
  -enabled: boolean
}

' =========================
' Owner / Animal
' =========================

class Owner {
  -name: String
  -email: String
  -document: String
  -address: String
  -phone: String
  -city: City
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Specie {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class AnimalColor {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Breed {
  -name: String
  -specie: Specie
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Animal {
  -name: String
  -code: String
  -bod: LocalDate
  -weight: Integer
  -size: Integer
  -gender: Gender
  -weightType: WeightType
  -animalType: AnimalType
  -reproductiveState: ReproductiveState
  -deceased: Boolean
  -deceasedDate: LocalDate
  -specie: Specie
  -breed: Breed
  -color: AnimalColor
  -owner: Owner
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

' =========================
' Medical Records
' =========================

class ConsultationType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Consultation {
  -date: LocalDate
  -type: ConsultationType
  -anamnesis: String
  -diagnosis: String
  -therapeuticPlan: String
  -diagnosisPlan: String
  -nextControl: LocalDate
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class VaccinationType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Vaccination {
  -date: LocalDate
  -type: VaccinationType
  -lot: String
  -notes: String
  -nextVaccination: LocalDate
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class SurgeryType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Surgery {
  -date: LocalDate
  -surgeryType: SurgeryType
  -description: String
  -medicament: String
  -observations: String
  -complications: String
  -status: SurgeryStatus
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Hospitalization {
  -date: LocalDate
  -startDate: LocalDate
  -endDate: LocalDate
  -type: HospitalizationType
  -reasonLeaving: ReasonLeaving
  -reason: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class HospitalizationObservation {
  -description: String
  -hospitalization: Hospitalization
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class HospitalizationProgressNote {
  -description: String
  -hospitalization: Hospitalization
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class HospitalizationMedication {
  -name: String
  -dose: String
  -frequency: Frequency
  -guidelineType: GuidelineType
  -durationMeasure: DurationMeasure
  -durationQuantity: Integer
  -startDate: LocalDate
  -startTime: LocalTime
  -notes: String
  -suspensionDate: LocalDateTime
  -suspensionBy: Employee
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class HospitalizationProcedure {
  -name: String
  -dose: String
  -frequency: Frequency
  -guidelineType: GuidelineType
  -durationMeasure: DurationMeasure
  -durationQuantity: Integer
  -startDate: LocalDate
  -startTime: LocalTime
  -notes: String
  -suspensionDate: LocalDateTime
  -suspensionBy: Employee
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class ProcedureSchedule {
  -hospitalizationProcedure: HospitalizationProcedure
  -originalDateTime: LocalDateTime
  -currentDateTime: LocalDateTime
  -realDateTime: LocalDateTime
  -appliedStatus: AppliedStatus
  -rescheduled: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class MedicationSchedule {
  -hospitalizationMedication: HospitalizationMedication
  -originalDateTime: LocalDateTime
  -currentDateTime: LocalDateTime
  -realDateTime: LocalDateTime
  -appliedStatus: AppliedStatus
  -rescheduled: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class DayCare {
  -date: LocalDate
  -startDate: LocalDate
  -endDate: LocalDate
  -type: DayCareType
  -objects: String
  -observations: String
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

' =========================
' Inventory / Catalog
' =========================

class Product {
  -name: String
  -code: String
  -purchasePrice: BigDecimal
  -salePrice: BigDecimal
  -currentStock: Integer
  -minStock: Integer
  -provider: String
  -hasTax: Boolean
  -expireDate: Boolean
  -notes: String
  -productCategory: ProductCategory
  -tax: Tax
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

class Service {
  -name: String
  -price: BigDecimal
  -hasTax: Boolean
  -notes: String
  -serviceCategory: ServiceCategory
  -tax: Tax
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

class ProductCategory {
  -name: String
  -description: String
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

class ServiceCategory {
  -name: String
  -description: String
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

class Tax {
  -name: String
  -percentage: BigDecimal
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

class Promotion {
  -name: String
  -promotionType: PromotionType
  -applicationType: ApplicationType
  -applicationItem: Integer
  -valueType: ValueType
  -value: Double
  -startDate: LocalDateTime
  -endDate: LocalDateTime
  -promotionStatus: PromotionStatus
  -company: Company
  -createdDate: LocalDateTime
  -enabled: boolean
}

' =========================
' Medical Records (continuación)
' =========================

class LaboratoryTestType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class LaboratoryTest {
  -date: LocalDate
  -type: LaboratoryTestType
  -quantity: Integer
  -diagnosis: String
  -status: LaboratoryTestStatus
  -prioridad: LaboratoryTestPriority
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -processedBy: Employee
  -processedDate: LocalDateTime
  -enabled: boolean
}

class LaboratoryTestFile {
  - storageKey: String
  - bucket: String
  - originalFileName: String
  - contentType: String
  - sizeBytes: String
  - eTag: String
  - uploadedBy: Employee
  - createdDate: LocalDateTime
  - laboratoryTest: LaboratoryTest
}

class Prescription {
  -date: LocalDate
  -diagnosis: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class MedicamentPrescription {
  -name: String
  -presentation: String
  -quantity: Double
  -posology: String
  -prescription: Prescription
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Deworming {
  -date: LocalDate
  -lastDeworming: LocalDate
  -nextControl: LocalDate
  -type: DewormingType
  -product: String
  -dosage: String
  -observations: String
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class DiagnosticImagingType {
  -name: String
  -description: String
  -company: Company
  -general: Boolean
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class DiagnosticImaging {
  -date: LocalDate
  -type: DiagnosticImagingType
  -clinicalSigns: String
  -studyType: String
  -diagnosis: String
  -observations: String
  -status: DiagnosticImagingStatus
  -animal: Animal
  -consultation: Consultation
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class SpaType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class Spa {
  -date: LocalDate
  -type: SpaType
  -reason: String
  -details: String
  -observations: String
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

' =========================
' Billing / Open Accounts
' =========================

class OpenAccount {
  -owner: Owner
  -totalAmount: Double
  -paidAmount: Double
  -outstandingAmount: Double
  -company: Company
  -status: OpenAccountStatus
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class DebtOpenAccount {
  -amount: Double
  -paymentMethod: PaymentMethod
  -openAccount: OpenAccount
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class ProductChargeOpenAccount {
  -animal: Animal
  -product: Product
  -openAccount: OpenAccount
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class ServiceChargeOpenAccount {
  -animal: Animal
  -service: Service
  -openAccount: OpenAccount
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

class GeneralChargeOpenAccount {
  -name: String
  -unitAmount: Double
  -quantity: Double
  -tax: Tax
  -hasTax: Boolean
  -openAccount: OpenAccount
  -createdDate: LocalDateTime
  -createdBy: Employee
  -enabled: boolean
}

' =========================
' Relationships
' =========================

' --- System / Auth ---
SystemUserPermission --> SystemUser
SystemUserPermission --> SystemPermission

' --- Membership / Modules ---
Membership          --> MembershipStatus
MembershipSubModule --> Membership
MembershipSubModule --> SubModule
SubModule           --> Module
BasePermission      --> SubModule

' --- Company / Employee ---
Company  --> Membership
Company  --> City
Employee --> Company
Employee --> EmployeeStatus

' --- Authorization ---
Role               --> Company
Permission         --> Company
Permission         --> SubModule
RolePermission     --> Role
RolePermission     --> Permission
BaseRolePermission --> BaseRole
BaseRolePermission --> BasePermission
EmployeeRole       --> Employee
EmployeeRole       --> Role

' --- Location ---
City  --> State
State --> Country

' --- Owner / Animal ---
Owner  "0..*" --> "1" City
Owner         --> Company
Breed         --> Specie
Animal        --> Specie
Animal        --> Breed
Animal        --> AnimalColor
Animal        --> Owner
Animal        --> Company
Animal        --> Gender
Animal        --> WeightType
Animal        --> AnimalType
Animal        --> ReproductiveState

' --- Medical Records ---
Consultation          --> ConsultationType
Consultation          --> Animal
Consultation          --> Company

VaccinationType       "0..*" --> "0..1" Company
Vaccination           --> VaccinationType
Vaccination           --> Animal
Vaccination           --> Company
Vaccination           "0..*" --> "0..1" Consultation

SurgeryType           "0..*" --> "0..1" Company
Surgery               --> SurgeryType
Surgery               --> Animal
Surgery               --> Company
Surgery               --> SurgeryStatus
Surgery               "0..*" --> "0..1" Consultation

Hospitalization       --> HospitalizationType
HospitalizationObservation       --> Hospitalization
HospitalizationProgressNote       --> Hospitalization
HospitalizationMedication       --> Hospitalization
HospitalizationMedication       --> Frequency
HospitalizationMedication       --> GuidelineType
HospitalizationMedication       --> DurationMeasure
HospitalizationProcedure       --> Hospitalization
HospitalizationProcedure       --> Frequency
HospitalizationProcedure       --> GuidelineType
HospitalizationProcedure       --> DurationMeasure
ProcedureSchedule       --> HospitalizationProcedure
ProcedureSchedule       --> AppliedStatus
MedicationSchedule       --> HospitalizationMedication
MedicationSchedule       --> AppliedStatus
Hospitalization       --> ReasonLeaving
Hospitalization       --> Animal
Hospitalization       --> Company
Hospitalization       "0..*" --> "0..1" Consultation

DayCare       --> DayCareType
DayCare       --> Animal
DayCare       --> Company

LaboratoryTestType              "0..*" --> "0..1" Company
LaboratoryTest        --> LaboratoryTestType
LaboratoryTestFile    --> LaboratoryTest
LaboratoryTest        --> Animal
LaboratoryTest        --> Company
LaboratoryTest        --> LaboratoryTestStatus
LaboratoryTest        --> LaboratoryTestPriority
LaboratoryTest        "0..*" --> "0..1" Consultation
LaboratoryTest        "0..*" --> "0..1" Employee : processedBy

Prescription          --> Animal
Prescription          --> Company
Prescription          --> Consultation
MedicamentPrescription --> Prescription

Deworming             --> DewormingType
Deworming             --> Animal
Deworming             --> Company
Deworming             "0..*" --> "0..1" Consultation

DiagnosticImagingType "0..*" --> "0..1" Company
DiagnosticImaging     --> DiagnosticImagingType
DiagnosticImaging     --> Animal
DiagnosticImaging     --> Company
DiagnosticImaging     --> DiagnosticImagingStatus
DiagnosticImaging     "0..*" --> "0..1" Consultation

Spa                   --> SpaType
Spa                   --> Animal
Spa                   --> Company

' --- Inventory / Catalog ---
Product               --> ProductCategory
Product               "0..*" --> "0..1" Tax
Product               --> Company
Service               --> ServiceCategory
Service               "0..*" --> "0..1" Tax
Service               --> Company
ProductCategory       --> Company
ServiceCategory       --> Company
Tax                   --> Company

Promotion             --> PromotionType
Promotion             --> ApplicationType
Promotion             --> ValueType
Promotion             --> PromotionStatus
Promotion             --> Company

' --- Billing / Open Accounts ---
OpenAccount                --> Owner
OpenAccount                --> Company
DebtOpenAccount            --> PaymentMethod
DebtOpenAccount            --> OpenAccount
ProductChargeOpenAccount   --> Animal
ProductChargeOpenAccount   --> Product
ProductChargeOpenAccount   --> OpenAccount
ServiceChargeOpenAccount   --> Animal
ServiceChargeOpenAccount   --> Service
ServiceChargeOpenAccount   --> OpenAccount
GeneralChargeOpenAccount   "0..*" --> "0..1" Tax
GeneralChargeOpenAccount   --> OpenAccount

@enduml
