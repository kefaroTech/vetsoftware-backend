' =========================
' Relationships
' =========================

' --- System / Auth ---
SystemUserPermission --> SystemUser
SystemUserPermission --> SystemPermission

' --- Membership / Modules ---
Membership          --> MembershipStatus
MembershipSubModule --> Membership
MembershipSubModule --> SubModule
SubModule           --> Module
BasePermission      --> SubModule

' --- Company / Employee ---
Company  --> Membership
Company  --> City
Employee --> Company

' --- Company Tax Profile (DIAN) ---
CompanyTaxProfile               --> Company
CompanyTaxProfile               --> CompanyDocumentType
CompanyTaxProfile               --> TaxRegime
CompanyTaxProfile               "0..*" --> "0..1" EconomicActivity
CompanyTaxProfileResponsibility --> CompanyTaxProfile
NumberingResolution             --> Company
NumberingResolution             --> ElectronicDocumentType

' --- Authorization ---
Role               --> Company
Permission         --> Company
Permission         --> SubModule
RolePermission     --> Role
RolePermission     --> Permission
BaseRolePermission --> BaseRole
BaseRolePermission --> BasePermission
EmployeeRole       --> Employee
EmployeeRole       --> Role

' --- Location ---
City  --> State
State --> Country

' --- Owner / Animal ---
Owner  "0..*" --> "1" City
Owner         --> Company
Owner         --> OwnerDocumentType
Owner         --> PersonType
Breed         --> Specie
Animal        --> Specie
Animal        --> Breed
Animal        --> AnimalColor
Animal        --> Owner
Animal        --> Company
Animal        --> Gender
Animal        --> WeightType
Animal        --> AnimalType
Animal        --> ReproductiveState

' --- Medical Records ---
Consultation          --> ConsultationType
Consultation          --> Animal
Consultation          --> Company

VaccinationType       "0..*" --> "0..1" Company
Vaccination           --> VaccinationType
Vaccination           --> Animal
Vaccination           --> Company
Vaccination           "0..*" --> "0..1" Consultation

SurgeryType           "0..*" --> "0..1" Company
Surgery               --> SurgeryType
Surgery               --> Animal
Surgery               --> Company
Surgery               --> SurgeryStatus
Surgery               "0..*" --> "0..1" Consultation

Hospitalization       --> HospitalizationType
HospitalizationObservation       --> Hospitalization
HospitalizationProgressNote       --> Hospitalization
HospitalizationMedication       --> Hospitalization
