@startuml

' =========================
' Enums
' =========================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum Gender {
  MALE
  FEMALE
}

enum WeightType {
  GRAMS
  POUNDS
  KILOGRAMS
}

enum AnimalType {
  SERVICE
  SUPPORT
  NONE
}

enum ReproductiveState {
  STERILIZED
  NO_STERILIZED
  UNKNOWN
}

enum HospitalizationType {
  OUTPATIENT
  HOSPITALIZATION
}

enum ReasonLeaving {
  MEDICAL_DISCHARGE
  HOME_TREATMENT
  TRANSFER
  TUTOR_WISH
  ADMIN
  DEATH
  EUTHANASIA
}

enum DewormingType {
  INTERNAL
  EXTERNAL
  MIX
  OTHER
}

' =========================
' System / Auth
' =========================

class SystemUser {
  -code: String
  -hashPassword: String
  -createdDate: LocalDateTime
}

class SystemPermission {
  -name: String
  -code: String
  -createdDate: LocalDateTime
}

class SystemUserPermission {
  -systemUser: SystemUser
  -systemPermission: SystemPermission
  -createdDate: LocalDateTime
}

' =========================
' Membership / Modules
' =========================

class Membership {
  -name: String
  -status: MembershipStatus
  -createdDate: LocalDateTime
  -mandatory: Boolean
  -createdBy: Employee
}

class Module {
  -name: String
  -code: String
  -createdDate: LocalDateTime
}

class SubModule {
  -name: String
  -code: String
  -module: Module
  -createdDate: LocalDateTime
}

class MembershipSubModule {
  -membership: Membership
  -subModule: SubModule
  -createdDate: LocalDateTime
}

class BasePermission {
  -name: String
  -code: String
  -subModule: SubModule
  -createdDate: LocalDateTime
}

' =========================
' Company / Employee
' =========================

class Company {
  -name: String
  -identifier: String
  -address: String
  -city: City
  -contactNumber: String
  -membership: Membership
  -createdDate: LocalDateTime
}

class Employee {
  -employeeCode: String
  -hashPassword: String
  -name: String
  -email: String
  -status: EmployeeStatus
  -company: Company
  -createdDate: LocalDateTime
}

' =========================
' Authorization
' =========================

class BaseRole {
  -name: String
  -code: String
  -mandatory: Boolean
  -createdDate: LocalDateTime
}

class Role {
  -name: String
  -code: String
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Permission {
  -name: String
  -code: String
  -company: Company
  -subModule: SubModule
  -createdDate: LocalDateTime
}

class RolePermission {
  -role: Role
  -permission: Permission
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class BaseRolePermission {
  -baseRole: BaseRole
  -basePermission: BasePermission
  -createdDate: LocalDateTime
}

class EmployeeRole {
  -employee: Employee
  -role: Role
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Location
' =========================

class Country {
  -name: String
  -createdDate: LocalDateTime
}

class State {
  -name: String
  -country: Country
  -createdDate: LocalDateTime
}

class City {
  -name: String
  -state: State
  -createdDate: LocalDateTime
}

' =========================
' Owner / Animal
' =========================

class Owner {
  -name: String
  -email: String
  -document: String
  -address: String
  -phone: String
  -city: City
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Specie {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class AnimalColor {
  -name: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Breed {
  -name: String
  -specie: Specie
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Animal {
  -name: String
  -code: String
  -specie: Specie
  -breed: Breed
  -owner: Owner
  -gender: Gender
  -weightType: WeightType
  -animalType: AnimalType
  -reproductiveState: ReproductiveState
  -color: AnimalColor
  -bod: LocalDate
  -weight: Integer
  -size: Integer
  -deceased: Boolean
  -deceasedDate: LocalDate
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Medical Records
' =========================

class ConsultationType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Consultation {
  -date: LocalDate
  -type: ConsultationType
  -anamnesis: String
  -diagnosis: String
  -therapeuticPlan: String
  -diagnosisPlan: String
  -nextControl: LocalDate
  -animal: Animal
  -company: Company
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class VaccinationType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Vaccination {
  -date: LocalDate
  -type: VaccinationType
  -lot: String
  -notes: String
  -nextVaccination: LocalDate
  -animal: Animal
  -createdDate: LocalDateTime
  -company: Company
  -createdBy: Employee
}

class SurgeryType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Surgery {
  -date: LocalDate
  -surgeryType: SurgeryType
  -description: String
  -medicament: String
  -observations: String
  -complications: String
  -animal: Animal
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Hospitalization {
  -date: LocalDate
  -startDate: LocalDate
  -endDate: LocalDate
  -type: HospitalizationType
  -reasonLeaving: ReasonLeaving
  -reason: String
  -observations: String
  -animal: Animal
  -createdDate: LocalDateTime
  -company: Company
  -createdBy: Employee
}

class TestType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class LaboratoryTest {
  -date: LocalDate
  -type: TestType
  -quantity: Integer
  -diagnosis: String
  -animal: Animal
  -createdDate: LocalDateTime
  -company:Company
  -createdBy: Employee
}

class Prescription {
  -date: LocalDate
  -diagnosis: String
  -observations: String
  -animal: Animal
  -createdDate: LocalDateTime
  -company:Company
  -createdBy: Employee
}

class Medicament {
  -name: String
  -presentation: String
  -quantity: Double
  -posology: Posology
  -prescription: Prescription
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Deworming {
  -date: LocalDate
  -lastDeworming: LocalDate
  -type: DewormingType
  -product: String
  -dosage: String
  -nextControl: LocalDate
  -observations: String
  -animal: Animal
  -createdDate: LocalDateTime
  -company:Company
  -createdBy: Employee
}

class DiagnosticImagingType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class DiagnosticImaging {
  -date: LocalDate
  -type: DiagnosticImagingType
  -clinicalSigns: String
  -studyType: String
  -diagnosis: String
  -observations: String
  -animal: Animal
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class SpaType {
  -name: String
  -description: String
  -createdDate: LocalDateTime
  -createdBy: Employee
}

class Spa {
  -date: LocalDate
  -type: SpaType
  -reason: String
  -details: String
  -observations: String
  -animal: Animal
  -createdDate: LocalDateTime
  -createdBy: Employee
}

' =========================
' Relationships
' =========================

' System / Auth
SystemUserPermission --> SystemUser
SystemUserPermission --> SystemPermission

' Membership / Modules
Membership          --> MembershipStatus
MembershipSubModule --> Membership
MembershipSubModule --> SubModule
SubModule           --> Module
BasePermission      --> SubModule

' Company / Employee
Company  --> Membership
Company  --> City
Employee --> Company
Employee --> EmployeeStatus

' Authorization
Role               --> Company
Permission         --> Company
Permission         --> SubModule
RolePermission     --> Role
RolePermission     --> Permission
BaseRolePermission --> BaseRole
BaseRolePermission --> BasePermission
EmployeeRole       --> Employee
EmployeeRole       --> Role

' Location
City         --> State
State         --> Country
Owner "0..*" --> "1" City

' Owner / Animal
Owner  --> Company
Breed  --> Specie
Animal --> Specie
Animal --> AnimalColor
Animal --> Breed
Animal --> Owner
Animal --> Company
Animal --> Gender
Animal --> WeightType
Animal --> AnimalType
Animal --> ReproductiveState

' Medical Records
Consultation      --> Animal
Consultation      --> Company
Consultation      --> ConsultationType
Vaccination       --> Animal
Vaccination       --> Company
Vaccination       --> VaccinationType
Surgery           --> Animal
Surgery           --> SurgeryType
Hospitalization   --> Animal
Hospitalization   --> Company
Hospitalization   --> HospitalizationType
Hospitalization   --> ReasonLeaving
LaboratoryTest    --> Animal
LaboratoryTest    --> Company
LaboratoryTest    --> TestType
Prescription      --> Animal
Prescription      --> Company
Prescription      --> Medicament
Deworming         --> Animal
Deworming         --> Company
Deworming         --> DewormingType
DiagnosticImaging --> Animal
DiagnosticImaging --> DiagnosticImagingType
Spa               --> Animal
Spa               --> SpaType

@enduml
