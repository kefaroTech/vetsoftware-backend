@startuml animalcolor_delete
title DELETE /animal-colors/{id} — Delete AnimalColor

actor Client
participant "AnimalColorController" as Controller
participant "DeleteAnimalColorUseCase\n<<port.in>>" as UseCase
participant "DeleteAnimalColorService" as Service
participant "AnimalColorRepository\n<<port.out>>" as Repo
participant "AnimalColorJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /animal-colors/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT animal_color
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<AnimalColorJpaEntity>
alt color no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : AnimalColorNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<AnimalColor>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE animal_color
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
