@startuml breed_find
title GET /breeds/{id} — Find Breed by ID

actor Client
participant "BreedController" as Controller
participant "FindBreedUseCase\n<<port.in>>" as UseCase
participant "FindBreedService" as Service
participant "BreedRepository\n<<port.out>>" as Repo
participant "BreedJpaMapper" as Mapper
participant "BreedJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /breeds/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT breed\nJOIN FETCH specie\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<BreedJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Breed
  Repo --> Service : Optional<Breed>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : BreedNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : BreedDto.from(breed)
Service --> UseCase : BreedDto
UseCase --> Controller : BreedDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nBreedResponse
deactivate Controller

@enduml
