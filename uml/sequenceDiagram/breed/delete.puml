@startuml breed_delete
title DELETE /breeds/{id} — Delete Breed

actor Client
participant "BreedController" as Controller
participant "DeleteBreedUseCase\n<<port.in>>" as UseCase
participant "DeleteBreedService" as Service
participant "BreedRepository\n<<port.out>>" as Repo
participant "BreedJpaRepository\n<<spring-data>>" as JpaRepo
participant "AnimalChildrenQueryPort\n<<port.out>>" as AnimalCP
participant "AnimalJpaRepository\n<<spring-data>>" as AnimalJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /breeds/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT breed (JOIN FETCH specie)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<BreedJpaEntity>
alt breed no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : BreedNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Breed>

Service -> AnimalCP : existsActiveByBreedId(id)
AnimalCP -> AnimalJpaRepo : existsByBreed_Id(id)
AnimalJpaRepo -> DB : SELECT EXISTS(...) WHERE breed_id=? AND enabled=true
DB --> AnimalJpaRepo : true/false
AnimalJpaRepo --> AnimalCP : boolean
AnimalCP --> Service : boolean
alt hay animales activos
  Service --> GEH : BreedHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE breed SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
