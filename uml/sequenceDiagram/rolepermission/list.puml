@startuml rolepermission_list
title GET /role-permissions — List all RolePermissions

actor Client
participant "RolePermissionController" as Controller
participant "ListRolePermissionsUseCase\n<<port.in>>" as UseCase
participant "ListRolePermissionsService" as Service
participant "RolePermissionRepository\n<<port.out>>" as Repo
participant "RolePermissionJpaMapper" as Mapper
participant "RolePermissionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /role-permissions
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR rolePermissions.read OR SYSTEM
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT role_permission\nJOIN FETCH (role, permission)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<RolePermissionJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<RolePermission>
Repo --> Service : List<RolePermission>
deactivate Repo

Service -> Service : stream().map(RolePermissionDto::from).toList()
Service --> UseCase : List<RolePermissionDto>
UseCase --> Controller : List<RolePermissionDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<RolePermissionResponse>
deactivate Controller

@enduml
