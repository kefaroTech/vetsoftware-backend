@startuml rolepermission_list_by_company
title GET /role-permissions/by-company — List RolePermissions of current company

actor Client
participant "RolePermissionController" as Controller
participant "Authz" as Authz
participant "ListRolePermissionsByCompanyUseCase\n<<port.in>>" as UseCase
participant "ListRolePermissionsByCompanyService" as Service
participant "RolePermissionRepository\n<<port.out>>" as Repo
participant "RolePermissionJpaMapper" as Mapper
participant "RolePermissionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /role-permissions/by-company
activate Controller

Controller -> Authz : currentCompanyId()
Authz --> Controller : companyId

Controller -> UseCase : listByCompany(companyId)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM OR
  (rolePermissions.read AND
   authz.isMyCompany(#companyId))
end note
UseCase -> Service : listByCompany(companyId)
activate Service

Service -> Repo : findAllByRoleCompanyId(companyId)
activate Repo
Repo -> JpaRepo : findAllByRoleCompanyId(companyId)
JpaRepo -> DB : SELECT role_permission\nWHERE role.company_id=?\nJOIN FETCH (role, permission)
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<RolePermissionJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<RolePermission>
Repo --> Service : List<RolePermission>
deactivate Repo

Service -> Service : stream().map(RolePermissionDto::from).toList()
Service --> UseCase : List<RolePermissionDto>
UseCase --> Controller : List<RolePermissionDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<RolePermissionResponse>
deactivate Controller

@enduml
