@startuml laboratory_test_delete
title DELETE /laboratory-tests/{id} — Delete LaboratoryTest

actor Client
participant "LaboratoryTestController" as Controller
participant "DeleteLaboratoryTestUseCase\n<<port.in>>" as UseCase
participant "DeleteLaboratoryTestService" as Service
participant "LaboratoryTestRepository\n<<port.out>>" as Repo
participant "LaboratoryTestJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /laboratory-tests/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR laboratoryTest.delete OR SYSTEM
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT laboratory_test (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<LaboratoryTestJpaEntity>
alt laboratoryTest no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : LaboratoryTestNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<LaboratoryTest>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE laboratory_test SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
