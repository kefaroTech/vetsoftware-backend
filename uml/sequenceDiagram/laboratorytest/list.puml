@startuml laboratory_test_list
title GET /laboratory-tests — List all LaboratoryTests

actor Client
participant "LaboratoryTestController" as Controller
participant "ListLaboratoryTestsUseCase\n<<port.in>>" as UseCase
participant "ListLaboratoryTestsService" as Service
participant "LaboratoryTestRepository\n<<port.out>>" as Repo
participant "LaboratoryTestJpaMapper" as Mapper
participant "LaboratoryTestJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /laboratory-tests
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT laboratory_test\nJOIN FETCH (testType, animal, consultation, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<LaboratoryTestJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<LaboratoryTest>
Repo --> Service : List<LaboratoryTest>
deactivate Repo

Service -> Service : stream().map(LaboratoryTestDto::from).toList()
Service --> UseCase : List<LaboratoryTestDto>
UseCase --> Controller : List<LaboratoryTestDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<LaboratoryTestResponse>
deactivate Controller

@enduml
