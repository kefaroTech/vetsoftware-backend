@startuml laboratory_test_change_status
title PATCH /laboratory-tests/{id}/status — Change LaboratoryTest Status

actor Client
participant "LaboratoryTestController" as Controller
participant "ChangeLaboratoryTestStatusUseCase\n<<port.in>>" as UseCase
participant "ChangeLaboratoryTestStatusService" as Service
participant "EmployeeQueryPort\n<<port.out>>" as EmployeeQP
participant "LaboratoryTestRepository\n<<port.out>>" as Repo
participant "LaboratoryTestJpaMapper" as Mapper
participant "LaboratoryTestJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : PATCH /laboratory-tests/{id}/status\n+ ChangeLaboratoryTestStatusRequest
activate Controller

Controller -> Controller : processedById = authz.currentEmployeeIdOrNull()
Controller -> UseCase : execute(ChangeLaboratoryTestStatusCommand{id, status, processedById})
note right of UseCase
  @PreAuthorize:
  admin.all OR laboratoryTest.process OR SYSTEM
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT laboratory_test (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<LaboratoryTestJpaEntity>
alt laboratoryTest no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : LaboratoryTestNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : LaboratoryTest
Repo --> Service : Optional<LaboratoryTest>

Service -> Service : LaboratoryTestStatus.valueOf(status.toUpperCase())
note right of Service: lanza IllegalArgumentException si\nel status no es válido → 400
alt newStatus == COMPLETED && processedById != null  (validar y firmar)
  Service -> EmployeeQP : findById(processedById)
  EmployeeQP --> Service : Optional<EmployeeRef>
  Service -> Service : laboratoryTest.changeStatus(COMPLETED, processedBy, now())\n(setea processedBy + processedDate)
else otras transiciones
  Service -> Service : laboratoryTest.changeStatus(newStatus)
end

Service -> Repo : save(laboratoryTest)
Repo -> JpaRepo : getReferenceById(...)\n(proxies sin SELECT)
JpaRepo --> Repo : proxies
Repo -> Mapper : toJpa(laboratoryTest, testType, animal, consultation, company, processedBy)
Mapper --> Repo : LaboratoryTestJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE laboratory_test
DB --> JpaRepo : ok
JpaRepo --> Repo : LaboratoryTestJpaEntity
Repo -> Mapper : toDomain(entity, refs precargados)
Mapper --> Repo : LaboratoryTest
Repo --> Service : LaboratoryTest

Service -> Service : LaboratoryTestDto.from(laboratoryTest)
Service --> UseCase : LaboratoryTestDto
UseCase --> Controller : LaboratoryTestDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nLaboratoryTestResponse
deactivate Controller

@enduml
