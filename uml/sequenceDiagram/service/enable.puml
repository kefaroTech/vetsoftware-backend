@startuml service_enable
title PATCH /services/{id}/enable — Reactivate Service

actor Client
participant "ServiceController" as Controller
participant "ReactivateServiceUseCase\n<<port.in>>" as UseCase
participant "ReactivateServiceService" as Service
participant "ServiceRepository\n<<port.out>>" as Repo
participant "ServiceJpaMapper" as Mapper
participant "ServiceJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  reactivate() es un UPDATE nativo que NO pasa por @SQLRestriction,
  por eso puede tocar filas con enabled=false.
end note

Client -> Controller : PATCH /services/{id}/enable
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR service.delete
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : reactivate(id)
Repo -> JpaRepo : reactivate(id)
JpaRepo -> DB : UPDATE services SET enabled=true WHERE id=:id (nativeQuery)
DB --> JpaRepo : rows afectadas
JpaRepo --> Repo : int rows
Repo --> Service : int rows
alt rows == 0
  Service --> GEH : ServiceNotFoundException
  GEH --> Client : 404 Not Found
end

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT services\nJOIN FETCH (serviceCategory, tax, company)
DB --> JpaRepo : row
JpaRepo --> Repo : Optional<ServiceJpaEntity>
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : Service
Repo --> Service : Optional<Service>

Service -> Service : ServiceDto.from(service)
Service --> UseCase : ServiceDto
UseCase --> Controller : ServiceDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nServiceResponse
deactivate Controller

@enduml
