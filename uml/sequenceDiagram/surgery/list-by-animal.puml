@startuml surgery_list_by_animal
title GET /surgeries/by-animal/{animalId} — List Surgeries of an Animal

actor Client
participant "SurgeryController" as Controller
participant "ListSurgeriesByAnimalUseCase\n<<port.in>>" as UseCase
participant "ListSurgeriesByAnimalService" as Service
participant "SurgeryRepository\n<<port.out>>" as Repo
participant "SurgeryJpaMapper" as Mapper
participant "SurgeryJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /surgeries/by-animal/{animalId}
activate Controller

Controller -> UseCase : listByAnimal(animalId)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  surgery.read OR
  hasRole('SYSTEM')
end note
UseCase -> Service : listByAnimal(animalId)
activate Service

Service -> Repo : findAllByAnimalId(animalId)
activate Repo
Repo -> JpaRepo : findAllByAnimalId(animalId)
JpaRepo -> DB : SELECT surgery\nWHERE animal_id=?\nJOIN FETCH (surgeryType, animal, consultation, company)
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<SurgeryJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Surgery>
Repo --> Service : List<Surgery>
deactivate Repo

Service -> Service : stream().map(SurgeryDto::from).toList()
Service --> UseCase : List<SurgeryDto>
UseCase --> Controller : List<SurgeryDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<SurgeryResponse>
deactivate Controller

@enduml
