@startuml systemuser_update
title PUT /system-users/{id} — Update SystemUser

actor Client
participant "SystemUserController" as Controller
participant "UpdateSystemUserUseCase\n<<port.in>>" as UseCase
participant "UpdateSystemUserService" as Service
participant "SystemUserRepository\n<<port.out>>" as Repo
participant "SystemUserJpaMapper" as Mapper
participant "SystemUserJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : PUT /system-users/{id}\n+ UpdateSystemUserRequest
activate Controller

Controller -> UseCase : execute(UpdateSystemUserCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT system_user
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SystemUserJpaEntity>
alt systemUser no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SystemUserNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : SystemUser
Repo --> Service : Optional<SystemUser>

Service -> Service : systemUser.update(code)\n(invariantes de dominio)

Service -> Repo : save(systemUser)
Repo -> Mapper : toJpa(systemUser)
Mapper --> Repo : SystemUserJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE system_user
DB --> JpaRepo : ok
JpaRepo --> Repo : SystemUserJpaEntity
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : SystemUser
Repo --> Service : SystemUser

Service -> Service : SystemUserDto.from(systemUser)
Service --> UseCase : SystemUserDto
UseCase --> Controller : SystemUserDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nSystemUserResponse
deactivate Controller

@enduml
