@startuml systemuser_delete
title DELETE /system-users/{id} — Delete SystemUser

actor Client
participant "SystemUserController" as Controller
participant "DeleteSystemUserUseCase\n<<port.in>>" as UseCase
participant "DeleteSystemUserService" as Service
participant "SystemUserRepository\n<<port.out>>" as Repo
participant "SystemUserJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /system-users/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT system_user
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SystemUserJpaEntity>
alt systemUser no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SystemUserNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<SystemUser>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE system_user
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
