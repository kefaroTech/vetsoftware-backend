@startuml city_find
title GET /cities/{id} — Find City by ID

actor Client
participant "CityController" as Controller
participant "FindCityUseCase\n<<port.in>>" as UseCase
participant "FindCityService" as Service
participant "CityRepository\n<<port.out>>" as Repo
participant "CityJpaMapper" as Mapper
participant "CityJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso el principal
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /cities/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT city\nJOIN FETCH state\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<CityJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : City
  Repo --> Service : Optional<City>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : CityNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : CityDto.from(city)
Service --> UseCase : CityDto
UseCase --> Controller : CityDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nCityResponse
deactivate Controller

@enduml
