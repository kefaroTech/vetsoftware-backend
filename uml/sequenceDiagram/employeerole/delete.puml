@startuml employeerole_delete
title DELETE /employee-roles/{id} — Delete EmployeeRole

actor Client
participant "EmployeeRoleController" as Controller
participant "DeleteEmployeeRoleUseCase\n<<port.in>>" as UseCase
participant "DeleteEmployeeRoleService" as Service
participant "EmployeeRoleRepository\n<<port.out>>" as Repo
participant "PermissionCachePort\n<<port.out>>" as CachePort
participant "EmployeeRoleJpaMapper" as Mapper
participant "EmployeeRoleJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /employee-roles/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT employee_role (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<EmployeeRoleJpaEntity>
alt employeeRole no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : EmployeeRoleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : EmployeeRole
Repo --> Service : Optional<EmployeeRole>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE employee_role SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service -> CachePort : evictByEmployeeId(employeeRole.getEmployee().id())
CachePort --> Service : ok

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
