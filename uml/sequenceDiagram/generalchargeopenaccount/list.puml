@startuml general_charge_open_account_list
title GET /general-charge-open-accounts — List General Charges (all, or filtered by openAccountId)

actor Client
participant "GeneralChargeOpenAccountController" as Controller
participant "Authz" as Authz
participant "ListGeneralChargeOpenAccountsUseCase\n<<port.in>>" as ListAllUC
participant "ListGeneralChargeOpenAccountsByOpenAccountUseCase\n<<port.in>>" as ListByUC
participant "ListGeneralChargeOpenAccountsService" as ListAllSvc
participant "ListGeneralChargeOpenAccountsByOpenAccountService" as ListBySvc
participant "GeneralChargeOpenAccountRepository\n<<port.out>>" as Repo
participant "GeneralChargeOpenAccountJpaMapper" as Mapper
participant "GeneralChargeOpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /general-charge-open-accounts?openAccountId=(optional)
activate Controller

alt openAccountId != null
  Controller -> Authz : currentCompanyId()
  Authz --> Controller : companyId
  Controller -> ListByUC : listByOpenAccount(openAccountId, companyId)
  note right of ListByUC
    @PreAuthorize:
    admin.all OR
    (generalChargeOpenAccount.read AND
     authz.isMyCompany(#companyId)) OR
    hasRole('SYSTEM')
  end note
  ListByUC -> ListBySvc : listByOpenAccount(openAccountId, companyId)
  activate ListBySvc
  ListBySvc -> Repo : findByOpenAccountId(openAccountId)
  Repo -> JpaRepo : findByOpenAccountId(openAccountId)
  JpaRepo -> DB : SELECT charge WHERE open_account_id=?\nJOIN FETCH (tax, openAccount, createdBy)
  DB --> JpaRepo : rows[]
  JpaRepo --> Repo : List<GeneralChargeOpenAccountJpaEntity>
  Repo -> Mapper : toDomain(entity) por cada row
  Mapper --> Repo : List<GeneralChargeOpenAccount>
  Repo --> ListBySvc : List<GeneralChargeOpenAccount>
  ListBySvc -> ListBySvc : stream().map(GeneralChargeOpenAccountDto::from).toList()
  ListBySvc --> Controller : List<GeneralChargeOpenAccountDto>
  deactivate ListBySvc
else openAccountId == null
  Controller -> ListAllUC : listAll()
  note right of ListAllUC
    @PreAuthorize:
    admin.all OR hasRole('SYSTEM')
  end note
  ListAllUC -> ListAllSvc : listAll()
  activate ListAllSvc
  ListAllSvc -> Repo : findAll()
  Repo -> JpaRepo : findAll()
  JpaRepo -> DB : SELECT charge\nJOIN FETCH (tax, openAccount, createdBy)
  DB --> JpaRepo : rows[]
  JpaRepo --> Repo : List<GeneralChargeOpenAccountJpaEntity>
  Repo -> Mapper : toDomain(entity) por cada row
  Mapper --> Repo : List<GeneralChargeOpenAccount>
  Repo --> ListAllSvc : List<GeneralChargeOpenAccount>
  ListAllSvc -> ListAllSvc : stream().map(GeneralChargeOpenAccountDto::from).toList()
  ListAllSvc --> Controller : List<GeneralChargeOpenAccountDto>
  deactivate ListAllSvc
end

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<GeneralChargeOpenAccountResponse>
deactivate Controller

@enduml
