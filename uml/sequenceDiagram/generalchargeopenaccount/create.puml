@startuml general_charge_open_account_create
title POST /general-charge-open-accounts — Create General Charge on an Open Account

actor Client
participant "GeneralChargeOpenAccountController" as Controller
participant "Authz" as Authz
participant "CreateGeneralChargeOpenAccountUseCase\n<<port.in>>" as UseCase
participant "CreateGeneralChargeOpenAccountService" as Service
participant "OpenAccountQueryPort\n<<port.out>>" as OpenAccountQP
participant "TaxQueryPort\n<<port.out>>" as TaxQP
participant "EmployeeQueryPort\n<<port.out>>" as EmployeeQP
participant "GeneralChargeOpenAccountRepository\n<<port.out>>" as Repo
participant "GeneralChargeOpenAccountJpaMapper" as Mapper
participant "GeneralChargeOpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "OpenAccountRefresher\n<<port.out>>" as Refresher
participant "RecalculateOpenAccountUseCase\n(openaccount <<port.in>>)" as Recalc
participant "RecalculateOpenAccountService" as RecalcSvc
participant "OpenAccountTotalsPort\n(openaccount <<port.out>>)" as TotalsPort
participant "OpenAccountRepository\n(openaccount <<port.out>>)" as OARepo
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : POST /general-charge-open-accounts\n+ CreateGeneralChargeOpenAccountRequest (sin companyId)
activate Controller

Controller -> Authz : currentCompanyId()
Authz --> Controller : companyId
Controller -> Authz : currentEmployeeId()
Authz --> Controller : employeeId

Controller -> UseCase : execute(CreateGeneralChargeOpenAccountCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  (generalChargeOpenAccount.create AND
   authz.isMyCompany(#command.companyId)) OR
  hasRole('SYSTEM')
end note

UseCase -> Service : execute(command)
activate Service

Service -> OpenAccountQP : findById(openAccountId)
OpenAccountQP -> DB : SELECT open_account WHERE id=?
DB --> OpenAccountQP : row | empty
OpenAccountQP --> Service : Optional<OpenAccountRef>
alt open account no encontrada
  Service --> GEH : IllegalArgumentException\n"OpenAccount not found"
  GEH --> Client : 400 Bad Request
end
Service -> Service : check openAccount.companyId == command.companyId
alt no pertenece a la company
  Service --> GEH : IllegalArgumentException\n"open account does not belong to company"
  GEH --> Client : 400 Bad Request
end

Service -> OpenAccountQP : isOpen(openAccountId)
OpenAccountQP -> DB : SELECT status FROM open_account WHERE id=?
DB --> OpenAccountQP : status
OpenAccountQP --> Service : boolean (status == OPEN)
alt cuenta no está OPEN (cerrada/cancelada → inmutable)
  Service --> GEH : IllegalStateException\n"open account is not OPEN"
  GEH --> Client : 409 Conflict
end

alt taxId != null
  Service -> TaxQP : findById(taxId)
  TaxQP --> Service : Optional<TaxRef>
  alt tax no encontrado
    Service --> GEH : IllegalArgumentException\n"Tax not found"
    GEH --> Client : 400 Bad Request
  end
else taxId == null
  note right of Service : tax = null (FK opcional)
end

Service -> EmployeeQP : findById(createdById)
EmployeeQP --> Service : Optional<EmployeeRef>
alt employee no encontrado
  Service --> GEH : IllegalArgumentException\n"Employee not found"
  GEH --> Client : 400 Bad Request
end

Service -> Service : GeneralChargeOpenAccount.create(\nname, unitAmount, quantity, tax, hasTax,\nopenAccount, createdBy)
note right of Service
  unitAmount/quantity ya son snapshot; además la factory congela
  tax_percentage = tax.percentage cuando hasTax (null si no aplica).
  El total usa ese % guardado, no el vigente del catálogo de impuestos.
end note
Service -> Repo : save(charge)
activate Repo
Repo -> JpaRepo : getReferenceById(openAccount, createdBy)
alt tax != null
  Repo -> JpaRepo : getReferenceById(taxId)
end
Repo -> Mapper : toJpa(charge, refs)
Mapper --> Repo : GeneralChargeOpenAccountJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : INSERT general_charge_open_accounts
DB --> JpaRepo : id generado
JpaRepo --> Repo : entity (con id)
Repo -> Mapper : toDomain(entity, refs precargados)
Mapper --> Repo : GeneralChargeOpenAccount
Repo --> Service : GeneralChargeOpenAccount
deactivate Repo
Service -> Service : GeneralChargeOpenAccountDto.from(charge)

== Recálculo de la Open Account padre ==
Service -> Refresher : refresh(openAccount.id())
activate Refresher
Refresher -> Recalc : recalculate(openAccountId)
Recalc -> RecalcSvc : recalculate(openAccountId)
activate RecalcSvc
RecalcSvc -> OARepo : findById(openAccountId)
OARepo --> RecalcSvc : OpenAccount
RecalcSvc -> TotalsPort : totalCharges(openAccountId)
TotalsPort -> DB : SUM(product+service+general charges) WHERE enabled=true
DB --> TotalsPort : total
RecalcSvc -> TotalsPort : totalPayments(openAccountId)
TotalsPort -> DB : SUM(debt payments) WHERE enabled=true
DB --> TotalsPort : paid
RecalcSvc -> RecalcSvc : openAccount.recalculate(total, paid)\noutstanding = total - paid
RecalcSvc -> OARepo : save(openAccount)
OARepo -> DB : UPDATE open_accounts (total, paid, outstanding)
deactivate RecalcSvc
deactivate Refresher

Service --> UseCase : GeneralChargeOpenAccountDto
UseCase --> Controller : GeneralChargeOpenAccountDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 201 Created\nGeneralChargeOpenAccountResponse
deactivate Controller

@enduml
