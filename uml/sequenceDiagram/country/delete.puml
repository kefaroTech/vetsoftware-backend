@startuml country_delete
title DELETE /countries/{id} — Delete Country

actor Client
participant "CountryController" as Controller
participant "DeleteCountryUseCase\n<<port.in>>" as UseCase
participant "DeleteCountryService" as Service
participant "CountryRepository\n<<port.out>>" as Repo
participant "CountryJpaRepository\n<<spring-data>>" as JpaRepo
participant "StateChildrenQueryPort\n<<port.out>>" as ChildrenPort
participant "StateJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso el principal
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /countries/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT country
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<CountryJpaEntity>
alt country no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : CountryNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Country>

Service -> ChildrenPort : existsActiveByCountryId(id)
ChildrenPort -> ChildJpaRepo : existsByCountry_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE country_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenPort : boolean
ChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : CountryHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE country SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
