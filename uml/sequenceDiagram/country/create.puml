@startuml country_create
title POST /countries — Create Country

actor Client
participant "CountryController" as Controller
participant "CreateCountryUseCase\n<<port.in>>" as UseCase
participant "CreateCountryService" as Service
participant "CountryRepository\n<<port.out>>" as Repo
participant "CountryJpaMapper" as Mapper
participant "CountryJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso el principal
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : POST /countries\n+ CreateCountryRequest
activate Controller

Controller -> UseCase : execute(CreateCountryCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note

UseCase -> Service : execute(command)
activate Service

Service -> Service : Country.create(name)\n(invariantes de dominio)

Service -> Repo : save(country)
activate Repo
Repo -> Mapper : toJpa(country)
Mapper --> Repo : CountryJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : INSERT country
DB --> JpaRepo : id generado
JpaRepo --> Repo : CountryJpaEntity (con id)
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : Country
Repo --> Service : Country
deactivate Repo

Service -> Service : CountryDto.from(country)
Service --> UseCase : CountryDto
UseCase --> Controller : CountryDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 201 Created\nCountryResponse
deactivate Controller

@enduml
