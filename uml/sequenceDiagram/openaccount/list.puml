@startuml open_account_list
title GET /open-accounts — List all Open Accounts (admin / SYSTEM)

actor Client
participant "OpenAccountController" as Controller
participant "ListOpenAccountsUseCase\n<<port.in>>" as UseCase
participant "ListOpenAccountsService" as Service
participant "OpenAccountRepository\n<<port.out>>" as Repo
participant "OpenAccountJpaMapper" as Mapper
participant "OpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /open-accounts
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT open_account\nJOIN FETCH (owner, company, createdBy)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<OpenAccountJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<OpenAccount>
Repo --> Service : List<OpenAccount>
deactivate Repo

Service -> Service : stream().map(OpenAccountDto::from).toList()
Service --> UseCase : List<OpenAccountDto>
UseCase --> Controller : List<OpenAccountDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<OpenAccountResponse>
deactivate Controller

@enduml
