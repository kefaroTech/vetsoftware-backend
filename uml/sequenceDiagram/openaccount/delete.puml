@startuml open_account_delete
title DELETE /open-accounts/{id} — Delete Open Account

actor Client
participant "OpenAccountController" as Controller
participant "DeleteOpenAccountUseCase\n<<port.in>>" as UseCase
participant "DeleteOpenAccountService" as Service
participant "OpenAccountRepository\n<<port.out>>" as Repo
participant "OpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /open-accounts/{id}
activate Controller

Controller -> UseCase : execute(id, companyId)\n(companyId = authz.currentCompanyId())
note right of UseCase
  @PreAuthorize:
  admin.all OR (openAccount.delete AND @authz.isMyCompany(#companyId)) OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id, companyId)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT open_account (JOIN FETCH owner, company, createdBy)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<OpenAccountJpaEntity>
alt open account no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : OpenAccountNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<OpenAccount>
alt openAccount.company.id != companyId del caller
  Service --> GEH : IllegalArgumentException ("open account does not belong to company")
  GEH --> Client : 400 Bad Request
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE open_accounts SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
