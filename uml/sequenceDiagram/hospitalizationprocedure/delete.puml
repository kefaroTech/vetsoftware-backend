@startuml hospitalization_procedure_delete
title DELETE /hospitalization-procedures/{id} — Soft-delete HospitalizationProcedure

actor Client
participant "HospitalizationProcedureController" as Controller
participant "DeleteHospitalizationProcedureUseCase\n<<port.in>>" as UseCase
participant "DeleteHospitalizationProcedureService" as Service
participant "HospitalizationProcedureRepository\n<<port.out>>" as Repo
participant "HospitalizationProcedureJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, DB
  @SQLDelete convierte el DELETE en UPDATE enabled=false;
  @SQLRestriction oculta las filas con enabled=false.
end note

Client -> Controller : DELETE /hospitalization-procedures/{id}
activate Controller
Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationProcedure.delete OR SYSTEM
end note
UseCase -> Service : execute(id)  [@Transactional]
activate Service
Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT WHERE enabled=true
DB --> JpaRepo : row | empty
alt no existe
  Service --> GEH : HospitalizationProcedureNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : HospitalizationProcedure
Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE hospitalization_procedures SET enabled=false WHERE id=?
DB --> JpaRepo : ok
Service --> UseCase : void
UseCase --> Controller : void
Controller --> Client : 204 No Content
deactivate Controller
deactivate Service

@enduml
