@startuml laboratory_test_type_list
title GET /laboratory-test-types — List all LaboratoryTestTypes

actor Client
participant "LaboratoryTestTypeController" as Controller
participant "ListLaboratoryTestTypesUseCase\n<<port.in>>" as UseCase
participant "ListLaboratoryTestTypesService" as Service
participant "LaboratoryTestTypeRepository\n<<port.out>>" as Repo
participant "LaboratoryTestTypeJpaMapper" as Mapper
participant "LaboratoryTestTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /laboratory-test-types
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT laboratory_test_type\nJOIN FETCH company\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<LaboratoryTestTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<LaboratoryTestType>
Repo --> Service : List<LaboratoryTestType>
deactivate Repo

Service -> Service : stream().map(LaboratoryTestTypeDto::from).toList()
Service --> UseCase : List<LaboratoryTestTypeDto>
UseCase --> Controller : List<LaboratoryTestTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<LaboratoryTestTypeResponse>
deactivate Controller

@enduml
