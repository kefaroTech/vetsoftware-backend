@startuml laboratory_test_type_list_available
title GET /laboratory-test-types/available — List LaboratoryTestTypes available for current company

actor Client
participant "LaboratoryTestTypeController" as Controller
participant "Authz" as Authz
participant "ListAvailableLaboratoryTestTypesUseCase\n<<port.in>>" as UseCase
participant "ListAvailableLaboratoryTestTypesService" as Service
participant "LaboratoryTestTypeRepository\n<<port.out>>" as Repo
participant "LaboratoryTestTypeJpaMapper" as Mapper
participant "LaboratoryTestTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /laboratory-test-types/available
activate Controller

Controller -> Authz : currentCompanyId()
Authz --> Controller : companyId

Controller -> UseCase : listAvailable(companyId)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  authz.isMyCompany(#companyId)
end note
UseCase -> Service : listAvailable(companyId)
activate Service

Service -> Repo : findAllAvailableForCompany(companyId)
activate Repo
Repo -> JpaRepo : findAllByGeneralTrueOrCompany_Id(companyId)
JpaRepo -> DB : SELECT laboratory_test_type\nWHERE general=true OR company_id=?\nJOIN FETCH company
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<LaboratoryTestTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<LaboratoryTestType>
Repo --> Service : List<LaboratoryTestType>
deactivate Repo

Service -> Service : stream().map(LaboratoryTestTypeDto::from).toList()
Service --> UseCase : List<LaboratoryTestTypeDto>
UseCase --> Controller : List<LaboratoryTestTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<LaboratoryTestTypeResponse>
deactivate Controller

@enduml
