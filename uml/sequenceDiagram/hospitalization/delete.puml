@startuml hospitalization_delete
title DELETE /hospitalizations/{id} — Delete Hospitalization

actor Client
participant "HospitalizationController" as Controller
participant "DeleteHospitalizationUseCase\n<<port.in>>" as UseCase
participant "DeleteHospitalizationService" as Service
participant "HospitalizationRepository\n<<port.out>>" as Repo
participant "HospitalizationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /hospitalizations/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  hospitalization.delete OR
  hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT hospitalization
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<HospitalizationJpaEntity>
alt hospitalization no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : HospitalizationNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Hospitalization>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE hospitalization SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
