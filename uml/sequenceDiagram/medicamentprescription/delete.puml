@startuml medicament_prescription_delete
title DELETE /medicament-prescriptions/{id} — Delete MedicamentPrescription

actor Client
participant "MedicamentPrescriptionController" as Controller
participant "DeleteMedicamentPrescriptionUseCase\n<<port.in>>" as UseCase
participant "DeleteMedicamentPrescriptionService" as Service
participant "MedicamentPrescriptionRepository\n<<port.out>>" as Repo
participant "MedicamentPrescriptionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /medicament-prescriptions/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT medicament_prescription
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<MedicamentPrescriptionJpaEntity>
alt medicament no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : MedicamentPrescriptionNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<MedicamentPrescription>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE medicament_prescription
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
