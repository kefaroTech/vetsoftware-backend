@startuml medicament_prescription_find
title GET /medicament-prescriptions/{id} — Find MedicamentPrescription by ID

actor Client
participant "MedicamentPrescriptionController" as Controller
participant "FindMedicamentPrescriptionUseCase\n<<port.in>>" as UseCase
participant "FindMedicamentPrescriptionService" as Service
participant "MedicamentPrescriptionRepository\n<<port.out>>" as Repo
participant "MedicamentPrescriptionJpaMapper" as Mapper
participant "MedicamentPrescriptionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /medicament-prescriptions/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT medicament_prescription\nJOIN FETCH (prescription)\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<MedicamentPrescriptionJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : MedicamentPrescription
  Repo --> Service : Optional<MedicamentPrescription>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : MedicamentPrescriptionNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : MedicamentPrescriptionDto.from(medicament)
Service --> UseCase : MedicamentPrescriptionDto
UseCase --> Controller : MedicamentPrescriptionDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nMedicamentPrescriptionResponse
deactivate Controller

@enduml
