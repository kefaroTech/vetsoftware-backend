@startuml procedure_schedule_apply
title PATCH /procedure-schedules/{id}/apply — Apply Procedure Execution

actor Client
participant "ProcedureScheduleController" as Controller
participant "ApplyProcedureScheduleUseCase\n<<port.in>>" as UseCase
participant "ApplyProcedureScheduleService" as Service
participant "ProcedureScheduleRepository\n<<port.out>>" as Repo
participant "HospitalizationProcedureQueryPort\n<<port.out>>" as ProcQP
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PATCH /procedure-schedules/{id}/apply
activate Controller
Controller -> UseCase : execute(ApplyProcedureScheduleCommand{id})
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalization.update OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(id)
Repo --> Service : Optional<ProcedureSchedule>
alt no encontrada
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end

Service -> Repo : findByHospitalizationProcedureId(procId)
Repo --> Service : List<ProcedureSchedule> (plan ordenado por currentDateTime)
Service -> Service : target.apply(now)  // appliedStatus=APPLIED, realDateTime=now
Service -> Repo : save(target)
Repo -> DB : UPDATE procedure_schedules

Service -> ProcQP : findById(procId)
ProcQP --> Service : ProcedureOrderParams (guidelineType, frequency)
alt guidelineType == INTERVAL
  loop ejecuciones PENDIENTES posteriores
    Service -> Service : cursor += intervalo;  slot.reschedule(cursor)
    Service -> Repo : save(slot)
    Repo -> DB : UPDATE procedure_schedules
  end
end

Service --> UseCase : List<ProcedureScheduleDto>
UseCase --> Controller : List<ProcedureScheduleDto>
Controller --> Client : 200 OK\nList<ProcedureScheduleResponse> (plan completo del procedimiento)
deactivate Service
deactivate Controller

@enduml
