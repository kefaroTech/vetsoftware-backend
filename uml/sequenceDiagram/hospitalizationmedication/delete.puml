@startuml hospitalization_medication_delete
title DELETE /hospitalization-medications/{id} — Soft-delete HospitalizationMedication

actor Client
participant "HospitalizationMedicationController" as Controller
participant "DeleteHospitalizationMedicationUseCase\n<<port.in>>" as UseCase
participant "DeleteHospitalizationMedicationService" as Service
participant "HospitalizationMedicationRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, DB
  @SQLDelete convierte el DELETE en UPDATE enabled=false;
  @SQLRestriction oculta las filas con enabled=false.
end note

Client -> Controller : DELETE /hospitalization-medications/{id}
activate Controller
Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationMedication.delete OR SYSTEM
end note
UseCase -> Service : execute(id)  [@Transactional]
activate Service
Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT WHERE enabled=true
DB --> JpaRepo : row | empty
alt no existe
  Service --> GEH : HospitalizationMedicationNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : HospitalizationMedication
Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE hospitalization_medications SET enabled=false WHERE id=?
DB --> JpaRepo : ok
Service --> UseCase : void
UseCase --> Controller : void
Controller --> Client : 204 No Content
deactivate Controller
deactivate Service

@enduml
