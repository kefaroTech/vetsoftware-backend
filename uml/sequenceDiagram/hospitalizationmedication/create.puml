@startuml hospitalization_medication_create
title POST /hospitalization-medications — Create HospitalizationMedication

actor Client
participant "HospitalizationMedicationController" as Controller
participant "Authz" as Authz
participant "CreateHospitalizationMedicationUseCase\n<<port.in>>" as UseCase
participant "CreateHospitalizationMedicationService" as Service
participant "HospitalizationQueryPort\n<<port.out>>" as HospQP
participant "EmployeeQueryPort\n<<port.out>>" as EmpQP
participant "HospitalizationMedicationRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationJpaMapper" as Mapper
participant "HospitalizationMedicationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
  @SQLRestriction filtra enabled=true en todo SELECT.
end note

Client -> Controller : POST /hospitalization-medications\n+ CreateHospitalizationMedicationRequest
activate Controller
Controller -> Authz : currentEmployeeId()
Authz --> Controller : employeeId (del EmployeeContext)
Controller -> UseCase : execute(CreateHospitalizationMedicationCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationMedication.create OR SYSTEM
end note
UseCase -> Service : execute(command)
activate Service

Service -> HospQP : findById(hospitalizationId)
HospQP --> Service : Optional<HospitalizationRef>
alt hospitalization no encontrada (o no enabled)
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end
Service -> EmpQP : findById(createdById)
EmpQP --> Service : Optional<EmployeeRef>

Service -> Service : HospitalizationMedication.create(name, dose, frequency, ...,\nhospitalization, createdBy)\n(invariantes de dominio)
Service -> Repo : save(medication)
activate Repo
Repo -> JpaRepo : getReferenceById(hospitalization, createdBy)\n(proxies sin SELECT)
JpaRepo --> Repo : proxies
Repo -> Mapper : toJpa(medication, hospitalization, createdBy)
Mapper --> Repo : HospitalizationMedicationJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : INSERT hospitalization_medications
DB --> JpaRepo : id generado
JpaRepo --> Repo : entity (con id)
Repo -> Mapper : toDomain(entity, refs precargados)
Mapper --> Repo : HospitalizationMedication
Repo --> Service : HospitalizationMedication
deactivate Repo

Service -> Service : HospitalizationMedicationDto.from(...)
Service --> UseCase : HospitalizationMedicationDto
UseCase --> Controller : HospitalizationMedicationDto
Controller -> Controller : toResponse(dto)
Controller --> Client : 201 Created\nHospitalizationMedicationResponse
deactivate Controller
deactivate Service

@enduml
