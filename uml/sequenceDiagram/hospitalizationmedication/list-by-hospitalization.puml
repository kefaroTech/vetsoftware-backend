@startuml hospitalization_medication_list_by_hospitalization
title GET /hospitalization-medications/by-hospitalization/{hospitalizationId}

actor Client
participant "HospitalizationMedicationController" as Controller
participant "ListHospitalizationMedicationsByHospitalizationUseCase\n<<port.in>>" as UseCase
participant "ListHospitalizationMedicationsByHospitalizationService" as Service
participant "HospitalizationMedicationRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationJpaMapper" as Mapper
participant "HospitalizationMedicationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

Client -> Controller : GET /hospitalization-medications/by-hospitalization/{hospitalizationId}
activate Controller
Controller -> UseCase : listByHospitalization(hospitalizationId)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationMedication.read OR SYSTEM
end note
UseCase -> Service : listByHospitalization(hospitalizationId)
activate Service
Service -> Repo : findAllByHospitalizationId(hospitalizationId)
Repo -> JpaRepo : findByHospitalizationId(hospitalizationId)
JpaRepo -> DB : SELECT (JOIN FETCH refs) WHERE hospitalization_id=? AND enabled=true
DB --> JpaRepo : rows
JpaRepo --> Repo : List<entity>
Repo -> Mapper : toDomain(entity) (por fila)
Mapper --> Repo : List<HospitalizationMedication>
Repo --> Service : List<HospitalizationMedication>
Service -> Service : map HospitalizationMedicationDto.from(...)
Service --> UseCase : List<HospitalizationMedicationDto>
UseCase --> Controller : List<HospitalizationMedicationDto>
Controller --> Client : 200 OK\nList<HospitalizationMedicationResponse>
deactivate Controller
deactivate Service

@enduml
