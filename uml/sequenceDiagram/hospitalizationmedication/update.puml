@startuml hospitalization_medication_update
title PUT /hospitalization-medications/{id} — Update HospitalizationMedication

actor Client
participant "HospitalizationMedicationController" as Controller
participant "UpdateHospitalizationMedicationUseCase\n<<port.in>>" as UseCase
participant "UpdateHospitalizationMedicationService" as Service
participant "HospitalizationMedicationRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PUT /hospitalization-medications/{id}\n+ UpdateHospitalizationMedicationRequest
activate Controller
Controller -> UseCase : execute(UpdateHospitalizationMedicationCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationMedication.update OR SYSTEM
end note
UseCase -> Service : execute(command)  [@Transactional]
activate Service
Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT WHERE enabled=true
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<entity>
alt no existe
  Service --> GEH : HospitalizationMedicationNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : HospitalizationMedication
Service -> Service : medication.update(name, dose, frequency, ...)\n(createdBy y hospitalization no se modifican)
Service -> Repo : save(medication)
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE hospitalization_medications
DB --> JpaRepo : ok
JpaRepo --> Repo : entity
Repo --> Service : HospitalizationMedication
Service -> Service : HospitalizationMedicationDto.from(...)
Service --> UseCase : HospitalizationMedicationDto
UseCase --> Controller : HospitalizationMedicationDto
Controller --> Client : 200 OK\nHospitalizationMedicationResponse
deactivate Controller
deactivate Service

@enduml
