@startuml hospitalization_medication_enable
title PATCH /hospitalization-medications/{id}/enable — Reactivate HospitalizationMedication

actor Client
participant "HospitalizationMedicationController" as Controller
participant "ReactivateHospitalizationMedicationUseCase\n<<port.in>>" as UseCase
participant "ReactivateHospitalizationMedicationService" as Service
participant "HospitalizationMedicationRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PATCH /hospitalization-medications/{id}/enable
activate Controller
Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationMedication.update OR SYSTEM
end note
UseCase -> Service : execute(id)  [@Transactional]
activate Service
Service -> Repo : reactivate(id)
Repo -> JpaRepo : reactivate(id)
JpaRepo -> DB : UPDATE hospitalization_medications SET enabled=true WHERE id=:id (nativeQuery)
DB --> JpaRepo : filas afectadas
JpaRepo --> Repo : int
alt 0 filas (no existe)
  Service --> GEH : HospitalizationMedicationNotFoundException
  GEH --> Client : 404 Not Found
end
Service -> Repo : findById(id)
Repo --> Service : HospitalizationMedication
Service -> Service : HospitalizationMedicationDto.from(...)
Service --> UseCase : HospitalizationMedicationDto
UseCase --> Controller : HospitalizationMedicationDto
Controller --> Client : 200 OK\nHospitalizationMedicationResponse
deactivate Controller
deactivate Service

@enduml
