@startuml state_delete
title DELETE /states/{id} — Delete State

actor Client
participant "StateController" as Controller
participant "DeleteStateUseCase\n<<port.in>>" as UseCase
participant "DeleteStateService" as Service
participant "StateRepository\n<<port.out>>" as Repo
participant "StateJpaRepository\n<<spring-data>>" as JpaRepo
participant "CityChildrenQueryPort\n<<port.out>>" as ChildrenPort
participant "CityJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso el principal
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /states/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT state (JOIN FETCH country)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<StateJpaEntity>
alt state no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : StateNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<State>

Service -> ChildrenPort : existsActiveByStateId(id)
ChildrenPort -> ChildJpaRepo : existsByState_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE state_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenPort : boolean
ChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : StateHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE state SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
