@startuml employee_update
title PUT /employees/{id} — Update Employee

actor Client
participant "EmployeeController" as Controller
participant "UpdateEmployeeUseCase\n<<port.in>>" as UseCase
participant "UpdateEmployeeService" as Service
participant "EmployeeRepository\n<<port.out>>" as Repo
participant "EmployeeJpaMapper" as Mapper
participant "EmployeeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : PUT /employees/{id}\n+ UpdateEmployeeRequest
activate Controller

Controller -> UseCase : execute(UpdateEmployeeCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR employee.update OR SYSTEM
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT employee (JOIN FETCH company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<EmployeeJpaEntity>
alt employee no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : EmployeeNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : Employee
Repo --> Service : Optional<Employee>

Service -> Service : EmployeeStatus.valueOf(...)
Service -> Service : employee.update(...)\n(invariantes de dominio)

Service -> Repo : save(employee)
Repo -> JpaRepo : getReferenceById(companyId)\n(proxy sin SELECT)
JpaRepo --> Repo : proxy
Repo -> Mapper : toJpa(employee, company)
Mapper --> Repo : EmployeeJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE employee
DB --> JpaRepo : ok
JpaRepo --> Repo : EmployeeJpaEntity
Repo -> Mapper : toDomain(entity, company precargado)
Mapper --> Repo : Employee
Repo --> Service : Employee

Service -> Service : EmployeeDto.from(employee)
Service --> UseCase : EmployeeDto
UseCase --> Controller : EmployeeDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nEmployeeResponse
deactivate Controller

@enduml
