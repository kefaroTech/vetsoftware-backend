@startuml baserole_delete
title DELETE /base-roles/{id} — Delete BaseRole

actor Client
participant "BaseRoleController" as Controller
participant "DeleteBaseRoleUseCase\n<<port.in>>" as UseCase
participant "DeleteBaseRoleService" as Service
participant "BaseRoleRepository\n<<port.out>>" as Repo
participant "BaseRoleJpaRepository\n<<spring-data>>" as JpaRepo
participant "BaseRolePermissionChildrenQueryPort\n<<port.out>>" as ChildrenPort
participant "BaseRolePermissionJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext / SystemContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /base-roles/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  hasAuthority('admin.all') OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT base_role
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<BaseRoleJpaEntity>
alt no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : BaseRoleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<BaseRole>

Service -> ChildrenPort : existsActiveByBaseRoleId(id)
ChildrenPort -> ChildJpaRepo : existsByBaseRole_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE base_role_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenPort : boolean
ChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : BaseRoleHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE base_role SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
