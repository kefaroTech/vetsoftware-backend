@startuml consultationtype_list
title GET /consultation-types — List all ConsultationTypes

actor Client
participant "ConsultationTypeController" as Controller
participant "ListConsultationTypesUseCase\n<<port.in>>" as UseCase
participant "ListConsultationTypesService" as Service
participant "ConsultationTypeRepository\n<<port.out>>" as Repo
participant "ConsultationTypeJpaMapper" as Mapper
participant "ConsultationTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /consultation-types
activate Controller

Controller -> UseCase : listAll()
note right of UseCase: (sin @PreAuthorize — accesible a cualquier autenticado)
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT consultation_type
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<ConsultationTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<ConsultationType>
Repo --> Service : List<ConsultationType>
deactivate Repo

Service -> Service : stream().map(ConsultationTypeDto::from).toList()
Service --> UseCase : List<ConsultationTypeDto>
UseCase --> Controller : List<ConsultationTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<ConsultationTypeResponse>
deactivate Controller

@enduml
