@startuml owner_delete
title DELETE /owners/{id} — Delete Owner

actor Client
participant "OwnerController" as Controller
participant "DeleteOwnerUseCase\n<<port.in>>" as UseCase
participant "DeleteOwnerService" as Service
participant "OwnerRepository\n<<port.out>>" as Repo
participant "OwnerJpaRepository\n<<spring-data>>" as JpaRepo
participant "AnimalChildrenQueryPort\n<<port.out>>" as AnimalCP
participant "AnimalJpaRepository\n<<spring-data>>" as AnimalJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /owners/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR owner.delete
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT owner (JOIN FETCH city, company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<OwnerJpaEntity>
alt owner no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : OwnerNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Owner>

Service -> AnimalCP : existsActiveByOwnerId(id)
AnimalCP -> AnimalJpaRepo : existsByOwner_Id(id)
AnimalJpaRepo -> DB : SELECT EXISTS(...) WHERE owner_id=? AND enabled=true
DB --> AnimalJpaRepo : true/false
AnimalJpaRepo --> AnimalCP : boolean
AnimalCP --> Service : boolean
alt hay animales activos
  Service --> GEH : OwnerHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE owner SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
