@startuml vaccination_list_by_animal
title GET /vaccinations/by-animal/{animalId} — List Vaccinations of an Animal

actor Client
participant "VaccinationController" as Controller
participant "ListVaccinationsByAnimalUseCase\n<<port.in>>" as UseCase
participant "ListVaccinationsByAnimalService" as Service
participant "VaccinationRepository\n<<port.out>>" as Repo
participant "VaccinationJpaMapper" as Mapper
participant "VaccinationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /vaccinations/by-animal/{animalId}
activate Controller

Controller -> UseCase : listByAnimal(animalId)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  vaccination.read OR
  hasRole('SYSTEM')
end note
UseCase -> Service : listByAnimal(animalId)
activate Service

Service -> Repo : findAllByAnimalId(animalId)
activate Repo
Repo -> JpaRepo : findAllByAnimalId(animalId)
JpaRepo -> DB : SELECT vaccination\nWHERE animal_id=?\nJOIN FETCH (vaccinationType, animal, consultation, company)
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<VaccinationJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Vaccination>
Repo --> Service : List<Vaccination>
deactivate Repo

Service -> Service : stream().map(VaccinationDto::from).toList()
Service --> UseCase : List<VaccinationDto>
UseCase --> Controller : List<VaccinationDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<VaccinationResponse>
deactivate Controller

@enduml
