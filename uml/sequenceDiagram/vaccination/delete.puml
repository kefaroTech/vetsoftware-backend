@startuml vaccination_delete
title DELETE /vaccinations/{id} — Delete Vaccination

actor Client
participant "VaccinationController" as Controller
participant "DeleteVaccinationUseCase\n<<port.in>>" as UseCase
participant "DeleteVaccinationService" as Service
participant "VaccinationRepository\n<<port.out>>" as Repo
participant "VaccinationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /vaccinations/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  vaccination.delete OR
  hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT vaccination
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<VaccinationJpaEntity>
alt vaccination no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : VaccinationNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Vaccination>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE vaccination SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
