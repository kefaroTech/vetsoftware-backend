@startuml vaccination_find
title GET /vaccinations/{id} — Find Vaccination by ID

actor Client
participant "VaccinationController" as Controller
participant "FindVaccinationUseCase\n<<port.in>>" as UseCase
participant "FindVaccinationService" as Service
participant "VaccinationRepository\n<<port.out>>" as Repo
participant "VaccinationJpaMapper" as Mapper
participant "VaccinationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /vaccinations/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  vaccination.read OR
  hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT vaccination\nJOIN FETCH (vaccinationType, animal, consultation, company)\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<VaccinationJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Vaccination
  Repo --> Service : Optional<Vaccination>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : VaccinationNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : VaccinationDto.from(vaccination)
Service --> UseCase : VaccinationDto
UseCase --> Controller : VaccinationDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nVaccinationResponse
deactivate Controller

@enduml
