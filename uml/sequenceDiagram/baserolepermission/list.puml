@startuml baserolepermission_list
title GET /base-role-permissions — List all BaseRolePermissions

actor Client
participant "BaseRolePermissionController" as Controller
participant "ListBaseRolePermissionsUseCase\n<<port.in>>" as UseCase
participant "ListBaseRolePermissionsService" as Service
participant "BaseRolePermissionRepository\n<<port.out>>" as Repo
participant "BaseRolePermissionJpaMapper" as Mapper
participant "BaseRolePermissionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext / SystemContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /base-role-permissions
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  hasAuthority('admin.all') OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT base_role_permission\nJOIN FETCH (baseRole, basePermission)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<BaseRolePermissionJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<BaseRolePermission>
Repo --> Service : List<BaseRolePermission>
deactivate Repo

Service -> Service : stream().map(BaseRolePermissionDto::from).toList()
Service --> UseCase : List<BaseRolePermissionDto>
UseCase --> Controller : List<BaseRolePermissionDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<BaseRolePermissionResponse>
deactivate Controller

@enduml
