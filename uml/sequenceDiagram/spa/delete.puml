@startuml spa_delete
title DELETE /spas/{id} — Delete Spa

actor Client
participant "SpaController" as Controller
participant "DeleteSpaUseCase\n<<port.in>>" as UseCase
participant "DeleteSpaService" as Service
participant "SpaRepository\n<<port.out>>" as Repo
participant "SpaJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /spas/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT spa
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SpaJpaEntity>
alt spa no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SpaNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Spa>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE spa SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
