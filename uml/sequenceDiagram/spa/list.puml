@startuml spa_list
title GET /spas — List all Spas

actor Client
participant "SpaController" as Controller
participant "ListSpasUseCase\n<<port.in>>" as UseCase
participant "ListSpasService" as Service
participant "SpaRepository\n<<port.out>>" as Repo
participant "SpaJpaMapper" as Mapper
participant "SpaJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /spas
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT spa\nJOIN FETCH (spaType, animal, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<SpaJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Spa>
Repo --> Service : List<Spa>
deactivate Repo

Service -> Service : stream().map(SpaDto::from).toList()
Service --> UseCase : List<SpaDto>
UseCase --> Controller : List<SpaDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<SpaResponse>
deactivate Controller

@enduml
