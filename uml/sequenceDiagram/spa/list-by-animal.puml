@startuml spa_list_by_animal
title GET /spas/by-animal/{animalId} — List Spas of an Animal

actor Client
participant "SpaController" as Controller
participant "ListSpasByAnimalUseCase\n<<port.in>>" as UseCase
participant "ListSpasByAnimalService" as Service
participant "SpaRepository\n<<port.out>>" as Repo
participant "SpaJpaMapper" as Mapper
participant "SpaJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /spas/by-animal/{animalId}
activate Controller

Controller -> UseCase : listByAnimal(animalId)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listByAnimal(animalId)
activate Service

Service -> Repo : findAllByAnimalId(animalId)
activate Repo
Repo -> JpaRepo : findAllByAnimalId(animalId)
JpaRepo -> DB : SELECT spa\nWHERE animal_id=?\nJOIN FETCH (spaType, animal, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<SpaJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Spa>
Repo --> Service : List<Spa>
deactivate Repo

Service -> Service : stream().map(SpaDto::from).toList()
Service --> UseCase : List<SpaDto>
UseCase --> Controller : List<SpaDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<SpaResponse>
deactivate Controller

@enduml
