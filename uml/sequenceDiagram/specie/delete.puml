@startuml specie_delete
title DELETE /species/{id} — Delete Specie

actor Client
participant "SpecieController" as Controller
participant "DeleteSpecieUseCase\n<<port.in>>" as UseCase
participant "DeleteSpecieService" as Service
participant "SpecieRepository\n<<port.out>>" as Repo
participant "SpecieJpaRepository\n<<spring-data>>" as JpaRepo
participant "BreedChildrenQueryPort\n<<port.out>>" as BreedCP
participant "BreedJpaRepository\n<<spring-data>>" as BreedJpaRepo
participant "AnimalChildrenQueryPort\n<<port.out>>" as AnimalCP
participant "AnimalJpaRepository\n<<spring-data>>" as AnimalJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /species/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT specie
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SpecieJpaEntity>
alt specie no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SpecieNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Specie>

Service -> BreedCP : existsActiveBySpecieId(id)
BreedCP -> BreedJpaRepo : existsBySpecie_Id(id)
BreedJpaRepo -> DB : SELECT EXISTS(...) WHERE specie_id=? AND enabled=true
DB --> BreedJpaRepo : true/false
BreedJpaRepo --> BreedCP : boolean
BreedCP --> Service : boolean
alt hay breeds activos
  Service --> GEH : SpecieHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> AnimalCP : existsActiveBySpecieId(id)
AnimalCP -> AnimalJpaRepo : existsBySpecie_Id(id)
AnimalJpaRepo -> DB : SELECT EXISTS(...) WHERE specie_id=? AND enabled=true
DB --> AnimalJpaRepo : true/false
AnimalJpaRepo --> AnimalCP : boolean
AnimalCP --> Service : boolean
alt hay animales activos
  Service --> GEH : SpecieHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE specie SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
