@startuml specie_list
title GET /species — List all Species

actor Client
participant "SpecieController" as Controller
participant "ListSpeciesUseCase\n<<port.in>>" as UseCase
participant "ListSpeciesService" as Service
participant "SpecieRepository\n<<port.out>>" as Repo
participant "SpecieJpaMapper" as Mapper
participant "SpecieJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /species
activate Controller

Controller -> UseCase : listAll()
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT specie
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<SpecieJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Specie>
Repo --> Service : List<Specie>
deactivate Repo

Service -> Service : stream().map(SpecieDto::from).toList()
Service --> UseCase : List<SpecieDto>
UseCase --> Controller : List<SpecieDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<SpecieResponse>
deactivate Controller

@enduml
