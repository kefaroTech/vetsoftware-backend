@startuml diagnostic_imaging_type_list
title GET /diagnostic-imaging-types — List all DiagnosticImagingTypes

actor Client
participant "DiagnosticImagingTypeController" as Controller
participant "ListDiagnosticImagingTypesUseCase\n<<port.in>>" as UseCase
participant "ListDiagnosticImagingTypesService" as Service
participant "DiagnosticImagingTypeRepository\n<<port.out>>" as Repo
participant "DiagnosticImagingTypeJpaMapper" as Mapper
participant "DiagnosticImagingTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /diagnostic-imaging-types
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT diagnostic_imaging_type\nJOIN FETCH company\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<DiagnosticImagingTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<DiagnosticImagingType>
Repo --> Service : List<DiagnosticImagingType>
deactivate Repo

Service -> Service : stream().map(DiagnosticImagingTypeDto::from).toList()
Service --> UseCase : List<DiagnosticImagingTypeDto>
UseCase --> Controller : List<DiagnosticImagingTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<DiagnosticImagingTypeResponse>
deactivate Controller

@enduml
