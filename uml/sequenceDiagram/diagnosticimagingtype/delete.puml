@startuml diagnostic_imaging_type_delete
title DELETE /diagnostic-imaging-types/{id} — Delete DiagnosticImagingType

actor Client
participant "DiagnosticImagingTypeController" as Controller
participant "DeleteDiagnosticImagingTypeUseCase\n<<port.in>>" as UseCase
participant "DeleteDiagnosticImagingTypeService" as Service
participant "DiagnosticImagingTypeRepository\n<<port.out>>" as Repo
participant "DiagnosticImagingTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /diagnostic-imaging-types/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT diagnostic_imaging_type (JOIN FETCH company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<DiagnosticImagingTypeJpaEntity>
alt type no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : DiagnosticImagingTypeNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<DiagnosticImagingType>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE diagnostic_imaging_type
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
