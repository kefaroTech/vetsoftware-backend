@startuml submodule_delete
title DELETE /sub-modules/{id} — Delete SubModule

actor Client
participant "SubModuleController" as Controller
participant "DeleteSubModuleUseCase\n<<port.in>>" as UseCase
participant "DeleteSubModuleService" as Service
participant "SubModuleRepository\n<<port.out>>" as Repo
participant "SubModuleJpaRepository\n<<spring-data>>" as JpaRepo
participant "MembershipSubModuleChildrenQueryPort\n<<port.out>>" as ChildrenPort
participant "MembershipSubModuleJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /sub-modules/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT sub_module (JOIN FETCH module)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SubModuleJpaEntity>
alt subModule no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SubModuleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<SubModule>

Service -> ChildrenPort : existsActiveBySubModuleId(id)
ChildrenPort -> ChildJpaRepo : existsBySubModule_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE sub_module_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenPort : boolean
ChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : SubModuleHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE sub_module SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
