@startuml daycare_list_by_animal
title GET /daycares/by-animal/{animalId} — List DayCares of an Animal

actor Client
participant "DayCareController" as Controller
participant "ListDayCaresByAnimalUseCase\n<<port.in>>" as UseCase
participant "ListDayCaresByAnimalService" as Service
participant "DayCareRepository\n<<port.out>>" as Repo
participant "DayCareJpaMapper" as Mapper
participant "DayCareJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /daycares/by-animal/{animalId}
activate Controller

Controller -> UseCase : listByAnimal(animalId)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  dayCare.read OR
  hasRole('SYSTEM')
end note
UseCase -> Service : listByAnimal(animalId)
activate Service

Service -> Repo : findAllByAnimalId(animalId)
activate Repo
Repo -> JpaRepo : findAllByAnimalId(animalId)
JpaRepo -> DB : SELECT daycare\nWHERE animal_id=?\nJOIN FETCH (animal, company)
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<DayCareJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<DayCare>
Repo --> Service : List<DayCare>
deactivate Repo

Service -> Service : stream().map(DayCareDto::from).toList()
Service --> UseCase : List<DayCareDto>
UseCase --> Controller : List<DayCareDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<DayCareResponse>
deactivate Controller

@enduml
