@startuml daycare_delete
title DELETE /daycares/{id} — Delete DayCare

actor Client
participant "DayCareController" as Controller
participant "DeleteDayCareUseCase\n<<port.in>>" as UseCase
participant "DeleteDayCareService" as Service
participant "DayCareRepository\n<<port.out>>" as Repo
participant "DayCareJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /daycares/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  dayCare.delete OR
  hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT daycare
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<DayCareJpaEntity>
alt daycare no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : DayCareNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<DayCare>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE daycare SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
