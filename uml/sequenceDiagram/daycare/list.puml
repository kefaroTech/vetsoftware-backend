@startuml daycare_list
title GET /daycares — List all DayCares

actor Client
participant "DayCareController" as Controller
participant "ListDayCaresUseCase\n<<port.in>>" as UseCase
participant "ListDayCaresService" as Service
participant "DayCareRepository\n<<port.out>>" as Repo
participant "DayCareJpaMapper" as Mapper
participant "DayCareJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /daycares
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR
  dayCare.read OR
  hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT daycare\nJOIN FETCH (animal, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<DayCareJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<DayCare>
Repo --> Service : List<DayCare>
deactivate Repo

Service -> Service : stream().map(DayCareDto::from).toList()
Service --> UseCase : List<DayCareDto>
UseCase --> Controller : List<DayCareDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<DayCareResponse>
deactivate Controller

@enduml
