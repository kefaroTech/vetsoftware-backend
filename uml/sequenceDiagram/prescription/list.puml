@startuml prescription_list
title GET /prescriptions — List all Prescriptions

actor Client
participant "PrescriptionController" as Controller
participant "ListPrescriptionsUseCase\n<<port.in>>" as UseCase
participant "ListPrescriptionsService" as Service
participant "PrescriptionRepository\n<<port.out>>" as Repo
participant "PrescriptionJpaMapper" as Mapper
participant "PrescriptionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /prescriptions
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT prescription\nJOIN FETCH (animal, consultation, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<PrescriptionJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Prescription>
Repo --> Service : List<Prescription>
deactivate Repo

Service -> Service : stream().map(PrescriptionDto::from).toList()
Service --> UseCase : List<PrescriptionDto>
UseCase --> Controller : List<PrescriptionDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<PrescriptionResponse>
deactivate Controller

@enduml
