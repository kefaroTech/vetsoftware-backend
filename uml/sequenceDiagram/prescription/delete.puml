@startuml prescription_delete
title DELETE /prescriptions/{id} — Delete Prescription

actor Client
participant "PrescriptionController" as Controller
participant "DeletePrescriptionUseCase\n<<port.in>>" as UseCase
participant "DeletePrescriptionService" as Service
participant "PrescriptionRepository\n<<port.out>>" as Repo
participant "PrescriptionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /prescriptions/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT prescription
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<PrescriptionJpaEntity>
alt prescription no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : PrescriptionNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Prescription>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE prescription
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
