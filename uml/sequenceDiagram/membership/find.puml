@startuml membership_find
title GET /memberships/{id} — Find Membership by ID

actor Client
participant "MembershipController" as Controller
participant "FindMembershipUseCase\n<<port.in>>" as UseCase
participant "FindMembershipService" as Service
participant "MembershipRepository\n<<port.out>>" as Repo
participant "MembershipJpaMapper" as Mapper
participant "MembershipJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /memberships/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT membership
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<MembershipJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Membership
  Repo --> Service : Optional<Membership>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : MembershipNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : MembershipDto.from(membership)
Service --> UseCase : MembershipDto
UseCase --> Controller : MembershipDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nMembershipResponse
deactivate Controller

@enduml
