@startuml deworming_list
title GET /dewormings — List all Dewormings

actor Client
participant "DewormingController" as Controller
participant "ListDewormingsUseCase\n<<port.in>>" as UseCase
participant "ListDewormingsService" as Service
participant "DewormingRepository\n<<port.out>>" as Repo
participant "DewormingJpaMapper" as Mapper
participant "DewormingJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /dewormings
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR deworming.read OR SYSTEM
end note

UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT deworming\nJOIN FETCH (animal, consultation, company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<DewormingJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Deworming>
Repo --> Service : List<Deworming>
deactivate Repo

Service -> Service : stream().map(DewormingDto::from).toList()
Service --> UseCase : List<DewormingDto>
UseCase --> Controller : List<DewormingDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<DewormingResponse>
deactivate Controller

@enduml
