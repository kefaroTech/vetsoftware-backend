@startuml consultation_delete
title DELETE /consultations/{id} — Delete Consultation

actor Client
participant "ConsultationController" as Controller
participant "DeleteConsultationUseCase\n<<port.in>>" as UseCase
participant "DeleteConsultationService" as Service
participant "ConsultationRepository\n<<port.out>>" as Repo
participant "ConsultationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /consultations/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note

UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT consultation (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ConsultationJpaEntity>
alt consultation no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ConsultationNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Consultation>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE consultation
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
