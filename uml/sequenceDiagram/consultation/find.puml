@startuml consultation_find
title GET /consultations/{id} — Find Consultation by ID

actor Client
participant "ConsultationController" as Controller
participant "FindConsultationUseCase\n<<port.in>>" as UseCase
participant "FindConsultationService" as Service
participant "ConsultationRepository\n<<port.out>>" as Repo
participant "ConsultationJpaMapper" as Mapper
participant "ConsultationJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /consultations/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR consultation.read OR SYSTEM
end note

UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT consultation\nJOIN FETCH (consultationType, animal, company)\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ConsultationJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Consultation
  Repo --> Service : Optional<Consultation>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ConsultationNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : ConsultationDto.from(consultation)
Service --> UseCase : ConsultationDto
UseCase --> Controller : ConsultationDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nConsultationResponse
deactivate Controller

@enduml
