@startuml systempermission_delete
title DELETE /system-permissions/{id} — Delete SystemPermission

actor Client
participant "SystemPermissionController" as Controller
participant "DeleteSystemPermissionUseCase\n<<port.in>>" as UseCase
participant "DeleteSystemPermissionService" as Service
participant "SystemPermissionRepository\n<<port.out>>" as Repo
participant "SystemPermissionJpaRepository\n<<spring-data>>" as JpaRepo
participant "SystemUserPermissionChildrenQueryPort\n<<port.out>>" as SupChildrenPort
participant "SystemUserPermissionJpaRepository\n<<spring-data>>" as SupJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /system-permissions/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT system_permission
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SystemPermissionJpaEntity>
alt systemPermission no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SystemPermissionNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<SystemPermission>

Service -> SupChildrenPort : existsActiveBySystemPermissionId(id)
SupChildrenPort -> SupJpaRepo : existsBySystemPermission_Id(id)
SupJpaRepo -> DB : SELECT EXISTS(...) WHERE system_permission_id=? AND enabled=true
DB --> SupJpaRepo : true/false
SupJpaRepo --> SupChildrenPort : boolean
SupChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : SystemPermissionHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE system_permission SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
