@startuml systempermission_update
title PUT /system-permissions/{id} — Update SystemPermission

actor Client
participant "SystemPermissionController" as Controller
participant "UpdateSystemPermissionUseCase\n<<port.in>>" as UseCase
participant "UpdateSystemPermissionService" as Service
participant "SystemPermissionRepository\n<<port.out>>" as Repo
participant "SystemPermissionJpaMapper" as Mapper
participant "SystemPermissionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : PUT /system-permissions/{id}\n+ UpdateSystemPermissionRequest
activate Controller

Controller -> UseCase : execute(UpdateSystemPermissionCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT system_permission
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SystemPermissionJpaEntity>
alt systemPermission no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SystemPermissionNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : SystemPermission
Repo --> Service : Optional<SystemPermission>

Service -> Service : systemPermission.update(name, code)\n(invariantes de dominio)

Service -> Repo : save(systemPermission)
Repo -> Mapper : toJpa(systemPermission)
Mapper --> Repo : SystemPermissionJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE system_permission
DB --> JpaRepo : ok
JpaRepo --> Repo : SystemPermissionJpaEntity
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : SystemPermission
Repo --> Service : SystemPermission

Service -> Service : SystemPermissionDto.from(systemPermission)
Service --> UseCase : SystemPermissionDto
UseCase --> Controller : SystemPermissionDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nSystemPermissionResponse
deactivate Controller

@enduml
