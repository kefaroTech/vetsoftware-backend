@startuml product_category_update
title PUT /product-categories/{id} — Update ProductCategory

actor Client
participant "ProductCategoryController" as Controller
participant "Authz" as Authz
participant "UpdateProductCategoryUseCase\n<<port.in>>" as UseCase
participant "UpdateProductCategoryService" as Service
participant "ProductCategoryRepository\n<<port.out>>" as Repo
participant "CompanyQueryPort" as CompanyQP
participant "ProductCategoryJpaMapper" as Mapper
participant "ProductCategoryJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : PUT /product-categories/{id}\n+ UpdateProductCategoryRequest
activate Controller

Controller -> Authz : currentCompanyId()
Authz --> Controller : companyId

Controller -> UseCase : execute(UpdateProductCategoryCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  (productCategory.update AND authz.isMyCompany(#command.companyId))
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT product_category (JOIN FETCH company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ProductCategoryJpaEntity>
alt product_category no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ProductCategoryNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : ProductCategory
Repo --> Service : Optional<ProductCategory>

Service -> CompanyQP : findById(companyId)
CompanyQP --> Service : Optional<CompanyRef>
alt company no encontrada
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end

Service -> Service : productCategory.update(name, description, company)\n(invariantes de dominio)

Service -> Repo : save(productCategory)
Repo -> JpaRepo : getReferenceById(companyId)
JpaRepo --> Repo : proxy (sin SELECT)
Repo -> Mapper : toJpa(productCategory, company)
Mapper --> Repo : ProductCategoryJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE product_category
DB --> JpaRepo : ok
JpaRepo --> Repo : ProductCategoryJpaEntity
Repo -> Mapper : toDomain(entity, ref precargado)
Mapper --> Repo : ProductCategory
Repo --> Service : ProductCategory

Service -> Service : ProductCategoryDto.from(productCategory)
Service --> UseCase : ProductCategoryDto
UseCase --> Controller : ProductCategoryDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nProductCategoryResponse
deactivate Controller

@enduml
