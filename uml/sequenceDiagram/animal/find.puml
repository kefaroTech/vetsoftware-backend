@startuml animal_find
title GET /animals/{id} — Find Animal by ID

actor Client
participant "AnimalController" as Controller
participant "FindAnimalUseCase\n<<port.in>>" as UseCase
participant "FindAnimalService" as Service
participant "AnimalRepository\n<<port.out>>" as Repo
participant "AnimalJpaMapper" as Mapper
participant "AnimalJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /animals/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase: (sin @PreAuthorize de ownership)
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT animal\nJOIN FETCH (specie, breed, owner, company, color)\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<AnimalJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Animal
  Repo --> Service : Optional<Animal>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : AnimalNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : AnimalDto.from(animal)
Service --> UseCase : AnimalDto
UseCase --> Controller : AnimalDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nAnimalResponse
deactivate Controller

@enduml
