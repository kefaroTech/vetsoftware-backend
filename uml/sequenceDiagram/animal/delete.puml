@startuml animal_delete
title DELETE /animals/{id} — Delete Animal

actor Client
participant "AnimalController" as Controller
participant "DeleteAnimalUseCase\n<<port.in>>" as UseCase
participant "DeleteAnimalService" as Service
participant "AnimalRepository\n<<port.out>>" as Repo
participant "AnimalJpaRepository\n<<spring-data>>" as JpaRepo
participant "VaccinationChildrenQueryPort\n<<port.out>>" as VaccCP
participant "VaccinationJpaRepository\n<<spring-data>>" as VaccJpaRepo
participant "DewormingChildrenQueryPort\n<<port.out>>" as DewCP
participant "DewormingJpaRepository\n<<spring-data>>" as DewJpaRepo
participant "SurgeryChildrenQueryPort\n<<port.out>>" as SurgCP
participant "SurgeryJpaRepository\n<<spring-data>>" as SurgJpaRepo
participant "HospitalizationChildrenQueryPort\n<<port.out>>" as HospCP
participant "HospitalizationJpaRepository\n<<spring-data>>" as HospJpaRepo
participant "DiagnosticImagingChildrenQueryPort\n<<port.out>>" as DiagCP
participant "DiagnosticImagingJpaRepository\n<<spring-data>>" as DiagJpaRepo
participant "LaboratoryTestChildrenQueryPort\n<<port.out>>" as LabCP
participant "LaboratoryTestJpaRepository\n<<spring-data>>" as LabJpaRepo
participant "SpaChildrenQueryPort\n<<port.out>>" as SpaCP
participant "SpaJpaRepository\n<<spring-data>>" as SpaJpaRepo
participant "DayCareChildrenQueryPort\n<<port.out>>" as DayCP
participant "DayCareJpaRepository\n<<spring-data>>" as DayJpaRepo
participant "ConsultationChildrenQueryPort\n<<port.out>>" as ConsCP
participant "ConsultationJpaRepository\n<<spring-data>>" as ConsJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /animals/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase: (sin @PreAuthorize de ownership en esta variante)
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT animal
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<AnimalJpaEntity>
alt animal no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : AnimalNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Animal>

note over Service
  RESTRICT children: el service consulta los 9 ChildrenQueryPort
  (vaccination, deworming, surgery, hospitalization, diagnosticImaging,
   laboratoryTest, spa, dayCare, consultation) ANTES de borrar.
  Si alguno tiene hijos activos → AnimalHasActiveChildrenException → 409.
end note

Service -> VaccCP : existsActiveByAnimalId(id)
VaccCP -> VaccJpaRepo : existsByAnimal_Id(id)
VaccJpaRepo -> DB : SELECT EXISTS(...) WHERE animal_id=? AND enabled=true
DB --> VaccJpaRepo : true/false
VaccJpaRepo --> VaccCP : boolean
VaccCP --> Service : boolean
alt hay vaccinations activas
  Service --> GEH : AnimalHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> DewCP : existsActiveByAnimalId(id)
DewCP -> DewJpaRepo : existsByAnimal_Id(id)
DewJpaRepo -> DB : SELECT EXISTS(...) WHERE animal_id=? AND enabled=true
DB --> DewJpaRepo : true/false
DewJpaRepo --> DewCP : boolean
DewCP --> Service : boolean
alt hay dewormings activos
  Service --> GEH : AnimalHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

