@startuml animal_update
title PUT /animals/{id} — Update Animal

actor Client
participant "AnimalController" as Controller
participant "UpdateAnimalUseCase\n<<port.in>>" as UseCase
participant "UpdateAnimalService" as Service
participant "AnimalRepository\n<<port.out>>" as Repo
participant "SpecieQueryPort" as SpecieQP
participant "BreedQueryPort" as BreedQP
participant "OwnerQueryPort" as OwnerQP
participant "CompanyQueryPort" as CompanyQP
participant "AnimalColorQueryPort" as ColorQP
participant "AnimalJpaMapper" as Mapper
participant "AnimalJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : PUT /animals/{id}\n+ UpdateAnimalRequest
activate Controller

Controller -> UseCase : execute(UpdateAnimalCommand)
note right of UseCase
  @PreAuthorize:
  admin.all OR
  (animal.update AND
   authz.isMyCompany(#command.companyId))
end note

UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(command.id())
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT animal (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<AnimalJpaEntity>
alt animal no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : AnimalNotFoundException
  GEH --> Client : 404 Not Found
end
Repo -> Mapper : toDomain(entity)
Mapper --> Repo : Animal
Repo --> Service : Optional<Animal>

Service -> SpecieQP : findById(specieId)
SpecieQP --> Service : Optional<SpecieRef>
alt cualquier ref no encontrada
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end
Service -> BreedQP : findById(breedId)
BreedQP --> Service : Optional<BreedRef>
Service -> OwnerQP : findById(ownerId)
OwnerQP --> Service : Optional<OwnerRef>
Service -> CompanyQP : findById(companyId)
CompanyQP --> Service : Optional<CompanyRef>
Service -> ColorQP : findById(colorId)
ColorQP --> Service : Optional<AnimalColorRef>

Service -> Service : animal.update(...)\n(invariantes de dominio)

Service -> Repo : save(animal)
Repo -> JpaRepo : getReferenceById(...)\n(proxies sin SELECT)
JpaRepo --> Repo : proxies
Repo -> Mapper : toJpa(animal, refs)
Mapper --> Repo : AnimalJpaEntity
Repo -> JpaRepo : save(entity)
JpaRepo -> DB : UPDATE animal
DB --> JpaRepo : ok
JpaRepo --> Repo : AnimalJpaEntity
Repo -> Mapper : toDomain(entity, refs precargados)
Mapper --> Repo : Animal
Repo --> Service : Animal

Service -> Service : AnimalDto.from(animal)
Service --> UseCase : AnimalDto
UseCase --> Controller : AnimalDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nAnimalResponse
deactivate Controller

@enduml
