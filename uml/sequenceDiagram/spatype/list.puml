@startuml spa_type_list
title GET /spa-types — List all SpaTypes

actor Client
participant "SpaTypeController" as Controller
participant "ListSpaTypesUseCase\n<<port.in>>" as UseCase
participant "ListSpaTypesService" as Service
participant "SpaTypeRepository\n<<port.out>>" as Repo
participant "SpaTypeJpaMapper" as Mapper
participant "SpaTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /spa-types
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT spa_type
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<SpaTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<SpaType>
Repo --> Service : List<SpaType>
deactivate Repo

Service -> Service : stream().map(SpaTypeDto::from).toList()
Service --> UseCase : List<SpaTypeDto>
UseCase --> Controller : List<SpaTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<SpaTypeResponse>
deactivate Controller

@enduml
