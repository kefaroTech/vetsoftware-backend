@startuml medication_schedule_reschedule
title PATCH /medication-schedules/{id}/reschedule — Reschedule Medication Dose

actor Client
participant "MedicationScheduleController" as Controller
participant "RescheduleMedicationScheduleUseCase\n<<port.in>>" as UseCase
participant "RescheduleMedicationScheduleService" as Service
participant "MedicationScheduleRepository\n<<port.out>>" as Repo
participant "HospitalizationMedicationQueryPort\n<<port.out>>" as MedQP
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

Client -> Controller : PATCH /medication-schedules/{id}/reschedule\n+ { newDateTime, mode }
activate Controller
Controller -> UseCase : execute(RescheduleMedicationScheduleCommand{id, newDateTime, mode})
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalization.update OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(command)
activate Service

Service -> Repo : findById(id)
Repo --> Service : Optional<MedicationSchedule>
alt no encontrada
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end

Service -> Repo : findByHospitalizationMedicationId(medId)
Repo --> Service : List<MedicationSchedule> (orden previo al movimiento)
Service -> Service : target.reschedule(newDateTime)  // currentDateTime=nuevo, rescheduled=true
Service -> Repo : save(target)
Repo -> DB : UPDATE medication_schedules

alt mode == "cascade"
  Service -> MedQP : findById(medId)
  MedQP --> Service : MedicationOrderParams (guidelineType, frequency)
  alt guidelineType == INTERVAL
    loop tomas PENDIENTES posteriores
      Service -> Service : cursor += intervalo;  slot.reschedule(cursor)
      Service -> Repo : save(slot)
      Repo -> DB : UPDATE medication_schedules
    end
  end
end

Service --> UseCase : List<MedicationScheduleDto>
UseCase --> Controller : List<MedicationScheduleDto>
Controller --> Client : 200 OK\nList<MedicationScheduleResponse> (plan completo de la medicación)
deactivate Service
deactivate Controller

@enduml
