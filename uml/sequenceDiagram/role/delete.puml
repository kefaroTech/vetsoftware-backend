@startuml role_delete
title DELETE /roles/{id} — Delete Role

actor Client
participant "RoleController" as Controller
participant "DeleteRoleUseCase\n<<port.in>>" as UseCase
participant "DeleteRoleService" as Service
participant "RoleRepository\n<<port.out>>" as Repo
participant "RoleJpaRepository\n<<spring-data>>" as JpaRepo
participant "EmployeeRoleChildrenQueryPort\n<<port.out>>" as EmpRolePort
participant "EmployeeRoleJpaRepository\n<<spring-data>>" as EmpRoleJpaRepo
participant "RolePermissionChildrenCascadePort\n<<port.out>>" as CascadePort
participant "RolePermissionJpaRepository\n<<spring-data>>" as RolePermJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /roles/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT role (JOIN FETCH company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<RoleJpaEntity>
alt role no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : RoleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Role>

Service -> EmpRolePort : existsActiveByRoleId(id)
EmpRolePort -> EmpRoleJpaRepo : existsByRole_Id(id)
EmpRoleJpaRepo -> DB : SELECT EXISTS(...) WHERE role_id=? AND enabled=true
DB --> EmpRoleJpaRepo : true/false
EmpRoleJpaRepo --> EmpRolePort : boolean
EmpRolePort --> Service : boolean
alt algún empleado tiene este rol asignado
  Service --> GEH : RoleHasActiveChildrenException("employeeRole")
  GEH --> Client : 409 Conflict\ncode=ENTITY_HAS_ACTIVE_CHILDREN
end

Service -> CascadePort : deactivateAllByRoleId(id)
CascadePort -> RolePermJpaRepo : disableAllByRoleId(id)
RolePermJpaRepo -> DB : UPDATE role_permissions SET enabled=false WHERE role_id=? AND enabled=true
DB --> RolePermJpaRepo : N filas
RolePermJpaRepo --> CascadePort : int
CascadePort --> Service : int

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE role SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
