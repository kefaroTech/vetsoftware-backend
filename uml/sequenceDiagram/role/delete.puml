@startuml role_delete
title DELETE /roles/{id} — Delete Role

actor Client
participant "RoleController" as Controller
participant "DeleteRoleUseCase\n<<port.in>>" as UseCase
participant "DeleteRoleService" as Service
participant "RoleRepository\n<<port.out>>" as Repo
participant "RoleJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : DELETE /roles/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT role (JOIN FETCH company)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<RoleJpaEntity>
alt role no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : RoleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Role>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : DELETE role
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
