@startuml role_find
title GET /roles/{id} — Find Role by ID

actor Client
participant "RoleController" as Controller
participant "FindRoleUseCase\n<<port.in>>" as UseCase
participant "FindRoleService" as Service
participant "RoleRepository\n<<port.out>>" as Repo
participant "RoleJpaMapper" as Mapper
participant "RoleJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /roles/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT role\nJOIN FETCH company\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<RoleJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : Role
  Repo --> Service : Optional<Role>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : RoleNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : RoleDto.from(role)
Service --> UseCase : RoleDto
UseCase --> Controller : RoleDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nRoleResponse
deactivate Controller

@enduml
