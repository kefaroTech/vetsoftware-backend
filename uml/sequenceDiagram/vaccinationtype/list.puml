@startuml vaccination_type_list
title GET /vaccination-types — List all VaccinationTypes

actor Client
participant "VaccinationTypeController" as Controller
participant "ListVaccinationTypesUseCase\n<<port.in>>" as UseCase
participant "ListVaccinationTypesService" as Service
participant "VaccinationTypeRepository\n<<port.out>>" as Repo
participant "VaccinationTypeJpaMapper" as Mapper
participant "VaccinationTypeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /vaccination-types
activate Controller

Controller -> UseCase : listAll()
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT vaccination_type\nJOIN FETCH (company)\nvia @EntityGraph
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<VaccinationTypeJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<VaccinationType>
Repo --> Service : List<VaccinationType>
deactivate Repo

Service -> Service : stream().map(VaccinationTypeDto::from).toList()
Service --> UseCase : List<VaccinationTypeDto>
UseCase --> Controller : List<VaccinationTypeDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<VaccinationTypeResponse>
deactivate Controller

@enduml
