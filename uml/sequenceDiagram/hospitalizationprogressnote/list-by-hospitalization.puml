@startuml hospitalization_progress_note_list_by_hospitalization
title GET /hospitalization-progress-notes/by-hospitalization/{hospitalizationId}

actor Client
participant "HospitalizationProgressNoteController" as Controller
participant "ListHospitalizationProgressNotesByHospitalizationUseCase\n<<port.in>>" as UseCase
participant "ListHospitalizationProgressNotesByHospitalizationService" as Service
participant "HospitalizationProgressNoteRepository\n<<port.out>>" as Repo
participant "HospitalizationProgressNoteJpaMapper" as Mapper
participant "HospitalizationProgressNoteJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

Client -> Controller : GET /hospitalization-progress-notes/by-hospitalization/{hospitalizationId}
activate Controller
Controller -> UseCase : listByHospitalization(hospitalizationId)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationProgressNote.read OR SYSTEM
end note
UseCase -> Service : listByHospitalization(hospitalizationId)
activate Service
Service -> Repo : findAllByHospitalizationId(hospitalizationId)
Repo -> JpaRepo : findByHospitalizationId(hospitalizationId)
JpaRepo -> DB : SELECT (JOIN FETCH refs) WHERE hospitalization_id=? AND enabled=true
DB --> JpaRepo : rows
JpaRepo --> Repo : List<entity>
Repo -> Mapper : toDomain(entity) (por fila)
Mapper --> Repo : List<HospitalizationProgressNote>
Repo --> Service : List<HospitalizationProgressNote>
Service -> Service : map HospitalizationProgressNoteDto.from(...)
Service --> UseCase : List<HospitalizationProgressNoteDto>
UseCase --> Controller : List<HospitalizationProgressNoteDto>
Controller --> Client : 200 OK\nList<HospitalizationProgressNoteResponse>
deactivate Controller
deactivate Service

@enduml
