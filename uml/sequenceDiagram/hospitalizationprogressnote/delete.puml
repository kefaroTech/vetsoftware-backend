@startuml hospitalization_progress_note_delete
title DELETE /hospitalization-progress-notes/{id} — Soft-delete HospitalizationProgressNote

actor Client
participant "HospitalizationProgressNoteController" as Controller
participant "DeleteHospitalizationProgressNoteUseCase\n<<port.in>>" as UseCase
participant "DeleteHospitalizationProgressNoteService" as Service
participant "HospitalizationProgressNoteRepository\n<<port.out>>" as Repo
participant "HospitalizationProgressNoteJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, DB
  @SQLDelete convierte el DELETE en UPDATE enabled=false;
  @SQLRestriction oculta las filas con enabled=false.
end note

Client -> Controller : DELETE /hospitalization-progress-notes/{id}
activate Controller
Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hospitalizationProgressNote.delete OR SYSTEM
end note
UseCase -> Service : execute(id)  [@Transactional]
activate Service
Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT WHERE enabled=true
DB --> JpaRepo : row | empty
alt no existe
  Service --> GEH : HospitalizationProgressNoteNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : HospitalizationProgressNote
Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE hospitalization_progress_notes SET enabled=false WHERE id=?
DB --> JpaRepo : ok
Service --> UseCase : void
UseCase --> Controller : void
Controller --> Client : 204 No Content
deactivate Controller
deactivate Service

@enduml
