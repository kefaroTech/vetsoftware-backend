@startuml clinicalhistory_export
title GET /animals/{animalId}/clinical-history/export.pdf — Export Clinical History as PDF

actor Client
participant "ClinicalHistoryController" as Controller
participant "Authz" as Authz
participant "ExportClinicalHistoryUseCase\n<<port.in>>" as UseCase
participant "ExportClinicalHistoryService" as Service
participant "AnimalReportQueryPort\n<<port.out>>" as AnimalQP
participant "ClinicalEventRepository\n<<port.out>>" as Repo
participant "ClinicalEventJpaMapper" as Mapper
participant "ClinicalEventJpaRepository\n<<spring-data>>" as JpaRepo
participant "ClinicalHistoryPdfPort\n<<port.out>>" as PdfPort
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /animals/{animalId}/clinical-history/export.pdf\n?types=&from=&to=
activate Controller

Controller -> Authz : currentCompanyId()
Authz --> Controller : companyId

Controller -> Controller : new GetClinicalHistoryQuery(\n  animalId, companyId, types, from, to)

Controller -> UseCase : execute(query)
note right of UseCase
  @PreAuthorize:
  admin.all OR SYSTEM OR
  (clinicalHistory.read AND
   authz.isMyCompany(#query.companyId))
end note

UseCase -> Service : execute(query)
activate Service

Service -> AnimalQP : findByIdAndCompanyId(animalId, companyId)
AnimalQP --> Service : Optional<AnimalReportInfo>
alt animal no encontrado para la company actual
  Service --> GEH : IllegalArgumentException
  GEH --> Client : 400 Bad Request
end

Service -> Repo : findHistory(query)
activate Repo
Repo -> JpaRepo : findHistory(animalId, companyId,\n  types, from, to)
JpaRepo -> DB : SELECT e FROM ClinicalEventViewJpaEntity\n(filtrada por animal, company, tipos, fechas)
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<ClinicalEventViewJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<ClinicalEvent>
Repo --> Service : List<ClinicalEvent>
deactivate Repo

Service -> Service : stream().map(ClinicalEventDto::from).toList()

Service -> Service : new ClinicalHistoryReportModel(\n  animal, from, to, types, events, now())

Service -> PdfPort : render(model)
note right of PdfPort
  Implementación: ClinicalHistoryGotenbergAdapter
  (renderiza HTML y delega a Gotenberg para PDF)
end note
PdfPort --> Service : byte[] pdf

Service --> UseCase : byte[] pdf
UseCase --> Controller : byte[] pdf
deactivate Service

Controller -> Controller : build ResponseEntity\nContent-Type: application/pdf\nContent-Disposition: attachment; filename="historia-clinica-{animalId}.pdf"
Controller --> Client : 200 OK\napplication/pdf (bytes)
deactivate Controller

@enduml
