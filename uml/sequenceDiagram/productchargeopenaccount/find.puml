@startuml product_charge_open_account_find
title GET /product-charge-open-accounts/{id} — Find Product Charge by ID

actor Client
participant "ProductChargeOpenAccountController" as Controller
participant "FindProductChargeOpenAccountUseCase\n<<port.in>>" as UseCase
participant "FindProductChargeOpenAccountService" as Service
participant "ProductChargeOpenAccountRepository\n<<port.out>>" as Repo
participant "ProductChargeOpenAccountJpaMapper" as Mapper
participant "ProductChargeOpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : GET /product-charge-open-accounts/{id}
activate Controller

Controller -> UseCase : findById(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR productChargeOpenAccount.read OR hasRole('SYSTEM')
end note
UseCase -> Service : findById(id)
activate Service

Service -> Repo : findById(id)
activate Repo
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT charge\nJOIN FETCH (animal, product, openAccount, createdBy)\nvia @EntityGraph
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ProductChargeOpenAccountJpaEntity>

alt entidad encontrada
  Repo -> Mapper : toDomain(entity)
  Mapper --> Repo : ProductChargeOpenAccount
  Repo --> Service : Optional<ProductChargeOpenAccount>
else no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ProductChargeOpenAccountNotFoundException
  GEH --> Client : 404 Not Found
end
deactivate Repo

Service -> Service : ProductChargeOpenAccountDto.from(charge)
Service --> UseCase : ProductChargeOpenAccountDto
UseCase --> Controller : ProductChargeOpenAccountDto
deactivate Service

Controller -> Controller : toResponse(dto)
Controller --> Client : 200 OK\nProductChargeOpenAccountResponse
deactivate Controller

@enduml
