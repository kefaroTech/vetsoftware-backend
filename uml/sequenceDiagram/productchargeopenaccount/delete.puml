@startuml product_charge_open_account_delete
title DELETE /product-charge-open-accounts/{id} — Delete Product Charge

actor Client
participant "ProductChargeOpenAccountController" as Controller
participant "DeleteProductChargeOpenAccountUseCase\n<<port.in>>" as UseCase
participant "DeleteProductChargeOpenAccountService" as Service
participant "ProductChargeOpenAccountRepository\n<<port.out>>" as Repo
participant "ProductChargeOpenAccountJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "OpenAccountTotalsQueryPort\n<<port.out>>" as TotalsQuery
participant "OpenAccountTotalsQueryAdapter" as TotalsQueryAdapter
participant "OpenAccountRefresher\n<<port.out>>" as Refresher
participant "RecalculateOpenAccountUseCase\n(openaccount <<port.in>>)" as Recalc
participant "RecalculateOpenAccountService" as RecalcSvc
participant "OpenAccountTotalsPort\n(openaccount <<port.out>>)" as TotalsPort
participant "OpenAccountRepository\n(openaccount <<port.out>>)" as OARepo
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, GEH
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /product-charge-open-accounts/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR productChargeOpenAccount.delete OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT charge (JOIN FETCH animal, product, openAccount, createdBy)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ProductChargeOpenAccountJpaEntity>
alt charge no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ProductChargeOpenAccountNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : ProductChargeOpenAccount
Service -> Service : openAccountId = charge.openAccount.id

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE product_charge_open_accounts SET enabled=false WHERE id=?
DB --> JpaRepo : ok
Repo --> Service : void

== Validación: los abonos no pueden superar los cargos restantes ==
note over Service, DB
  Hibernate hace flush del soft-delete antes de ejecutar los SUM,
  así que totalCharges ya excluye este cargo.
end note
Service -> TotalsQuery : totalCharges(openAccountId)
TotalsQuery -> TotalsQueryAdapter : totalCharges(openAccountId)
TotalsQueryAdapter -> TotalsPort : totalCharges(openAccountId)
TotalsPort -> DB : SUM(product+service+general charges) WHERE enabled=true
DB --> TotalsPort : remainingCharges
TotalsPort --> Service : remainingCharges
Service -> TotalsQuery : totalPayments(openAccountId)
TotalsQuery -> TotalsQueryAdapter : totalPayments(openAccountId)
TotalsQueryAdapter -> TotalsPort : totalPayments(openAccountId)
TotalsPort -> DB : SUM(debt payments) WHERE enabled=true
DB --> TotalsPort : payments
TotalsPort --> Service : payments
alt payments > remainingCharges
  Service --> GEH : IllegalStateException("Anula primero los abonos")
  note right of GEH
    El rollback de la transacción revierte el soft-delete del cargo.
  end note
  GEH --> Client : 409 Conflict (INVALID_STATE)
end

== Recálculo de la Open Account padre ==
Service -> Refresher : refresh(openAccountId)
activate Refresher
Refresher -> Recalc : recalculate(openAccountId)
Recalc -> RecalcSvc : recalculate(openAccountId)
activate RecalcSvc
RecalcSvc -> OARepo : findById(openAccountId)
OARepo --> RecalcSvc : OpenAccount
RecalcSvc -> TotalsPort : totalCharges(openAccountId)
TotalsPort -> DB : SUM(product+service+general charges) WHERE enabled=true
DB --> TotalsPort : total
RecalcSvc -> TotalsPort : totalPayments(openAccountId)
TotalsPort -> DB : SUM(debt payments) WHERE enabled=true
DB --> TotalsPort : paid
RecalcSvc -> RecalcSvc : openAccount.recalculate(total, paid)\noutstanding = total - paid
RecalcSvc -> OARepo : save(openAccount)
OARepo -> DB : UPDATE open_accounts (total, paid, outstanding)
deactivate RecalcSvc
deactivate Refresher

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
