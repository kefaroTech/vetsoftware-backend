@startuml surgery_type_delete
title DELETE /surgery-types/{id} — Delete SurgeryType

actor Client
participant "SurgeryTypeController" as Controller
participant "DeleteSurgeryTypeUseCase\n<<port.in>>" as UseCase
participant "DeleteSurgeryTypeService" as Service
participant "SurgeryTypeRepository\n<<port.out>>" as Repo
participant "SurgeryTypeJpaRepository\n<<spring-data>>" as JpaRepo
participant "SurgeryChildrenQueryPort\n<<port.out>>" as ChildrenQuery
participant "SurgeryJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /surgery-types/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT surgery_type
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SurgeryTypeJpaEntity>
alt surgery_type no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SurgeryTypeNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<SurgeryType>

Service -> ChildrenQuery : existsActiveBySurgeryTypeId(id)
ChildrenQuery -> ChildJpaRepo : existsBySurgeryType_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE surgery_type_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenQuery : boolean
ChildrenQuery --> Service : boolean
alt hay hijos activos
  Service --> GEH : SurgeryTypeHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE surgery_type SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
