@startuml module_delete
title DELETE /modules/{id} — Delete Module

actor Client
participant "ModuleController" as Controller
participant "DeleteModuleUseCase\n<<port.in>>" as UseCase
participant "DeleteModuleService" as Service
participant "ModuleRepository\n<<port.out>>" as Repo
participant "ModuleJpaRepository\n<<spring-data>>" as JpaRepo
participant "SubModuleChildrenQueryPort\n<<port.out>>" as ChildrenPort
participant "SubModuleJpaRepository\n<<spring-data>>" as ChildJpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /modules/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT module
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<ModuleJpaEntity>
alt module no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : ModuleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<Module>

Service -> ChildrenPort : existsActiveByModuleId(id)
ChildrenPort -> ChildJpaRepo : existsByModule_Id(id)
ChildJpaRepo -> DB : SELECT EXISTS(...) WHERE module_id=? AND enabled=true
DB --> ChildJpaRepo : true/false
ChildJpaRepo --> ChildrenPort : boolean
ChildrenPort --> Service : boolean
alt hay hijos activos
  Service --> GEH : ModuleHasActiveChildrenException
  GEH --> Client : 409 Conflict
end

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE module SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
