@startuml module_list
title GET /modules — List all Modules

actor Client
participant "ModuleController" as Controller
participant "ListModulesUseCase\n<<port.in>>" as UseCase
participant "ListModulesService" as Service
participant "ModuleRepository\n<<port.out>>" as Repo
participant "ModuleJpaMapper" as Mapper
participant "ModuleJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB

note over Client, DB
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

Client -> Controller : GET /modules
activate Controller

Controller -> UseCase : listAll()
note right of UseCase: (sin @PreAuthorize)
UseCase -> Service : listAll()
activate Service

Service -> Repo : findAll()
activate Repo
Repo -> JpaRepo : findAll()
JpaRepo -> DB : SELECT module
DB --> JpaRepo : rows[]
JpaRepo --> Repo : List<ModuleJpaEntity>
Repo -> Mapper : toDomain(entity) por cada row
Mapper --> Repo : List<Module>
Repo --> Service : List<Module>
deactivate Repo

Service -> Service : stream().map(ModuleDto::from).toList()
Service --> UseCase : List<ModuleDto>
UseCase --> Controller : List<ModuleDto>
deactivate Service

Controller -> Controller : stream().map(toResponse).toList()
Controller --> Client : 200 OK\nList<ModuleResponse>
deactivate Controller

@enduml
