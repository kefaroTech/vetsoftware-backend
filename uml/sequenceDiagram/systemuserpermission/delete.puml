@startuml systemuserpermission_delete
title DELETE /system-user-permissions/{id} — Delete SystemUserPermission

actor Client
participant "SystemUserPermissionController" as Controller
participant "DeleteSystemUserPermissionUseCase\n<<port.in>>" as UseCase
participant "DeleteSystemUserPermissionService" as Service
participant "SystemUserPermissionRepository\n<<port.out>>" as Repo
participant "SystemUserPermissionJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /system-user-permissions/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT system_user_permission (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<SystemUserPermissionJpaEntity>
alt no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : SystemUserPermissionNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<SystemUserPermission>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE system_user_permission SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
