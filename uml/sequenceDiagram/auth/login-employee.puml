@startuml auth_login_employee
title POST /auth/login/employee — Login Employee

actor Client
participant "AuthController" as Controller
participant "LoginEmployeeUseCase\n<<port.in>>" as UseCase
participant "LoginEmployeeService" as Service
participant "EmployeeCredentialsRepository\n<<port.out>>" as CredsRepo
participant "JpaEmployeeCredentialsRepository" as JpaCredsRepo
participant "EmployeeJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "PasswordHasher" as Hasher
participant "TokenGenerator\n<<port.out>>" as TokenGen
participant "JwtProvider" as Jwt
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  Ruta pública declarada en AuthFilter.PUBLIC_PATHS
  (POST /auth/login/**), no requiere JWT.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : POST /auth/login/employee\n+ LoginEmployeeRequest(employeeCode, password)
activate Controller

Controller -> UseCase : execute(LoginEmployeeCommand)
note right of UseCase: (sin @PreAuthorize — login es público)

UseCase -> Service : execute(command)
activate Service

Service -> CredsRepo : findByCode(employeeCode)
CredsRepo -> JpaCredsRepo : findByCode(employeeCode)
JpaCredsRepo -> JpaRepo : findByEmployeeCodeAndStatus(code, "ACTIVE")
JpaRepo -> DB : SELECT employee\nWHERE code=? AND status='ACTIVE'\nAND enabled=true (via @SoftDelete)
DB --> JpaRepo : row | empty
JpaRepo --> JpaCredsRepo : Optional<EmployeeJpaEntity>
JpaCredsRepo --> Service : Optional<EmployeeCredentials>\n(id, companyId, hashPassword)

alt credenciales no encontradas
  Service --> GEH : InvalidCredentialsException
  GEH --> Client : 401 Unauthorized
end

Service -> Hasher : matches(rawPassword, hashPassword)
Hasher --> Service : boolean
alt password no coincide
  Service --> GEH : InvalidCredentialsException
  GEH --> Client : 401 Unauthorized
end

Service -> TokenGen : generate(id, "EMPLOYEE", companyId)
TokenGen -> Jwt : firmar JWT con claims {sub, type, companyId, iat, exp}
Jwt --> TokenGen : tokenString
TokenGen --> Service : token

Service -> Service : new TokenDto(token, "EMPLOYEE")
Service --> UseCase : TokenDto
UseCase --> Controller : TokenDto
deactivate Service

Controller -> Controller : new TokenResponse(token, type)
Controller --> Client : 200 OK\nTokenResponse
deactivate Controller

@enduml
