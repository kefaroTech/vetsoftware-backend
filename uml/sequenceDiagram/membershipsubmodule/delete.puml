@startuml membershipsubmodule_delete
title DELETE /membership-sub-modules/{id} — Delete MembershipSubModule

actor Client
participant "MembershipSubModuleController" as Controller
participant "DeleteMembershipSubModuleUseCase\n<<port.in>>" as UseCase
participant "DeleteMembershipSubModuleService" as Service
participant "MembershipSubModuleRepository\n<<port.out>>" as Repo
participant "MembershipSubModuleJpaRepository\n<<spring-data>>" as JpaRepo
database "MySQL" as DB
participant "GlobalExceptionHandler" as GEH

note over Client, GEH
  AuthFilter ya validó el JWT y puso EmployeeContext
  en SecurityContextHolder antes de llegar al controller.
end note

note over Client, DB
  Hibernate `@SoftDelete` filtra automáticamente:
  - DELETE → UPDATE enabled=false
  - Todo SELECT añade WHERE enabled=true
end note

Client -> Controller : DELETE /membership-sub-modules/{id}
activate Controller

Controller -> UseCase : execute(id)
note right of UseCase
  @PreAuthorize:
  admin.all OR hasRole('SYSTEM')
end note
UseCase -> Service : execute(id)
activate Service

Service -> Repo : findById(id)
Repo -> JpaRepo : findById(id)
JpaRepo -> DB : SELECT membership_sub_module (JOIN FETCH refs)
DB --> JpaRepo : row | empty
JpaRepo --> Repo : Optional<MembershipSubModuleJpaEntity>
alt no existe
  Repo --> Service : Optional.empty()
  Service --> GEH : MembershipSubModuleNotFoundException
  GEH --> Client : 404 Not Found
end
Repo --> Service : Optional<MembershipSubModule>

Service -> Repo : delete(id)
Repo -> JpaRepo : deleteById(id)
JpaRepo -> DB : UPDATE membership_sub_module SET enabled=false WHERE id=?
DB --> JpaRepo : ok
JpaRepo --> Repo : void
Repo --> Service : void

Service --> UseCase : void
UseCase --> Controller : void
deactivate Service

Controller --> Client : 204 No Content
deactivate Controller

@enduml
