SPRING_PROFILES_ACTIVE=prod
DEPLOYMENT_ENVIRONMENT=production
VETSOFTWARE_INSTANCE_ID=vetsoftware-prod-1

# Servicios administrados/remotos con TLS.
DB_URL=jdbc:mysql://db-prod.example.com:3306/vetsoftware?sslMode=VERIFY_IDENTITY
DB_USERNAME=REEMPLAZAR
DB_PASSWORD=REEMPLAZAR
REDIS_URL=rediss://default:REEMPLAZAR@redis-prod.example.com:6380

# AWS real. El backend usa DefaultCredentialsProvider (IAM Role/workload identity).
AWS_REGION=sa-east-1
S3_BUCKET=REEMPLAZAR-vetsoftware-prod

# Grafana Cloud, OTLP directo sin Collector/Alloy local.
#
# El host es otlp-gateway-<cluster>.grafana.net, donde <cluster> es el del stack REAL, no una
# region que suene bien. El nuestro es el stack 'vastcoyote3439', cluster 'prod-us-east-3'.
# Fuente de verdad, en este orden:
#   1. grafana.com -> el stack -> tarjeta "OpenTelemetry" -> "OTLP Endpoint"
#   2. o el campo 'cluster' en grafana.com/api/instances del stack
# Estuvo apuntando a 'prod-sa-east-0' (Brasil) y el comentario decia "Grafana Cloud Brasil": es
# un cluster donde no tenemos stack, asi que las exportaciones se rechazaban. Ojo, el cluster de
# Grafana no tiene por que coincidir con AWS_REGION: son proveedores distintos.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp/v1/logs
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REEMPLAZAR
TRACING_SAMPLING=1.0

JWT_SECRET=REEMPLAZAR_BASE64_256_BITS
EMAIL_FROM=VetSoftware <notificaciones@example.com>
RESEND_API_KEY=re_REEMPLAZAR
REGISTRATION_VERIFICATION_URL=https://app.example.com/verify-email
PASSWORD_RESET_URL=https://app.example.com/restablecer-contrasena
CODE_RECOVERY_LOGIN_URL=https://app.example.com/login
EMPLOYEE_LOGIN_URL=https://app.example.com/login
# Plantillas de Resend de los cuatro correos que no son de platform-access. Su UUID viajaba commiteado
# como default en application.yml, asi que los tres entornos apuntaban a la misma plantilla; ya no.
# LAS CUATRO SON OBLIGATORIAS: con el correo habilitado la aplicacion NO ARRANCA si falta una. Antes
# arrancaba, el endpoint respondia con exito y el correo se descartaba con un warning que nadie lee.
REGISTRATION_VERIFICATION_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
PASSWORD_RESET_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
EMPLOYEE_INVITATION_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
APPOINTMENT_CONFIRMATION_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
# Alta de superadministradores de plataforma. Las tres URLs apuntan a la consola de plataforma
# (admin), no a la app del tenant (app).
#
# LAS OCHO SON OBLIGATORIAS: con el correo habilitado, la aplicacion NO ARRANCA si falta una. Antes
# arrancaba, respondia 202 y descartaba el correo en silencio; el aprobador no recibia nada y la
# solicitud moria sin rastro. Los cuatro UUID de plantilla se crean A MANO en el panel de Resend.
PLATFORM_APPROVER_EMAIL=REEMPLAZAR_CORREO_DEL_APROBADOR
PLATFORM_ACCESS_REVIEW_BASE_URL=https://admin.example.com/aprobar-acceso
PLATFORM_INVITATION_BASE_URL=https://admin.example.com/aceptar-invitacion
# Unico canal por el que el superadministrador recien creado conoce su `code`, que es su usuario.
PLATFORM_ACCESS_LOGIN_URL=https://admin.example.com/login
PLATFORM_ACCESS_REQUEST_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
PLATFORM_ACCESS_APPROVED_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
PLATFORM_ACCESS_REJECTED_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
PLATFORM_ACCESS_WELCOME_TEMPLATE_ID=REEMPLAZAR_UUID_PLANTILLA_RESEND
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET=REEMPLAZAR
