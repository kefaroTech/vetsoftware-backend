SPRING_PROFILES_ACTIVE=local
DEPLOYMENT_ENVIRONMENT=local
VETSOFTWARE_INSTANCE_ID=local-1

# Puertos y credenciales de docker-compose.yml
# Interfaz donde se publican los puertos del stack. 127.0.0.1 deja todo accesible solo desde esta
# máquina; cambiarlo a 0.0.0.0 expone el stack a la red y exige docker-compose.secure.yml
# (docs/SEGURIDAD_OBSERVABILIDAD.md).
LOCAL_BIND_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_DB_NAME=vetsoftware_db
LOCAL_DB_USERNAME=cronos
LOCAL_DB_PASSWORD=cronos2026*
LOCAL_MYSQL_ROOT_PASSWORD=cronos2026*
LOCAL_REDIS_PORT=6379
LOCALSTACK_PORT=4566
LOCAL_OTLP_GRPC_PORT=4317
LOCAL_OTLP_HTTP_PORT=4318

# Conexiones del backend ejecutado desde el host
DB_URL=jdbc:mysql://localhost:3306/vetsoftware_db
DB_USERNAME=cronos
DB_PASSWORD=cronos2026*
REDIS_URL=redis://localhost:6379

# AWS emulado: S3 + Data Firehose
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=vetsoftware-local
S3_ENDPOINT=http://localhost:4566
AUDIT_FIREHOSE_ENABLED=true
AUDIT_FIREHOSE_DELIVERY_STREAM=vetsoftware-audit-local
AUDIT_FIREHOSE_ENDPOINT=http://localhost:4566

# Observabilidad local: Collector -> Loki/Tempo y Prometheus.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
TRACING_SAMPLING=1.0
# Cuenta técnica exclusiva para que Prometheus consulte Actuator.
# Use un secreto aleatorio de al menos 16 caracteres y configure estos mismos
# valores en el entorno de ejecución del backend (por ejemplo, IntelliJ).
ACTUATOR_PROMETHEUS_USERNAME=prometheus
ACTUATOR_PROMETHEUS_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_CARACTERES

# Contraseña del admin de Grafana. Obligatoria: el compose ya no tiene fallback `admin` y falla el
# arranque si falta. Genere una con `openssl rand -base64 24`.
GRAFANA_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO

# Solo para docker-compose.secure.yml (ambiente compartido): URL https pública de Grafana.
# GRAFANA_ROOT_URL=https://observabilidad.interno.example.com:3000

JWT_SECRET=REMOVED_SENSITIVE_VALUE
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
REGISTRATION_VERIFICATION_URL=http://localhost:5174/verify-email
PASSWORD_RESET_URL=http://localhost:5174/restablecer-contrasena
CODE_RECOVERY_LOGIN_URL=http://localhost:5174/login
EMPLOYEE_LOGIN_URL=http://localhost:5174/login
EMAIL_ENABLED=false
RECAPTCHA_ENABLED=false
